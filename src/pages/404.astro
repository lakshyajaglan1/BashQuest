---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
---

<Layout
    title="404: Page Not Found — BashQuest"
    description="The requested path could not be found on this server."
>
    <div class="flex flex-col min-h-screen">
        <Navigation />

        <main
            class="flex-1 w-full bg-canvas-soft mesh-gradient py-16 px-4 md:px-8 flex items-center justify-center select-none"
        >
            <div class="max-w-md w-full space-y-8 text-center">
                <div class="space-y-3">
                    <span
                        class="caption-mono uppercase tracking-widest text-error bg-error-soft/30 border border-error/20 px-2.5 py-0.5 rounded-sm"
                    >
                        Error Code 404
                    </span>
                    <h1 class="display-lg text-ink font-bold tracking-tight">
                        Page Not Found.
                    </h1>
                    <p class="body-sm text-body">
                        The directory or page you are looking for does not exist
                        or has been moved.
                    </p>
                </div>

                <!-- Simulated Terminal Card -->
                <div class="code-editor-mockup text-left p-5 shadow-level-3">
                    <div
                        class="flex items-center gap-1.5 pb-3 border-b border-white/5 mb-3"
                    >
                        <div class="w-2.5 h-2.5 rounded-full bg-[#ff5f56]">
                        </div>
                        <div class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e]">
                        </div>
                        <div class="w-2.5 h-2.5 rounded-full bg-[#27c93f]">
                        </div>
                    </div>
                    <div class="font-mono text-xs space-y-1.5">
                        <p class="text-mute">
                            # Attempting to access missing route...
                        </p>
                        <p>
                            <span class="text-green-400">learner@bashquest</span
                            >:<span class="text-blue-400">~</span>$ cd {
                                typeof window !== "undefined"
                                    ? window.location.pathname
                                    : "/unknown-path"
                            }
                        </p>
                        <p class="text-error font-semibold">
                            bash: cd: path not found in virtual filesystem
                        </p>
                    </div>
                </div>

                <div class="flex justify-center pt-2">
                    <a
                        href="/?view=dashboard"
                        class="button-primary text-sm font-medium"
                    >
                        Return to Dashboard
                    </a>
                </div>
            </div>
        </main>

        <Footer />
    </div>
</Layout>
