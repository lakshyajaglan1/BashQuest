---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { modules } from "../lib/lessons.js";
import { useTranslations, useTranslatedPath } from "../i18n/utils";

const lang = "en";
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout
  title={t("meta.aboutTitle")}
  description={t("meta.aboutDescription")}
  lang={lang}
>
  <div class="flex flex-col min-h-screen">
    <!-- Navbar -->
    <Navigation activePage="about" lang={lang} />


    <!-- Main Content -->
    <main
      class="flex-1 w-full bg-canvas-soft mesh-gradient py-12 px-4 md:px-8 select-text"
    >
      <div class="max-w-4xl mx-auto space-y-12">
        <!-- Header -->
        <div class="text-center md:text-left space-y-4">
          <span
            class="caption-mono uppercase tracking-widest text-mute bg-canvas-soft-2 px-3 py-1 rounded border border-hairline"
            >Linux learning website</span
          >
          <h1 class="display-lg text-ink font-bold tracking-tight">
            About BashQuest: The Ultimate Online Linux Terminal.
          </h1>
          <p class="body-lg text-body max-w-2xl">
            A free, open-source Linux learning resource and interactive bash learning game designed to teach you
            Linux terminal commands through real browser-based terminal practice and clear terminal learning objectives.
          </p>
        </div>

        <!-- Details Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- What is BashQuest Card -->
          <div
            class="card-marketing border border-hairline bg-canvas p-6 flex flex-col justify-between shadow-level-3"
          >
            <div>
              <div class="flex items-center gap-3 mb-4">
                <div
                  class="w-10 h-10 rounded-full bg-violet-soft text-violet flex items-center justify-center font-mono text-lg font-bold"
                >
                  $
                </div>
                <h2
                  class="text-xl font-sans font-extrabold text-ink tracking-tight"
                >
                  What is BashQuest?
                </h2>
              </div>
              <p class="body-sm text-body leading-relaxed mt-2">
                BashQuest is a free online Linux terminal practice platform and bash learning game
                built specifically for hands-on command line education. Unlike online video
                courses or static reading guides where you passively watch others work,
                BashQuest forces you to learn by actually typing Linux terminal commands into an online Linux terminal.
              </p>
              <p class="body-sm text-body leading-relaxed mt-4">
                Under the hood, it features a custom-built, simulated Linux terminal
                and directory structure. Every quest is mapped to specific terminal learning objectives, testing and validating your work in real-time.
              </p>
            </div>
          </div>

          <!-- Why I Built This Card -->
          <div
            class="card-marketing border border-hairline bg-canvas p-6 flex flex-col justify-between shadow-level-3"
          >
            <div>
              <div class="flex items-center gap-3 mb-4">
                <div
                  class="w-10 h-10 rounded-full bg-cyan-soft text-cyan-deep flex items-center justify-center font-sans text-lg font-bold"
                >
                  💡
                </div>
                <h2
                  class="text-xl font-sans font-extrabold text-ink tracking-tight"
                >
                  Why I built this.
                </h2>
              </div>
              <p class="text-sm text-body leading-relaxed mb-4">
                When I first started learning Linux, I was terrified of running
                the wrong command and breaking my system. Most tutorials are
                either dry textbooks or videos that don't let you
                actually practice.
              </p>
              <p class="text-sm text-body leading-relaxed">
                I wanted to build one of the best Linux learning resources—a hands-on, zero-risk online Linux terminal where
                anyone can access free Linux learning without installing virtual machines or dual-booting.
              </p>
            </div>
          </div>
        </div>

        <!-- Rich Marketing/SEO Details Section (Safely moved and beautifully styled!) -->
        <div class="space-y-8 pt-6 border-t border-hairline">
          <div class="space-y-4">
            <h2 class="text-2xl font-bold text-ink tracking-tight">
              Free Online Linux Terminal Practice, with Instant Feedback
            </h2>
            <p class="body-sm text-body leading-relaxed">
              Linux terminal learning is faster and more permanent when you practice commands
              immediately. BashQuest provides an interactive online Linux terminal
              where you run real shell-style commands against a simulated
              Linux filesystem. Instead of passive tutorials, you achieve key terminal learning objectives through a gamified bash learning game that guides you step-by-step.
            </p>
            <p class="body-sm text-body leading-relaxed">
              Each quest focuses on a practical command-line skill: exploring
              directories with Linux terminal commands, listing files, searching text, using pipes,
              understanding permissions, and writing small bash scripts.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-4">
            <div class="space-y-3">
              <h3 class="text-lg font-bold text-ink">
                A Virtual Linux Terminal for Effective Learning
              </h3>
              <p class="body-sm text-body leading-relaxed">
                BashQuest acts like a full-featured Linux terminal online, but with
                structured learning objectives built in. The experience is gamified: you
                unlock quests in a curriculum tree, earn XP, and collect badges.
              </p>
              <p class="body-sm text-body leading-relaxed">
                The virtual environment is 100% safe. You can experiment freely
                because your workspace is simulated in the browser.
              </p>
            </div>

            <div class="space-y-3">
              <h3 class="text-lg font-bold text-ink">
                Why Hands-On Linux Terminal Practice Improves Retention
              </h3>
              <p class="body-sm text-body leading-relaxed">
                The fastest way to achieve linux learning mastery is repetition with
                structure. BashQuest combines short Linux terminal command challenges
                with actionable terminal learning objectives.
              </p>
              <p class="body-sm text-body leading-relaxed">
                Because the simulator is interactive, you develop real
                muscle memory: typing commands, reading terminal output, and iterating
                until you get the exact result.
              </p>
            </div>
          </div>

          <div
            class="card-marketing bg-canvas border border-hairline p-6 space-y-4"
          >
            <h3 class="text-base font-bold text-ink">
              From Essential Linux Terminal Commands to Bash Scripting
            </h3>
            <p class="body-sm text-body leading-relaxed">
              BashQuest is designed for free online Linux terminal practice and bash learning. You will
              work through hands-on tasks that gradually expand your abilities:
            </p>
            <ul
              class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono text-body pl-2"
            >
              <li class="flex items-center gap-2">
                ✓ Explore and navigate filesystems
              </li>
              <li class="flex items-center gap-2">
                ✓ Manipulate text with patterns
              </li>
              <li class="flex items-center gap-2">
                ✓ Pipe & filter command output
              </li>
              <li class="flex items-center gap-2">
                ✓ Practice matching and wildcards
              </li>
              <li class="flex items-center gap-2">✓ Manage file permissions</li>
              <li class="flex items-center gap-2">
                ✓ Test simple shell scripts
              </li>
            </ul>
          </div>
        </div>

        <!-- Curriculum Module Outline -->
        <div class="space-y-6 pt-6 border-t border-hairline">
          <div class="border-l-2 border-primary pl-4">
            <h2
              class="text-xl font-sans font-extrabold text-ink tracking-tight"
            >
              What you'll learn.
            </h2>
            <p class="body-sm text-body mt-1">
              Our progressive curriculum covers 16 core Linux administration
              skill sets:
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
            {
              modules.map((mod) => (
                <div class="p-4 bg-canvas border border-hairline rounded-md shadow-level-2 hover:shadow-level-3 transition-all duration-200">
                  <div class="caption-mono text-mute uppercase font-semibold mb-1">
                    Module {mod.id}
                  </div>
                  <h3 class="font-sans text-sm font-bold text-ink leading-tight">
                    {mod.title.replace(/^\d+\.\s*/, "")}
                  </h3>
                </div>
              ))
            }
          </div>
        </div>

        <!-- CTA Back to learning -->
        <div class="flex justify-center pt-4">
          <a
            href="/?view=dashboard"
            class="button-primary text-sm font-medium animate-pulse-slow"
          >
            Go to Curriculum Tree
          </a>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <Footer />
  </div>
</Layout>
