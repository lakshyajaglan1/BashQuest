---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
---

<Layout
    title="Contact Us — BashQuest | Free Linux Learning Platform Support"
    description="Get in touch with the BashQuest team for feedback, bug reports, feature requests, or questions about our free interactive Linux terminal simulator and Bash learning platform."
>
    <div class="flex flex-col min-h-screen">
        <Navigation />

        <main
            class="flex-1 w-full bg-canvas-soft mesh-gradient py-12 px-4 md:px-8 select-text"
        >
            <div class="max-w-3xl mx-auto space-y-8">
                <div class="space-y-4">
                    <span
                        class="caption-mono uppercase tracking-widest text-mute bg-canvas-soft-2 px-3 py-1 rounded border border-hairline"
                        >Get In Touch</span
                    >
                    <h1 class="display-lg text-ink font-bold tracking-tight">
                        Contact Us.
                    </h1>
                    <p class="body-md text-body">
                        Have feedback, found a bug, or want to suggest a new
                        quest? Feel free to reach out.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Contact Methods -->
                    <div
                        class="card-marketing border border-hairline bg-canvas p-6 shadow-level-2 space-y-4"
                    >
                        <h2 class="text-base font-bold text-ink">
                            Direct Channels
                        </h2>
                        <div class="space-y-3 font-mono text-xs">
                            <div>
                                <span class="text-mute block"
                                    >Email Support</span
                                >
                                <a
                                    href="mailto:support@bashquest.com"
                                    class="text-link hover:underline"
                                    >support@bashquest.com</a
                                >
                            </div>
                            <div>
                                <span class="text-mute block"
                                    >Project Repository</span
                                >
                                <a
                                    href="https://github.com/withastro/astro"
                                    target="_blank"
                                    class="text-link hover:underline"
                                    >GitHub Issues</a
                                >
                            </div>
                        </div>
                    </div>

                    <!-- Community Support -->
                    <div
                        class="card-marketing border border-hairline bg-canvas p-6 shadow-level-2 space-y-4"
                    >
                        <h2 class="text-base font-bold text-ink">
                            Support Development
                        </h2>
                        <p class="text-xs text-body leading-relaxed">
                            BashQuest is free, ad-free, and open source. If you
                            find it helpful, consider supporting the continuous
                            development of more quests.
                        </p>
                        <a
                            href="https://ko-fi.com/bashquest_dev"
                            target="_blank"
                            class="button-secondary h-9 rounded-sm text-xs font-semibold hover:bg-canvas-soft-2 transition-all w-full flex justify-center items-center gap-2"
                        >
                            <span>☕ Buy Me a Coffee</span>
                        </a>
                    </div>
                </div>

                <div class="flex justify-center">
                    <a
                        href="/?view=dashboard"
                        class="button-primary text-sm font-medium"
                    >
                        Back to Dashboard
                    </a>
                </div>
            </div>
        </main>

        <Footer />
    </div>
</Layout>
