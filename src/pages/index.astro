---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Dashboard from "../components/Dashboard.astro";
import FileSystemVisualizer from "../components/FileSystemVisualizer.astro";
import Terminal from "../components/Terminal.astro";
import LessonPanel from "../components/LessonPanel.astro";
import Footer from "../components/Footer.astro";
import { modules } from "../lib/lessons.js";

const softwareAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "BashQuest",
  applicationCategory: "EducationalApplication",
  operatingSystem: "Any (Web Browser)",
  url: "https://bashquest.com/",
  description:
    "A free, interactive terminal simulator with gamified quests to learn Linux and Bash commands directly in your browser. No signup required.",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};
---

<Layout structuredData={softwareAppSchema}>
  <!-- Global Application Shell -->
  <div class="flex flex-col min-h-screen">
    <!-- Navbar -->
    <Navigation />

    <!-- Views Container -->
    <main class="flex-1 w-full relative">
      <!-- VIEW 1: Dashboard -->
      <section id="view-dashboard" class="block">
        <Dashboard />
      </section>

      <!-- VIEW 2: Interactive Sandbox Workspace -->
      <section
        id="view-sandbox"
        class="hidden lg:h-[calc(100vh-64px)] lg:overflow-hidden overflow-y-auto"
      >
        <div
          class="w-full py-4 lg:py-6 px-4 md:px-8 flex flex-col lg:grid lg:grid-cols-12 gap-6 h-auto lg:h-full min-h-0"
        >
          <!-- Left Column: Lesson Instructions Panel (5 cols) -->
          <div class="lg:col-span-5 h-auto lg:h-full min-h-0">
            <LessonPanel />
          </div>

          <!-- Right Column: Visual Explorer & Terminal (7 cols) -->
          <div
            class="lg:col-span-7 flex flex-col gap-6 h-auto lg:h-full min-h-0"
          >
            <!-- Filesystem Visual Explorer -->
            <div class="flex-1 min-h-[180px] lg:min-h-0">
              <FileSystemVisualizer />
            </div>

            <!-- Terminal Simulator Box -->
            <div class="flex-1 min-h-0">
              <Terminal />
            </div>
          </div>
        </div>
      </section>

      <!-- VIEW 3: Instant-Load About Page View -->
      <section id="view-about" class="hidden">
        <div class="w-full bg-canvas-soft py-12 px-4 md:px-8 select-text">
          <div class="max-w-4xl mx-auto space-y-12">
            <!-- Header -->
            <div class="text-center md:text-left space-y-4">
              <span
                class="caption-mono uppercase tracking-widest text-mute bg-canvas-soft-2 px-3 py-1 rounded border border-hairline"
                >Project details</span
              >
              <h1 class="display-lg text-ink font-bold tracking-tight">
                About BashQuest.
              </h1>
              <p class="body-lg text-body max-w-2xl">
                A free, open-source Linux learning playground designed to teach
                you shell commands through actual browser-based filesystem
                interactions.
              </p>
            </div>

            <!-- Details Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <!-- What is BashQuest Card -->
              <div
                class="card-marketing border border-hairline bg-canvas p-6 flex flex-col justify-between shadow-level-3"
              >
                <div>
                  <div class="flex items-center gap-3 mb-4">
                    <div
                      class="w-10 h-10 rounded-full bg-violet-soft text-violet flex items-center justify-center font-mono text-lg font-bold"
                    >
                      $
                    </div>
                    <h2
                      class="text-xl font-sans font-extrabold text-ink tracking-tight"
                    >
                      What is BashQuest?
                    </h2>
                  </div>
                  <p class="body-sm text-body leading-relaxed mt-2">
                    BashQuest is a free, interactive command-line learning
                    simulator built specifically for hands-on education. Unlike
                    online video courses where you passively watch others work,
                    BashQuest forces you to learn by actually typing commands.
                  </p>
                  <p class="body-sm text-body leading-relaxed mt-4">
                    Under the hood, it features a custom-built, simulated
                    terminal and directory structure. The tasks you execute
                    directly modify a local virtual filesystem that tests and
                    validates your work in real-time, giving you immediate
                    feedback.
                  </p>
                </div>
              </div>

              <!-- Why I Built This Card -->
              <div
                class="card-marketing border border-hairline bg-canvas p-6 flex flex-col justify-between shadow-level-3"
              >
                <div>
                  <div class="flex items-center gap-3 mb-4">
                    <div
                      class="w-10 h-10 rounded-full bg-cyan-soft text-cyan-deep flex items-center justify-center font-sans text-lg font-bold"
                    >
                      💡
                    </div>
                    <h2
                      class="text-xl font-sans font-extrabold text-ink tracking-tight"
                    >
                      Why I built this.
                    </h2>
                  </div>
                  <p class="text-sm text-body leading-relaxed mb-4">
                    When I first started learning Linux, I was terrified of
                    running the wrong command and breaking my system. Most
                    tutorials are either boring videos or dry textbooks that
                    don't let you actually practice.
                  </p>
                  <p class="text-sm text-body leading-relaxed">
                    I wanted to build a hands-on, zero-risk environment where
                    beginners could learn by doing. I engineered BashQuest using
                    Astro and Vanilla JS so it runs entirely client-side—meaning
                    it's lightning fast, requires no servers, and protects your
                    privacy.
                  </p>
                </div>
              </div>
            </div>

            <!-- Rich Marketing/SEO Details Section -->
            <div class="space-y-8 pt-6 border-t border-hairline">
              <div class="space-y-4">
                <h2 class="text-2xl font-bold text-ink tracking-tight">
                  Practice Linux Commands Online, with Instant Feedback
                </h2>
                <p class="body-sm text-body leading-relaxed">
                  Learning the command line is easier when you can try things
                  immediately. BashQuest provides an interactive terminal
                  sandbox where you can run real shell-style commands against a
                  simulated Linux filesystem. Instead of watching videos or
                  reading static examples, you build skill by completing short
                  quests that guide you step-by-step—then you verify your output
                  right inside the browser.
                </p>
                <p class="body-sm text-body leading-relaxed">
                  Each quest focuses on a practical command-line skill:
                  exploring directories, listing files, searching text, using
                  pipes, understanding permissions, and writing small bash
                  scripts. As you progress, the tasks become more realistic so
                  your learning transfers to your real computer.
                </p>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-4">
                <div class="space-y-3">
                  <h3 class="text-lg font-bold text-ink">
                    A Virtual Linux Terminal Simulator
                  </h3>
                  <p class="body-sm text-body leading-relaxed">
                    BashQuest acts like a Linux terminal emulator, but with
                    structured learning built in. The experience is gamified:
                    you unlock quests in a curriculum tree, earn XP, and collect
                    badges. That means every practice session has a clear
                    purpose.
                  </p>
                  <p class="body-sm text-body leading-relaxed">
                    The virtual environment is safe. You can experiment freely
                    because your workspace is simulated. If you run a risky
                    command or make a mistake, it stays within the interactive
                    terminal sandbox and does not affect your machine.
                  </p>
                </div>

                <div class="space-y-3">
                  <h3 class="text-lg font-bold text-ink">
                    Why Practice Helps You Improve Faster
                  </h3>
                  <p class="body-sm text-body leading-relaxed">
                    The fastest way to improve at the terminal is repetition
                    with structure. BashQuest gives you both: short command
                    challenges and a curriculum that keeps you moving forward.
                    You can focus on learning topics one at a time, while still
                    working within a single consistent environment.
                  </p>
                  <p class="body-sm text-body leading-relaxed">
                    Because the simulator is interactive, you can develop real
                    muscle memory: typing commands, reading output, and
                    iterating until you get the exact result. Over time, these
                    steps become automatic.
                  </p>
                </div>
              </div>

              <div
                class="card-marketing bg-canvas border border-hairline p-6 space-y-4"
              >
                <h3 class="text-base font-bold text-ink">
                  From One-Liners to Bash Scripts
                </h3>
                <p class="body-sm text-body leading-relaxed">
                  BashQuest is made for practicing bash scripts online and for
                  understanding how bash command-line tools work together. You
                  will work through tasks that gradually expand your abilities:
                </p>
                <ul
                  class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono text-body pl-2 animate-none"
                >
                  <li class="flex items-center gap-2">
                    ✓ Explore and navigate filesystems
                  </li>
                  <li class="flex items-center gap-2">
                    ✓ Manipulate text with patterns
                  </li>
                  <li class="flex items-center gap-2">
                    ✓ Pipe & filter command output
                  </li>
                  <li class="flex items-center gap-2">
                    ✓ Practice matching and wildcards
                  </li>
                  <li class="flex items-center gap-2">
                    ✓ Manage file permissions
                  </li>
                  <li class="flex items-center gap-2">
                    ✓ Test simple shell scripts
                  </li>
                </ul>
              </div>
            </div>

            <!-- Curriculum Module Outline -->
            <div class="space-y-6 pt-6 border-t border-hairline">
              <div class="border-l-2 border-primary pl-4">
                <h2
                  class="text-xl font-sans font-extrabold text-ink tracking-tight"
                >
                  What you'll learn.
                </h2>
                <p class="body-sm text-body mt-1">
                  Our progressive curriculum covers 16 core Linux administration
                  skill sets:
                </p>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                {
                  modules.map((mod) => (
                    <div class="p-4 bg-canvas border border-hairline rounded-md shadow-level-2 hover:shadow-level-3 transition-all duration-200">
                      <div class="caption-mono text-mute uppercase font-semibold mb-1">
                        Module {mod.id}
                      </div>
                      <h3 class="font-sans text-sm font-bold text-ink leading-tight">
                        {mod.title.replace(/^\d+\.\s*/, "")}
                      </h3>
                    </div>
                  ))
                }
              </div>
            </div>

            <!-- CTA Back to learning -->
            <div class="flex justify-center pt-4">
              <button
                id="btn-back-to-dashboard-from-about"
                class="button-primary text-sm font-medium animate-pulse-slow"
              >
                Go to Curriculum Tree
              </button>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- Floating Feedback Trigger Button -->
    <button
      id="btn-feedback"
      class="fixed bottom-6 right-6 z-40 flex items-center gap-2 h-10 px-4 rounded-full bg-[#171717] hover:bg-[#000000] text-white dark:bg-white dark:text-[#171717] dark:hover:bg-[#eaeaea] text-xs font-semibold shadow-level-3 cursor-pointer select-none transition-all border-none"
    >
      <span>💬</span> Feedback
    </button>

    <!-- Feedback Popover Dialog Modal -->
    <div
      id="modal-feedback"
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs hidden select-none"
    >
      <div
        class="w-full max-w-md bg-canvas rounded-lg border border-hairline shadow-2xl p-6 relative animate-in fade-in zoom-in-95 duration-200 text-ink"
      >
        <!-- Close Button -->
        <button
          id="btn-close-feedback"
          class="absolute top-4 right-4 text-mute hover:text-ink cursor-pointer bg-transparent border-none"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>

        <!-- Header -->
        <div class="flex items-center gap-3 mb-4">
          <div
            class="flex items-center justify-center w-10 h-10 rounded-full bg-violet-soft text-violet"
          >
            <span>✍️</span>
          </div>
          <div>
            <h3 class="text-base font-bold tracking-tight">
              Share Your Feedback
            </h3>
            <p class="text-xs text-mute font-mono">Help improve BashQuest</p>
          </div>
        </div>

        <!-- Form Body -->
        <div class="space-y-4">
          <p class="text-xs text-body leading-relaxed">
            Found a bug, have an idea for a new quest, or want to share your
            thoughts? Enter your message below:
          </p>
          <div class="w-full bg-canvas rounded-md p-3 border border-hairline">
            <textarea
              id="feedback-textarea"
              placeholder="Type your ideas or feedback here..."
              class="w-full h-28 bg-transparent text-ink font-mono text-[11px] leading-relaxed resize-none outline-none border-none p-0 focus:ring-0"
              spellcheck="false"></textarea>
          </div>
        </div>

        <!-- CTAs -->
        <div class="flex justify-end gap-3 mt-5">
          <button
            id="btn-cancel-feedback"
            class="h-9 px-4 rounded-sm border border-hairline bg-canvas text-ink text-xs font-semibold hover:bg-canvas-soft-2 transition-all cursor-pointer"
          >
            Cancel
          </button>
          <button
            id="btn-submit-feedback"
            class="h-9 px-4 rounded-sm bg-primary text-on-primary text-xs font-semibold hover:opacity-90 transition-all cursor-pointer border-none"
          >
            Send Email
          </button>
        </div>
      </div>
    </div>

    <!-- Reusable Bottom Footer Component -->
    <Footer />

    <!-- GNU Nano Text Editor Mockup Modal (Vercel-inspired dark overlay) -->
    <div
      id="modal-nano-editor"
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-xs hidden select-none"
    >
      <div
        class="w-full max-w-3xl h-[85vh] bg-[#121212] text-[#d4d4d4] font-mono text-[13px] rounded-lg border border-white/10 shadow-2xl flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-200"
      >
        <!-- Nano Header -->
        <div
          class="bg-[#1e1e1e] px-4 py-2 text-center text-white border-b border-white/5 relative flex justify-between select-none"
        >
          <span class="font-bold">GNU nano 7.2 equivalent</span>
          <span id="nano-filename" class="font-bold text-success"
            >File: server.conf</span
          >
          <span id="nano-modified" class="text-orange-400 font-semibold"></span>
        </div>

        <!-- Textarea Body -->
        <div
          class="flex-1 p-4 bg-[#121212] relative overflow-hidden flex flex-col"
        >
          <textarea
            id="nano-textarea"
            class="flex-1 w-full bg-transparent border-none outline-none resize-none font-mono text-[13px] text-white caret-white focus:ring-0 focus:outline-none p-0 m-0 leading-relaxed overflow-y-auto"
            placeholder="Type file contents here..."
            spellcheck="false"></textarea>
        </div>

        <!-- Shortcut Commands Guide (traditional Nano layout) -->
        <div
          class="bg-[#1a1a1a] p-3 border-t border-white/5 text-[11px] leading-relaxed text-mute grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-x-4 gap-y-1.5 select-none border-b border-white/5"
        >
          <div>
            <span
              class="text-white font-bold bg-[#333] px-1 py-0.5 rounded-xs mr-1"
              >^G</span
            > Get Help
          </div>
          <div>
            <span
              class="text-white font-bold bg-[#333] px-1 py-0.5 rounded-xs mr-1"
              >^O</span
            > Write Out
          </div>
          <div>
            <span
              class="text-white font-bold bg-[#333] px-1 py-0.5 rounded-xs mr-1"
              >^W</span
            > Where Is
          </div>
          <div>
            <span
              class="text-white font-bold bg-[#333] px-1 py-0.5 rounded-xs mr-1"
              >^K</span
            > Cut Text
          </div>
          <div>
            <span
              class="text-white font-bold bg-[#333] px-1 py-0.5 rounded-xs mr-1"
              >^J</span
            > Justify
          </div>
          <div>
            <span
              class="text-white font-bold bg-[#333] px-1 py-0.5 rounded-xs mr-1"
              >^C</span
            > Cur Pos
          </div>
          <div>
            <span
              class="text-white font-bold bg-[#333] px-1 py-0.5 rounded-xs mr-1"
              >^X</span
            > Exit
          </div>
          <div>
            <span
              class="text-white font-bold bg-[#333] px-1 py-0.5 rounded-xs mr-1"
              >^R</span
            > Read File
          </div>
          <div>
            <span
              class="text-white font-bold bg-[#333] px-1 py-0.5 rounded-xs mr-1"
              >^\</span
            > Replace
          </div>
          <div>
            <span
              class="text-white font-bold bg-[#333] px-1 py-0.5 rounded-xs mr-1"
              >^U</span
            > Paste Text
          </div>
          <div>
            <span
              class="text-white font-bold bg-[#333] px-1 py-0.5 rounded-xs mr-1"
              >^T</span
            > To Spell
          </div>
          <div>
            <span
              class="text-white font-bold bg-[#333] px-1 py-0.5 rounded-xs mr-1"
              >^_</span
            > Go To Line
          </div>
        </div>

        <!-- Save CTAs Bar -->
        <div
          class="bg-[#1e1e1e] px-4 py-3 border-t border-white/10 flex flex-col sm:flex-row justify-between items-center gap-2 select-none"
        >
          <span class="text-[11px] text-[#888]"
            >Tip: Press Ctrl+O to Save, Ctrl+X to Save & Exit</span
          >
          <div class="flex gap-2">
            <button
              id="btn-nano-cancel"
              class="h-8 px-4 rounded-sm border border-white/10 text-white hover:bg-white/5 text-xs font-semibold cursor-pointer"
            >
              Cancel
            </button>
            <button
              id="btn-nano-save"
              class="h-8 px-4 rounded-sm bg-violet text-white hover:opacity-90 text-xs font-semibold cursor-pointer border-none"
            >
              Save Changes
            </button>
            <button
              id="btn-nano-exit"
              class="h-8 px-4 rounded-sm bg-[#ffffff] text-[#000000] hover:bg-[#eaeaea] text-xs font-semibold cursor-pointer border-none"
            >
              Save & Exit
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { FileSystem, ShellSession } from "../lib/linuxEngine";
  import { lessons } from "../lib/lessons";

  class AppStateManager {
    state: any;
    constructor() {
      this.state = {
        xp: 0,
        completedLessons: [],
        activeView: "dashboard",
        activeLessonId: 1,
        streak: 0,
        lastCompletedDate: null,
        fsTree: null,
        lessonStartTrees: {},
        installedPackages: [
          "pwd",
          "whoami",
          "clear",
          "help",
          "cd",
          "ls",
          "mkdir",
          "touch",
          "cat",
          "echo",
          "rm",
          "cp",
          "mv",
          "chmod",
          "grep",
          "wc",
          "uniq",
          "sort",
          "man",
          "apt",
          "df",
          "du",
          "free",
          "uptime",
          "uname",
          "ps",
          "top",
          "htop",
          "kill",
          "sleep",
          "jobs",
          "fg",
          "ping",
          "ip",
          "curl",
          "find",
          "history",
          "systemctl",
          "nano",
          "bash",
          "sed",
          "awk",
          "cut",
          "tr",
          "ln",
          "tar",
          "chown",
          "export",
          "env",
          "xargs",
          "head",
          "tail",
          "less",
          "more",
          "journalctl",
          "which",
          "alias",
          "crontab",
          "useradd",
          "passwd",
          "su",
          "ssh",
          "scp",
          "gzip",
          "gunzip",
          "groupadd",
          "groups",
          "lscpu",
          "lsof",
          "zip",
          "unzip",
          "bzip2",
          "xz",
          "dpkg",
          "dnf",
          "yum",
          "adduser",
          "userdel",
          "id",
          "groupdel",
          "ifconfig",
          "nmcli",
          "netstat",
          "ss",
          "traceroute",
          "ufw",
          "iptables",
          "nice",
          "renice",
          "bg",
          "iostat",
          "exit",
        ],
      };

      this.init();
    }

    init() {
      this.loadFromStorage();

      if (typeof window !== "undefined") {
        const urlParams = new URLSearchParams(window.location.search);
        const viewParam = urlParams.get("view");
        if (
          viewParam === "dashboard" ||
          viewParam === "sandbox" ||
          viewParam === "about"
        ) {
          this.state.activeView = viewParam;
        }
      }

      this.resetFilesystem();
      this.bindEvents();
      this.broadcastState();
      this.applyViewVisibility();
    }

    resetFilesystem() {
      const fs = new FileSystem(this.state.fsTree);
      const completed = this.state.completedLessons;

      if (completed.includes(10) && !completed.includes(12)) {
        const statusNode = fs.getNodeByPath("/home/learner", "status.txt");
        if (!statusNode) {
          fs.createNode("/home/learner", "status.txt", "file", {
            content: "System Online\nAll Checks Green\n",
          });
        }
      }

      if (!completed.includes(13)) {
        const logFiles = [
          { name: "log_1.txt", content: "Log entry 1: System initiated.\n" },
          {
            name: "log_2.txt",
            content: "Log entry 2: System update started.\n",
          },
          {
            name: "log_3.txt",
            content: "Log entry 3: Database sync complete.\n",
          },
        ];
        for (const logFile of logFiles) {
          if (!fs.getNodeByPath("/home/learner", logFile.name)) {
            fs.createNode("/home/learner", logFile.name, "file", {
              content: logFile.content,
            });
          }
        }
      }

      if (!completed.includes(14)) {
        if (!fs.getNodeByPath("/home/learner", "downloads")) {
          fs.createNode("/home/learner", "downloads", "dir");
        }
      }

      if (!completed.includes(16)) {
        if (!fs.getNodeByPath("/home/learner", "names.txt")) {
          fs.createNode("/home/learner", "names.txt", "file", {
            content: "Alice\nBob\nAlice\nCharlie\nBob\nDavid\nCharlie\n",
          });
        }
      }

      if (!completed.includes(17)) {
        if (!fs.getNodeByPath("/home/learner", "logs.txt")) {
          fs.createNode("/home/learner", "logs.txt", "file", {
            content:
              "[INFO] Service started.\n[WARNING] High memory usage.\n[ERROR] Database connection failed.\n[INFO] User logged in.\n[ERROR] Failed to start database service.\n",
          });
        }
      }

      if (!completed.includes(18)) {
        if (!fs.getNodeByPath("/home/learner", "deploy.sh")) {
          fs.createNode("/home/learner", "deploy.sh", "file", {
            content:
              '#!/bin/bash\necho "Deploying application..."\necho "Done!"\n',
            permissions: "644",
          });
        }
      }

      if (!completed.includes(21)) {
        if (!fs.getNodeByPath("/etc", "shadow")) {
          fs.createNode("/etc", "shadow", "file", {
            content:
              "root:$6$8zLx92xp$H9s2:18200:0:99999:7:::\nlearner:$6$1bYtM2op$P4w1:18200:0:99999:7:::\n",
            permissions: "000",
            owner: "root",
            group: "shadow",
          });
        }
      }

      if (!fs.getNodeByPath("/home/learner", "logs")) {
        fs.createNode("/home/learner", "logs", "dir");
        fs.createNode("/home/learner/logs", "app.log", "file", {
          content:
            "Jul 3 12:00:00 [INFO] System boot up completed.\nJul 3 12:05:00 [INFO] Started web server service.\nJul 3 12:10:00 [WARNING] Disk space warning: 80% used.\n",
        });
        fs.createNode("/home/learner/logs", "security.log", "file", {
          content:
            "Jul 3 12:01:00 [INFO] User root logged in via ssh.\nJul 3 12:02:15 [WARNING] SSH Login failure from 192.168.1.100.\n",
        });
      }

      if (!completed.includes(38)) {
        if (!fs.getNodeByPath("/home/learner", "server.conf")) {
          fs.createNode("/home/learner", "server.conf", "file", {
            content: "host=127.0.0.1\nport=80\nmax_connections=100\n",
          });
        }
      }

      if (!completed.includes(45)) {
        if (!fs.getNodeByPath("/home/learner", "reports.csv")) {
          fs.createNode("/home/learner", "reports.csv", "file", {
            content:
              "date,sales,visitors\njul 1,1200,450\njul 2,1500,500\njul 3,1800,600\n",
          });
        }
      }

      if (!completed.includes(61)) {
        if (!fs.getNodeByPath("/home/learner", "logs.tar.gz")) {
          fs.createNode("/home/learner", "logs.tar.gz", "file", {
            content: "tarball-archive-content\n",
          });
        }
      }

      if (!completed.includes(62)) {
        if (!fs.getNodeByPath("/home/learner", "note.txt")) {
          fs.createNode("/home/learner", "note.txt", "file", {
            content: "This is a configuration note that needs compression.\n",
          });
        }
      }

      if (!fs.getNodeByPath("/etc", "group")) {
        fs.createNode("/etc", "group", "file", {
          content: "root:x:0:\nlearner:x:1000:\nsudo:x:27:learner\n",
        });
      }

      this.state.fsTree = fs.tree;

      if (!this.state.lessonStartTrees) {
        this.state.lessonStartTrees = {};
      }
      const activeId = this.state.activeLessonId;
      if (!this.state.lessonStartTrees[activeId]) {
        this.state.lessonStartTrees[activeId] = JSON.parse(
          JSON.stringify(fs.tree),
        );
      }

      const session = new ShellSession(
        fs,
        "/home/learner",
        this.state.installedPackages,
      );

      const globalWindow = window as any;
      globalWindow.appState = {
        ...globalWindow.appState,
        fs: fs,
        session: session,
        terminalCommands: [],
        xp: this.state.xp,
        completedLessons: this.state.completedLessons,
        activeLessonId: this.state.activeLessonId,
        streak: this.state.streak,
        lastCompletedDate: this.state.lastCompletedDate,
      };
    }

    bindEvents() {
      window.addEventListener("app:view-change", (e: any) => {
        this.state.activeView = e.detail.view;
        this.applyViewVisibility();
        this.saveToStorage();
        this.broadcastState();
      });

      window.addEventListener("app:select-lesson", (e: any) => {
        this.state.activeLessonId = e.detail.lessonId;
        this.resetFilesystem();
        this.saveToStorage();
        this.broadcastState();
      });

      window.addEventListener("app:restore-lesson", () => {
        const activeId = this.state.activeLessonId;

        if (
          this.state.lessonStartTrees &&
          this.state.lessonStartTrees[activeId]
        ) {
          this.state.fsTree = JSON.parse(
            JSON.stringify(this.state.lessonStartTrees[activeId]),
          );
        } else {
          this.state.fsTree = null;
        }

        if (this.state.completedLessons.includes(activeId)) {
          this.state.completedLessons = this.state.completedLessons.filter(
            (id: number) => id !== activeId,
          );
          const lesson = lessons.find((l) => l.id === activeId);
          if (lesson) {
            this.state.xp = Math.max(0, this.state.xp - lesson.xp);
          }
        }

        this.resetFilesystem();
        this.saveToStorage();
        this.broadcastState();

        window.dispatchEvent(
          new CustomEvent("app:select-lesson", {
            detail: { lessonId: activeId },
          }),
        );
      });

      window.addEventListener("app:complete-lesson", (e: any) => {
        const { lessonId, xp } = e.detail;

        if (!this.state.completedLessons.includes(lessonId)) {
          this.state.completedLessons.push(lessonId);
          this.state.xp += xp;
        } else {
          const practiceXp = Math.max(5, Math.floor(xp * 0.1));
          this.state.xp += practiceXp;
        }

        this.updateStreak();
        this.saveToStorage();
        this.broadcastState();
      });

      window.addEventListener("app:reset-state", () => {
        localStorage.removeItem("bashquest_state");
        this.state = {
          xp: 0,
          completedLessons: [],
          activeView: "dashboard",
          activeLessonId: 1,
          streak: 0,
          lastCompletedDate: null,
          fsTree: null,
          lessonStartTrees: {},
          installedPackages: [
            "pwd",
            "whoami",
            "clear",
            "help",
            "cd",
            "ls",
            "mkdir",
            "touch",
            "cat",
            "echo",
            "rm",
            "cp",
            "mv",
            "chmod",
            "grep",
            "wc",
            "uniq",
            "sort",
            "man",
            "apt",
            "df",
            "du",
            "free",
            "uptime",
            "uname",
            "ps",
            "top",
            "htop",
            "kill",
            "sleep",
            "jobs",
            "fg",
            "ping",
            "ip",
            "curl",
            "find",
            "history",
            "systemctl",
            "nano",
            "bash",
            "sed",
            "awk",
            "cut",
            "tr",
            "ln",
            "tar",
            "chown",
            "export",
            "env",
            "xargs",
            "head",
            "tail",
            "less",
            "more",
            "journalctl",
            "which",
            "alias",
            "crontab",
            "useradd",
            "passwd",
            "su",
            "ssh",
            "scp",
            "gzip",
            "gunzip",
            "groupadd",
            "groups",
            "lscpu",
            "lsof",
            "zip",
            "unzip",
            "bzip2",
            "xz",
            "dpkg",
            "dnf",
            "yum",
            "adduser",
            "userdel",
            "id",
            "groupdel",
            "ifconfig",
            "nmcli",
            "netstat",
            "ss",
            "traceroute",
            "ufw",
            "iptables",
            "nice",
            "renice",
            "bg",
            "iostat",
            "exit",
          ],
        };
        this.resetFilesystem();
        this.applyViewVisibility();

        window.dispatchEvent(
          new CustomEvent("app:trigger-view-change", {
            detail: { view: "dashboard" },
          }),
        );

        this.saveToStorage();
        this.broadcastState();
      });

      window.addEventListener("app:filesystem-update", () => {
        const globalWindow = window as any;
        if (globalWindow.appState && globalWindow.appState.fs) {
          this.state.fsTree = globalWindow.appState.fs.tree;
          this.saveToStorage();
        }
      });

      window.addEventListener("app:package-installed", (e: any) => {
        if (!this.state.installedPackages.includes(e.detail.package)) {
          this.state.installedPackages.push(e.detail.package);
          this.saveToStorage();
        }
      });

      window.addEventListener("app:export-save", () => {
        try {
          const saveCode = btoa(encodeURIComponent(JSON.stringify(this.state)));
          window.dispatchEvent(
            new CustomEvent("app:show-export-modal", { detail: { saveCode } }),
          );
        } catch (e) {
          console.error("Failed to export state", e);
        }
      });

      window.addEventListener("app:import-save", (e: any) => {
        const { saveCode } = e.detail;
        try {
          const decoded = decodeURIComponent(atob(saveCode));
          const parsedState = JSON.parse(decoded);

          if (
            !parsedState ||
            typeof parsedState !== "object" ||
            typeof parsedState.xp !== "number"
          ) {
            throw new Error("Malformed save code schema");
          }

          this.state = {
            ...this.state,
            ...parsedState,
          };

          this.saveToStorage();
          window.dispatchEvent(new CustomEvent("app:import-success"));
          window.location.reload();
        } catch (err) {
          console.error("Failed to import save code", err);
          window.dispatchEvent(
            new CustomEvent("app:import-error", {
              detail: {
                message:
                  "Invalid save code. Please ensure you copied the entire code correctly.",
              },
            }),
          );
        }
      });

      // Quick-access from about page button
      document
        .getElementById("btn-back-to-dashboard-from-about")
        ?.addEventListener("click", () => {
          window.dispatchEvent(
            new CustomEvent("app:trigger-view-change", {
              detail: { view: "dashboard" },
            }),
          );
        });
    }

    updateStreak() {
      const today = new Date();
      today.setHours(0, 0, 0, 0);

      const lastDate = this.state.lastCompletedDate
        ? new Date(this.state.lastCompletedDate)
        : null;
      if (lastDate) lastDate.setHours(0, 0, 0, 0);

      if (!lastDate) {
        this.state.streak = 1;
      } else {
        const diffTime = today.getTime() - lastDate.getTime();
        const diffDays = Math.round(diffTime / (1000 * 60 * 60 * 24));

        if (diffDays === 1) {
          this.state.streak += 1;
        } else if (diffDays > 1) {
          this.state.streak = 1;
        }
      }
      this.state.lastCompletedDate = today.toDateString();
    }

    applyViewVisibility() {
      const viewDash = document.getElementById("view-dashboard");
      const viewSand = document.getElementById("view-sandbox");
      const viewAbout = document.getElementById("view-about");
      const footer = document.querySelector("footer");

      // Hide all views first
      viewDash?.classList.add("hidden");
      viewDash?.classList.remove("block");
      viewSand?.classList.add("hidden");
      viewSand?.classList.remove("block", "grid");
      viewAbout?.classList.add("hidden");
      viewAbout?.classList.remove("block");

      if (this.state.activeView === "dashboard") {
        viewDash?.classList.remove("hidden");
        viewDash?.classList.add(
          "block",
          "animate-in",
          "fade-in",
          "duration-300",
        );
        footer?.classList.remove("hidden");
      } else if (this.state.activeView === "sandbox") {
        viewSand?.classList.remove("hidden");
        viewSand?.classList.add(
          "block",
          "animate-in",
          "fade-in",
          "duration-300",
        );
        footer?.classList.add("hidden");

        // Autofocus terminal prompt when entering workspace
        setTimeout(() => {
          document.getElementById("terminal-input")?.focus();
        }, 100);
      } else if (this.state.activeView === "about") {
        viewAbout?.classList.remove("hidden");
        viewAbout?.classList.add(
          "block",
          "animate-in",
          "fade-in",
          "duration-300",
        );
        footer?.classList.remove("hidden");
      }
    }

    broadcastState() {
      const globalWindow = window as any;
      if (globalWindow.appState) {
        globalWindow.appState.xp = this.state.xp;
        globalWindow.appState.completedLessons = this.state.completedLessons;
        globalWindow.appState.activeLessonId = this.state.activeLessonId;
        globalWindow.appState.streak = this.state.streak;
        globalWindow.appState.activeView = this.state.activeView;
      }

      window.dispatchEvent(
        new CustomEvent("app:state-updated", {
          detail: this.state,
        }),
      );
    }

    saveToStorage() {
      localStorage.setItem("bashquest_state", JSON.stringify(this.state));
    }

    loadFromStorage() {
      const saved = localStorage.getItem("bashquest_state");
      if (saved) {
        try {
          const parsed = JSON.parse(saved);
          this.state = { ...this.state, ...parsed };
        } catch (e) {
          console.error("Failed to parse storage, using defaults", e);
        }
      }
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    new AppStateManager();

    // Feedback popup handler
    const btnFeedback = document.getElementById("btn-feedback");
    const modalFeedback = document.getElementById("modal-feedback");
    const closeFeedback = document.getElementById("btn-close-feedback");
    const cancelFeedback = document.getElementById("btn-cancel-feedback");
    const submitFeedback = document.getElementById("btn-submit-feedback");
    const feedbackTextarea = document.getElementById(
      "feedback-textarea",
    ) as HTMLTextAreaElement;

    btnFeedback?.addEventListener("click", () => {
      if (feedbackTextarea) feedbackTextarea.value = "";
      modalFeedback?.classList.remove("hidden");
    });

    const hideFeedbackModal = () => {
      modalFeedback?.classList.add("hidden");
    };

    closeFeedback?.addEventListener("click", hideFeedbackModal);
    cancelFeedback?.addEventListener("click", hideFeedbackModal);

    modalFeedback?.addEventListener("click", (e: any) => {
      if (e.target === modalFeedback) {
        hideFeedbackModal();
      }
    });

    submitFeedback?.addEventListener("click", () => {
      const text = feedbackTextarea ? feedbackTextarea.value.trim() : "";
      if (!text) return;

      const mailtoUrl = `mailto:support@bashquest.com?subject=BashQuest Feedback&body=${encodeURIComponent(text)}`;
      window.location.href = mailtoUrl;
      hideFeedbackModal();
    });

    let currentNanoFile = "";
    let currentNanoPath = "";

    window.addEventListener("app:open-nano", (e: any) => {
      const { filename, currentPath, content } = e.detail;
      currentNanoFile = filename;
      currentNanoPath = currentPath;

      const modal = document.getElementById("modal-nano-editor");
      const textarea = document.getElementById(
        "nano-textarea",
      ) as HTMLTextAreaElement;
      const title = document.getElementById("nano-filename");
      const modified = document.getElementById("nano-modified");

      if (title) title.textContent = `File: ${filename}`;
      if (modified) modified.textContent = "";
      if (textarea) textarea.value = content;

      modal?.classList.remove("hidden");
      setTimeout(() => textarea?.focus(), 100);
    });

    document.getElementById("nano-textarea")?.addEventListener("input", () => {
      const modified = document.getElementById("nano-modified");
      if (modified) modified.textContent = "[ Modified ]";
    });

    document
      .getElementById("nano-textarea")
      ?.addEventListener("keydown", (e: any) => {
        if (e.ctrlKey && e.key === "o") {
          e.preventDefault();
          saveNanoContent(false);
        } else if (e.ctrlKey && e.key === "x") {
          e.preventDefault();
          saveNanoContent(true);
        }
      });

    function saveNanoContent(shouldExit = false) {
      const textarea = document.getElementById(
        "nano-textarea",
      ) as HTMLTextAreaElement;
      const content = textarea ? textarea.value : "";

      const globalWindow = window as any;
      if (
        globalWindow.appState &&
        globalWindow.appState.fs &&
        currentNanoFile
      ) {
        const fs = globalWindow.appState.fs;

        const existing = fs.getNodeByPath(currentNanoPath, currentNanoFile);
        if (existing && existing.type === "file") {
          existing.content = content;
        } else {
          fs.createNode(currentNanoPath, currentNanoFile, "file", { content });
        }

        window.dispatchEvent(new CustomEvent("app:filesystem-update"));

        window.dispatchEvent(
          new CustomEvent("app:print-terminal", {
            detail: {
              text: `[ File '${currentNanoFile}' saved successfully ]`,
            },
          }),
        );

        const modified = document.getElementById("nano-modified");
        if (modified) modified.textContent = "";
      }

      if (shouldExit) {
        document.getElementById("modal-nano-editor")?.classList.add("hidden");

        setTimeout(() => {
          document.getElementById("terminal-input")?.focus();
        }, 50);
      }
    }

    document
      .getElementById("btn-nano-cancel")
      ?.addEventListener("click", () => {
        document.getElementById("modal-nano-editor")?.classList.add("hidden");
        setTimeout(() => {
          document.getElementById("terminal-input")?.focus();
        }, 50);
      });
    document.getElementById("btn-nano-save")?.addEventListener("click", () => {
      saveNanoContent(false);
    });
    document.getElementById("btn-nano-exit")?.addEventListener("click", () => {
      saveNanoContent(true);
    });
  });
</script>
