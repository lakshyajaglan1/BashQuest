---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Dashboard from "../components/Dashboard.astro";
import FileSystemVisualizer from "../components/FileSystemVisualizer.astro";
import Terminal from "../components/Terminal.astro";
import LessonPanel from "../components/LessonPanel.astro";
import Footer from "../components/Footer.astro";
import WebTools from "../components/WebTools.astro";
import { getLocalizedModules } from "../i18n/lessons/index";
import { useTranslations, useTranslatedPath } from "../i18n/utils";

const lang = "en";
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const softwareAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "BashQuest",
  applicationCategory: "EducationalApplication",
  applicationSubCategory: "Online Linux Terminal & Interactive Linux Learning Website",
  operatingSystem: "Any (Web Browser)",
  url: "https://bashquest.com/",
  description:
    "A free online Linux terminal practice platform and bash learning game with 60+ quests. Learn Linux terminal commands, bash scripting, and master core terminal learning objectives directly in your browser with no installation required.",
  featureList: [
    "Online Linux terminal practice sandbox with zero install",
    "Free online Linux terminal practice with 60+ hands-on quests",
    "Interactive bash learning game with XP and badge system",
    "Master essential Linux terminal commands and text manipulation",
    "Clear terminal learning objectives across 16 curriculum modules",
    "Top-tier Linux learning website and beginner-friendly resource",
    "GNU Nano text editor practice in browser",
    "Grep, awk, sed, and command pipeline exercises",
    "File permissions and chmod tutorials",
    "100% client-side — fully private and free",
  ],
  screenshot: "https://bashquest.com/og-image.png",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "BashQuest",
  url: "https://bashquest.com",
  logo: "https://bashquest.com/favicon.svg",
  sameAs: [
    "https://github.com/lakshyajaglan1/BashQuest",
  ],
  description: "BashQuest is a premier Linux learning website providing free online Linux terminal practice, hands-on Linux terminal commands training, and interactive bash learning games.",
};
---

<Layout lang={lang} structuredData={[softwareAppSchema, orgSchema]}>
  <!-- Global Application Shell -->
  <div class="flex flex-col min-h-screen">
    <!-- Navbar -->
    <Navigation lang={lang} />

    <!-- Views Container -->
    <main class="flex-1 w-full relative">
      <!-- VIEW 1: Dashboard -->
      <section id="view-dashboard" class="block">
        <Dashboard lang={lang} />
      </section>


      <!-- VIEW 2: Interactive Sandbox Workspace -->
      <section
        id="view-sandbox"
        class="hidden lg:h-[calc(100vh-64px)] lg:overflow-hidden overflow-y-auto pb-24 lg:pb-0"
      >
        <!-- Mobile Panel Switcher (Visible on < lg screens) -->
        <div class="lg:hidden px-3 pt-3">
          <div class="flex items-center p-1 bg-canvas border border-hairline rounded-md shadow-xs text-xs font-mono">
            <button
              type="button"
              id="tab-mobile-lesson"
              class="flex-1 py-1.5 px-2 rounded-sm font-semibold transition-all flex items-center justify-center gap-1.5 cursor-pointer bg-primary text-on-primary"
            >
              <span>📖</span>
              <span>{t("nav.quest") || "Quest"}</span>
            </button>
            <button
              type="button"
              id="tab-mobile-terminal"
              class="flex-1 py-1.5 px-2 rounded-sm font-semibold transition-all flex items-center justify-center gap-1.5 cursor-pointer text-body hover:text-ink"
            >
              <span>💻</span>
              <span>Terminal</span>
            </button>
            <button
              type="button"
              id="tab-mobile-explorer"
              class="flex-1 py-1.5 px-2 rounded-sm font-semibold transition-all flex items-center justify-center gap-1.5 cursor-pointer text-body hover:text-ink"
            >
              <span>📁</span>
              <span>Files</span>
            </button>
          </div>
        </div>

        <div
          class="w-full py-3 lg:py-6 px-3 sm:px-4 md:px-8 flex flex-col lg:grid lg:grid-cols-12 gap-4 lg:gap-6 h-auto lg:h-full min-h-0"
        >
          <!-- Left Column: Lesson Instructions Panel (5 cols) -->
          <div id="container-mobile-lesson" class="block lg:block lg:col-span-5 h-auto lg:h-full min-h-0">
            <LessonPanel lang={lang} />
          </div>

          <!-- Right Column: Visual Explorer & Terminal (7 cols) -->
          <div
            id="container-mobile-workspace-right"
            class="contents lg:flex lg:col-span-7 lg:flex-col lg:gap-6 h-auto lg:h-full min-h-0"
          >
            <!-- Filesystem Visual Explorer -->
            <div id="container-mobile-explorer" class="hidden lg:block flex-1 min-h-[220px] lg:min-h-0">
              <FileSystemVisualizer />
            </div>

            <!-- Terminal Simulator Box -->
            <div id="container-mobile-terminal" class="hidden lg:block flex-1 min-h-[360px] lg:min-h-0">
              <Terminal />
            </div>
          </div>
        </div>
      </section>

      <!-- VIEW 3: Instant-Load About Page View -->
      <section id="view-about" class="hidden">
        <div class="w-full bg-canvas-soft py-12 px-4 md:px-8 select-text">
          <div class="max-w-4xl mx-auto space-y-12">
            <!-- Header -->
            <div class="text-center md:text-left space-y-4">
              <span
                class="caption-mono uppercase tracking-widest text-mute bg-canvas-soft-2 px-3 py-1 rounded border border-hairline"
                >Project details</span
              >
              <h2 class="display-lg text-ink font-bold tracking-tight">
                About BashQuest.
              </h2>
              <p class="body-lg text-body max-w-2xl">
                A free, open-source Linux learning playground designed to teach
                you shell commands through actual browser-based filesystem
                interactions.
              </p>
            </div>

            <!-- Details Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              <!-- What is BashQuest Card -->
              <div
                class="card-marketing border border-hairline bg-canvas p-6 flex flex-col justify-between shadow-level-3"
              >
                <div>
                  <div class="flex items-center gap-3 mb-4">
                    <div
                      class="w-10 h-10 rounded-full bg-violet-soft text-violet flex items-center justify-center font-mono text-lg font-bold"
                    >
                      $
                    </div>
                    <h2
                      class="text-xl font-sans font-extrabold text-ink tracking-tight"
                    >
                      What is BashQuest?
                    </h2>
                  </div>
                  <p class="body-sm text-body leading-relaxed mt-2">
                    BashQuest is a free, interactive command-line learning
                    simulator built specifically for hands-on education. Unlike
                    online video courses where you passively watch others work,
                    BashQuest forces you to learn by actually typing commands.
                  </p>
                  <p class="body-sm text-body leading-relaxed mt-4">
                    Under the hood, it features a custom-built, simulated
                    terminal and directory structure. The tasks you execute
                    directly modify a local virtual filesystem that tests and
                    validates your work in real-time, giving you immediate
                    feedback.
                  </p>
                </div>
              </div>

              <!-- Why I Built This Card -->
              <div
                class="card-marketing border border-hairline bg-canvas p-6 flex flex-col justify-between shadow-level-3"
              >
                <div>
                  <div class="flex items-center gap-3 mb-4">
                    <div
                      class="w-10 h-10 rounded-full bg-cyan-soft text-cyan-deep flex items-center justify-center font-sans text-lg font-bold"
                    >
                      💡
                    </div>
                    <h2
                      class="text-xl font-sans font-extrabold text-ink tracking-tight"
                    >
                      Why I built this.
                    </h2>
                  </div>
                  <p class="text-sm text-body leading-relaxed mb-4">
                    When I first started learning Linux, I was terrified of
                    running the wrong command and breaking my system. Most
                    tutorials are either boring videos or dry textbooks that
                    don't let you actually practice.
                  </p>
                  <p class="text-sm text-body leading-relaxed">
                    I wanted to build a hands-on, zero-risk environment where
                    beginners could learn by doing. I engineered BashQuest using
                    Astro and Vanilla JS so it runs entirely client-side—meaning
                    it's lightning fast, requires no servers, and protects your
                    privacy.
                  </p>
                </div>
              </div>
            </div>

            <!-- Rich Marketing/SEO Details Section -->
            <div class="space-y-8 pt-6 border-t border-hairline">
              <div class="space-y-4">
                <h2 class="text-2xl font-bold text-ink tracking-tight">
                  Practice Linux Commands Online, with Instant Feedback
                </h2>
                <p class="body-sm text-body leading-relaxed">
                  Learning the command line is easier when you can try things
                  immediately. BashQuest provides an interactive terminal
                  sandbox where you can run real shell-style commands against a
                  simulated Linux filesystem. Instead of watching videos or
                  reading static examples, you build skill by completing short
                  quests that guide you step-by-step—then you verify your output
                  right inside the browser.
                </p>
                <p class="body-sm text-body leading-relaxed">
                  Each quest focuses on a practical command-line skill:
                  exploring directories, listing files, searching text, using
                  pipes, understanding permissions, and writing small bash
                  scripts. As you progress, the tasks become more realistic so
                  your learning transfers to your real computer.
                </p>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-4">
                <div class="space-y-3">
                  <h3 class="text-lg font-bold text-ink">
                    A Virtual Linux Terminal Simulator
                  </h3>
                  <p class="body-sm text-body leading-relaxed">
                    BashQuest acts like a Linux terminal emulator, but with
                    structured learning built in. The experience is gamified:
                    you unlock quests in a curriculum tree, earn XP, and collect
                    badges. That means every practice session has a clear
                    purpose.
                  </p>
                  <p class="body-sm text-body leading-relaxed">
                    The virtual environment is safe. You can experiment freely
                    because your workspace is simulated. If you run a risky
                    command or make a mistake, it stays within the interactive
                    terminal sandbox and does not affect your machine.
                  </p>
                </div>

                <div class="space-y-3">
                  <h3 class="text-lg font-bold text-ink">
                    Why Practice Helps You Improve Faster
                  </h3>
                  <p class="body-sm text-body leading-relaxed">
                    The fastest way to improve at the terminal is repetition
                    with structure. BashQuest gives you both: short command
                    challenges and a curriculum that keeps you moving forward.
                    You can focus on learning topics one at a time, while still
                    working within a single consistent environment.
                  </p>
                  <p class="body-sm text-body leading-relaxed">
                    Because the simulator is interactive, you can develop real
                    muscle memory: typing commands, reading output, and
                    iterating until you get the exact result. Over time, these
                    steps become automatic.
                  </p>
                </div>
              </div>

              <div
                class="card-marketing bg-canvas border border-hairline p-6 space-y-4"
              >
                <h3 class="text-base font-bold text-ink">
                  From One-Liners to Bash Scripts
                </h3>
                <p class="body-sm text-body leading-relaxed">
                  BashQuest is made for practicing bash scripts online and for
                  understanding how bash command-line tools work together. You
                  will work through tasks that gradually expand your abilities:
                </p>
                <ul
                  class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono text-body pl-2 animate-none"
                >
                  <li class="flex items-center gap-2">
                    ✓ Explore and navigate filesystems
                  </li>
                  <li class="flex items-center gap-2">
                    ✓ Manipulate text with patterns
                  </li>
                  <li class="flex items-center gap-2">
                    ✓ Pipe & filter command output
                  </li>
                  <li class="flex items-center gap-2">
                    ✓ Practice matching and wildcards
                  </li>
                  <li class="flex items-center gap-2">
                    ✓ Manage file permissions
                  </li>
                  <li class="flex items-center gap-2">
                    ✓ Test simple shell scripts
                  </li>
                </ul>
              </div>
            </div>

            <!-- Curriculum Module Outline -->
            <div class="space-y-6 pt-6 border-t border-hairline">
              <div class="border-l-2 border-primary pl-4">
                <h2
                  class="text-xl font-sans font-extrabold text-ink tracking-tight"
                >
                  What you'll learn.
                </h2>
                <p class="body-sm text-body mt-1">
                  Our progressive curriculum covers 16 core Linux administration
                  skill sets:
                </p>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                {
                  getLocalizedModules(lang).map((mod) => (
                    <div class="p-4 bg-canvas border border-hairline rounded-md shadow-level-2 hover:shadow-level-3 transition-all duration-200">
                      <div class="caption-mono text-mute uppercase font-semibold mb-1">
                        Module {mod.id}
                      </div>
                      <h3 class="font-sans text-sm font-bold text-ink leading-tight">
                        {mod.title.replace(/^\d+\.\s*/, "")}
                      </h3>
                    </div>
                  ))
                }
              </div>
            </div>

            <!-- CTA Back to learning -->
            <div class="flex justify-center pt-4">
              <button
                id="btn-back-to-dashboard-from-about"
                class="button-primary text-sm font-medium animate-pulse-slow"
              >
                Go to Curriculum Tree
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- VIEW 4: Interactive Web Tools -->
      <section id="view-tools" class="hidden">
        <div class="w-full bg-canvas-soft py-12 px-4 md:px-8 select-text">
          <div class="max-w-5xl mx-auto">
            <WebTools lang={lang} />
          </div>
        </div>
      </section>
    </main>

    <!-- Floating Feedback Trigger Button -->
    <button
      id="btn-feedback"
      class="fixed bottom-16 right-4 sm:bottom-6 sm:right-6 z-30 flex items-center gap-1.5 sm:gap-2 h-9 sm:h-10 px-3 sm:px-4 rounded-full bg-[#171717] hover:bg-[#000000] text-white dark:bg-white dark:text-[#171717] dark:hover:bg-[#eaeaea] text-xs font-semibold shadow-level-3 cursor-pointer select-none transition-all border-none"
    >
      <span>💬</span> <span class="hidden xs:inline">Feedback</span>
    </button>

    <!-- Feedback Popover Dialog Modal -->
    <div
      id="modal-feedback"
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-xs hidden"
    >
      <div
        class="w-full max-w-md bg-canvas rounded-lg border border-hairline shadow-2xl p-6 relative animate-in fade-in zoom-in-95 duration-200"
      >
        <button
          id="btn-close-feedback"
          class="absolute top-4 right-4 text-mute hover:text-ink cursor-pointer bg-transparent border-none"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>

        <div class="flex items-center gap-3 mb-4">
          <div
            class="flex items-center justify-center w-10 h-10 rounded-full bg-violet-soft text-violet"
          >
            <span>✍️</span>
          </div>
          <div>
            <h3 class="text-base font-bold tracking-tight">
              Share Your Feedback
            </h3>
            <p class="text-xs text-mute font-mono">Help improve BashQuest</p>
          </div>
        </div>

        <!-- Form Body -->
        <div class="space-y-4">
          <p class="text-xs text-body leading-relaxed">
            Found a bug, have an idea for a new quest, or want to share your
            thoughts? Enter your message below:
          </p>
          <div class="w-full bg-canvas rounded-md p-3 border border-hairline">
            <textarea
              id="feedback-textarea"
              placeholder="Type your ideas or feedback here..."
              class="w-full h-28 bg-transparent text-ink font-mono text-[11px] leading-relaxed resize-none outline-none border-none p-0 focus:ring-0"
              spellcheck="false"></textarea>
          </div>
        </div>

        <!-- CTAs -->
        <div class="flex justify-end gap-3 mt-5">
          <button
            id="btn-cancel-feedback"
            class="h-9 px-4 rounded-sm border border-hairline bg-canvas text-ink text-xs font-semibold hover:bg-canvas-soft-2 transition-all cursor-pointer"
          >
            Cancel
          </button>
          <button
            id="btn-submit-feedback"
            class="h-9 px-4 rounded-sm bg-primary text-on-primary text-xs font-semibold hover:opacity-90 transition-all cursor-pointer border-none"
          >
            Send Email
          </button>
        </div>
      </div>
    </div>

    <!-- Reusable Bottom Footer Component -->
    <Footer lang={lang} />


    <!-- GNU Nano Text Editor Mockup Modal (Vercel-inspired dark overlay) -->
    <div
      id="modal-nano-editor"
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-xs hidden select-none"
    >
      <div
        class="w-full max-w-3xl h-[85vh] bg-[#121212] text-[#d4d4d4] font-mono text-[13px] rounded-lg border border-white/10 shadow-2xl flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-200"
      >
        <!-- Nano Header -->
        <div
          class="bg-[#1e1e1e] px-4 py-2 text-center text-white border-b border-white/5 relative flex justify-between select-none"
        >
          <span class="font-bold">GNU nano 7.2 equivalent</span>
          <span id="nano-filename" class="font-bold text-success"
            >File: server.conf</span
          >
          <span id="nano-modified" class="text-orange-400 font-semibold"></span>
        </div>

        <!-- Textarea Body -->
        <div
          class="flex-1 p-4 bg-[#121212] relative overflow-hidden flex flex-col"
        >
          <textarea
            id="nano-textarea"
            class="flex-1 w-full bg-transparent border-none outline-none resize-none font-mono text-[13px] text-white caret-white focus:ring-0 focus:outline-none p-0 m-0 leading-relaxed overflow-y-auto"
            placeholder="Type file contents here..."
            spellcheck="false"></textarea>
        </div>

        <!-- Shortcut Commands Guide (traditional Nano layout) -->
        <div
          class="bg-[#1a1a1a] p-3 border-t border-white/5 text-[11px] leading-relaxed text-mute grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-x-4 gap-y-1.5 select-none border-b border-white/5"
        >
          <div>
            <span
              class="text-white font-bold bg-[#333] px-1 py-0.5 rounded-xs mr-1"
              >^G</span
            > Get Help
          </div>
          <div>
            <span
              class="text-white font-bold bg-[#333] px-1 py-0.5 rounded-xs mr-1"
              >^O</span
            > Write Out
          </div>
          <div>
            <span
              class="text-white font-bold bg-[#333] px-1 py-0.5 rounded-xs mr-1"
              >^W</span
            > Where Is
          </div>
          <div>
            <span
              class="text-white font-bold bg-[#333] px-1 py-0.5 rounded-xs mr-1"
              >^K</span
            > Cut Text
          </div>
          <div>
            <span
              class="text-white font-bold bg-[#333] px-1 py-0.5 rounded-xs mr-1"
              >^J</span
            > Justify
          </div>
          <div>
            <span
              class="text-white font-bold bg-[#333] px-1 py-0.5 rounded-xs mr-1"
              >^C</span
            > Cur Pos
          </div>
          <div>
            <span
              class="text-white font-bold bg-[#333] px-1 py-0.5 rounded-xs mr-1"
              >^X</span
            > Exit
          </div>
          <div>
            <span
              class="text-white font-bold bg-[#333] px-1 py-0.5 rounded-xs mr-1"
              >^R</span
            > Read File
          </div>
          <div>
            <span
              class="text-white font-bold bg-[#333] px-1 py-0.5 rounded-xs mr-1"
              >^\</span
            > Replace
          </div>
          <div>
            <span
              class="text-white font-bold bg-[#333] px-1 py-0.5 rounded-xs mr-1"
              >^U</span
            > Paste Text
          </div>
          <div>
            <span
              class="text-white font-bold bg-[#333] px-1 py-0.5 rounded-xs mr-1"
              >^T</span
            > To Spell
          </div>
          <div>
            <span
              class="text-white font-bold bg-[#333] px-1 py-0.5 rounded-xs mr-1"
              >^_</span
            > Go To Line
          </div>
        </div>

        <!-- Save CTAs Bar -->
        <div
          class="bg-[#1e1e1e] px-4 py-3 border-t border-white/10 flex flex-col sm:flex-row justify-between items-center gap-2 select-none"
        >
          <span class="text-[11px] text-[#888]"
            >Tip: Press Ctrl+O to Save, Ctrl+X to Save & Exit</span
          >
          <div class="flex gap-2">
            <button
              id="btn-nano-cancel"
              class="h-8 px-4 rounded-sm border border-white/10 text-white hover:bg-white/5 text-xs font-semibold cursor-pointer"
            >
              Cancel
            </button>
            <button
              id="btn-nano-save"
              class="h-8 px-4 rounded-sm bg-violet text-white hover:opacity-90 text-xs font-semibold cursor-pointer border-none"
            >
              Save Changes
            </button>
            <button
              id="btn-nano-exit"
              class="h-8 px-4 rounded-sm bg-[#ffffff] text-[#000000] hover:bg-[#eaeaea] text-xs font-semibold cursor-pointer border-none"
            >
              Save & Exit
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import "../scripts/appController";
</script>
