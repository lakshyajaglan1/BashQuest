---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

// These questions match real search phrases typed into Google by students and beginners
const faqs = [
    {
        q: "How can I practice Linux commands online without installing anything?",
        a: "You can practice Linux commands safely using BashQuest's built-in web terminal simulator. It provides a complete, simulated filesystem directly in your browser, meaning you can learn without setting up virtual machines, dual-booting, or installing software.",
    },
    {
        q: "Is there a safe online Linux terminal simulator for beginners?",
        a: "Yes. BashQuest is a simulated sandbox running entirely in client-side JavaScript. It behaves like a real Linux shell, but because it is a simulation, there is no risk of running destructive commands or damaging your computer.",
    },
    {
        q: "Where can I find free, hands-on Linux command-line quests?",
        a: "BashQuest offers a completely free, gamified curriculum of over 60 progressive quests. You can learn navigation, file creation, permissions (chmod), text editing with GNU Nano, search (grep), and pipelines directly through hands-on challenges.",
    },
    {
        q: "Do I need to sign up or create an account to learn Bash online?",
        a: "No registration, email, or account creation is required to use BashQuest. Anyone can access the interactive terminal sandbox immediately and start completing challenges with zero friction.",
    },
    {
        q: "Does this online Bash terminal practice save my progress?",
        a: "Yes. Your progress, XP, collected badges, and simulated directory state are saved locally on your device inside your browser's local storage. Your data remains completely private on your system.",
    },
    {
        q: "What Linux commands can I learn and practice in this browser sandbox?",
        a: "You can practice core filesystem and search utility commands including pwd, cd, ls, mkdir, touch, cat, echo, cp, mv, rm, chmod, and grep, along with interactive GNU Nano text editing, wildcards, and pipelines.",
    },
];

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.q,
        acceptedAnswer: {
            "@type": "Answer",
            text: faq.a,
        },
    })),
};
---

<Layout
    title="FAQ — Practice Linux Commands Online Safely"
    description="Answers to frequently asked questions about practicing Linux and Bash in a safe browser terminal simulator."
>
    <!-- Google Structured Data Script -->
    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(faqSchema)}
    />

    <div class="flex flex-col min-h-screen">
        <!-- Navbar -->
        <Navigation activePage="about" />

        <!-- Main Content -->
        <main
            class="flex-1 w-full bg-canvas-soft mesh-gradient py-12 px-4 md:px-8 select-text"
        >
            <div class="max-w-3xl mx-auto space-y-10">
                <!-- Header -->
                <div class="text-center space-y-4">
                    <span
                        class="caption-mono uppercase tracking-widest text-mute bg-canvas-soft-2 px-3 py-1 rounded border border-hairline"
                        >Help & Support</span
                    >
                    <h1 class="display-lg text-ink font-bold tracking-tight">
                        Frequently Asked Questions.
                    </h1>
                    <p class="body-md text-body max-w-lg mx-auto">
                        Everything you need to know about practicing Linux
                        commands online, saving your progress, and terminal
                        sandbox tools.
                    </p>
                </div>

                <!-- FAQ List -->
                <div class="space-y-6">
                    {
                        faqs.map((faq) => (
                            <div class="card-marketing border border-hairline bg-canvas p-6 shadow-level-2">
                                <h3 class="text-base font-bold text-ink flex items-start gap-2">
                                    <span class="text-violet font-mono font-bold shrink-0">
                                        Q:
                                    </span>
                                    <span>{faq.q}</span>
                                </h3>
                                <p class="body-sm text-body leading-relaxed mt-3 pl-5 border-l border-hairline">
                                    {faq.a}
                                </p>
                            </div>
                        ))
                    }
                </div>

                <!-- CTA Back to Dashboard -->
                <div class="flex justify-center pt-4">
                    <a
                        href="/?view=dashboard"
                        class="button-primary text-sm font-medium"
                    >
                        Back to Learning Path
                    </a>
                </div>
            </div>
        </main>

        <!-- Footer -->
        <Footer />
    </div>
</Layout>
