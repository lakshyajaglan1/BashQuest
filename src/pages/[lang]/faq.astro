---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import { nonDefaultLangs, type SupportedLanguage } from "../../i18n/languages";
import { localizedFaqs } from "../../i18n/faqData";
import { useTranslations, useTranslatedPath } from "../../i18n/utils";

export function getStaticPaths() {
  return nonDefaultLangs.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const faqs = localizedFaqs[lang] || localizedFaqs.en;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.a,
    },
  })),
};
---

<Layout
  title={t("meta.faqTitle")}
  description={t("meta.faqDescription")}
  lang={lang}
  structuredData={faqSchema}
>
  <div class="flex flex-col min-h-screen">
    <!-- Navbar -->
    <Navigation activePage="about" lang={lang} />

    <!-- Main Content -->
    <main
      class="flex-1 w-full bg-canvas-soft mesh-gradient py-12 px-4 md:px-8 select-text"
    >
      <div class="max-w-3xl mx-auto space-y-10">
        <!-- Header -->
        <div class="text-center space-y-4">
          <span
            class="caption-mono uppercase tracking-widest text-mute bg-canvas-soft-2 px-3 py-1 rounded border border-hairline"
            >Help &amp; Support</span
          >
          <h1 class="display-lg text-ink font-bold tracking-tight">
            {t("footer.faq")} — BashQuest.
          </h1>
          <p class="body-md text-body max-w-lg mx-auto">
            {t("meta.faqDescription")}
          </p>
        </div>

        <!-- FAQ List -->
        <div class="space-y-6">
          {
            faqs.map((faq) => (
              <div class="card-marketing border border-hairline bg-canvas p-6 shadow-level-2">
                <h3 class="text-base font-bold text-ink flex items-start gap-2">
                  <span class="text-violet font-mono font-bold shrink-0">
                    Q:
                  </span>
                  <span>{faq.q}</span>
                </h3>
                <p class="body-sm text-body leading-relaxed mt-3 pl-5 border-l border-hairline">
                  {faq.a}
                </p>
              </div>
            ))
          }
        </div>

        <!-- CTA Back to Dashboard -->
        <div class="flex justify-center pt-4">
          <a
            href={`${translatePath("/")}?view=dashboard`}
            class="button-primary text-sm font-medium decoration-none"
          >
            {t("hero.backToDashboard")}
          </a>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <Footer lang={lang} />
  </div>
</Layout>
