---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import { nonDefaultLangs, type SupportedLanguage } from "../../i18n/languages";
import { useTranslations, useTranslatedPath } from "../../i18n/utils";

export function getStaticPaths() {
  return nonDefaultLangs.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLanguage };
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout
  title={t("meta.privacyTitle")}
  description={t("meta.privacyDescription")}
  lang={lang}
>
  <div class="flex flex-col min-h-screen">
    <!-- Navbar -->
    <Navigation activePage="privacy" lang={lang} />

    <!-- Main Content -->
    <main
      class="flex-1 w-full bg-canvas-soft mesh-gradient py-8 sm:py-12 px-3 sm:px-4 md:px-8 select-text pb-24 md:pb-12"
    >
      <div class="max-w-3xl mx-auto space-y-8">
        <!-- Header -->
        <div class="space-y-4">
          <span
            class="caption-mono uppercase tracking-widest text-mute bg-canvas-soft-2 px-3 py-1 rounded border border-hairline"
            >Privacy &amp; Data</span
          >
          <h1 class="display-lg text-ink font-bold tracking-tight">
            {t("footer.privacy")}.
          </h1>
          <p class="body-md text-mute font-mono">Last updated: 2026</p>
        </div>

        <!-- Privacy Details Card -->
        <div
          class="card-marketing border border-hairline bg-canvas p-8 shadow-level-3 space-y-6"
        >
          <div class="space-y-2">
            <h2 class="text-lg font-sans font-bold text-ink">
              1. No Accounts Required.
            </h2>
            <p class="body-sm text-body leading-relaxed">
              We believe in frictionless learning. You do not need to sign up,
              log in, or provide any personal information to use BashQuest.
            </p>
          </div>

          <hr class="border-hairline" />

          <div class="space-y-2">
            <h2 class="text-lg font-sans font-bold text-ink">
              2. Local-Only Storage.
            </h2>
            <p class="body-sm text-body leading-relaxed">
              All your progress data—including completed lessons, earned XP,
              streaks, and virtual filesystem state—is stored <strong
                >exclusively inside your own browser's <code>localStorage</code></strong
              >.
            </p>
            <p class="body-sm text-body leading-relaxed">
              None of this information is transmitted to, processed, or stored
              on external servers.
            </p>
          </div>

          <hr class="border-hairline" />

          <div class="space-y-2">
            <h2 class="text-lg font-sans font-bold text-ink">
              3. Zero Tracking.
            </h2>
            <p class="body-sm text-body leading-relaxed">
              We do not sell personal data, use session tracking scripts, or
              store unnecessary cookies.
            </p>
          </div>
        </div>

        <!-- CTA Back to learning -->
        <div class="flex justify-center">
          <a
            href={`${translatePath("/")}?view=dashboard`}
            class="button-primary text-sm font-medium decoration-none"
          >
            {t("hero.backToDashboard")}
          </a>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <Footer lang={lang} />
  </div>
</Layout>
