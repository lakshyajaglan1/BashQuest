---
import "../styles/global.css";
import { languages, defaultLang, type SupportedLanguage } from "../i18n/languages";
import { getLangFromUrl, getAlternateLinks } from "../i18n/utils";
import { lessons } from "../lib/lessons.js";

interface Props {
	title?: string;
	description?: string;
	keywords?: string;
	lang?: SupportedLanguage;
	structuredData?: Record<string, any> | Record<string, any>[];
}

const detectedLang = getLangFromUrl(Astro.url);
const currentLang = Astro.props.lang || detectedLang;
const currentLangConfig = languages[currentLang] || languages[defaultLang];

const {
	title = "BashQuest - Online Linux Terminal & Interactive Linux Learning Website",
	description = `Master Linux terminal commands with BashQuest: a free online Linux terminal practice platform and bash learning game with ${lessons.length}+ interactive terminal learning objectives.`,
	keywords = "linux terminal, linux terminal commands, online linux terminal, linux terminal online, linux terminal practice, online linux terminal practice, free online linux terminal practice, best linux learning resources, linux learning free, linux learning website, linux learning, linux terminal learning, terminal learning objective, bash learning, bash learning game, practice linux commands online, interactive linux terminal simulator, learn bash in browser, online bash compiler, practice bash scripts online, linux terminal emulator, gamified bash tutorial, learn linux online free, linux command line tutorial for beginners, browser based bash shell, virtual linux terminal for beginners, bash scripting practice website, practice linux commands in browser, interactive bash shell tutorial, how to practice linux without installing, shell scripting practice online, linux command line basics, learn shell scripting free, linux for beginners, command line practice exercises, linux terminal online no install, sandboxed bash environment, browser based linux environment for students, linux commands cheat sheet practice, free linux learning platform, learn bash scripting online, linux administration tutorial, GNU coreutils practice, CLI first workflow, terminal based automation, devops linux basics, linux file permissions tutorial, grep awk sed practice",
	structuredData,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://bashquest.com");
const ogImageURL = new URL("/og-image.png", Astro.site || "https://bashquest.com");

const alternateLinks = (Astro.url.pathname.startsWith("/learn") || /\/(404|500)\/?$/.test(Astro.url.pathname)) ? [] : getAlternateLinks(Astro.url, Astro.site ? Astro.site.toString() : "https://bashquest.com");

const structuredDataList = structuredData
	? Array.isArray(structuredData)
		? structuredData
		: [structuredData]
	: [];
---

<!doctype html>
<html
	lang={currentLang}
	class="h-full bg-canvas-soft text-ink scroll-smooth"
>
	<head>
		<!-- Google tag (gtag.js) - Tracks visitor counts -->
		<script
			is:inline
			async
			src="https://www.googletagmanager.com/gtag/js?id=G-TLLVP20ZTT"
		></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag("js", new Date());

			gtag("config", "G-TLLVP20ZTT");
		</script>

		<meta charset="utf-8" />
		<!-- Theme initialization script to prevent flash -->
		<script is:inline>
			const theme = (() => {
				try { if (
					typeof localStorage !== "undefined" &&
					localStorage.getItem("theme")
				) {
					return localStorage.getItem("theme");
				}
				} catch { /* Storage can be unavailable in private or restricted contexts. */ }
				if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
					return "dark";
				}
				return "light";
			})();

			if (theme === "dark") {
				document.documentElement.classList.add("dark");
			} else {
				document.documentElement.classList.remove("dark");
			}
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<link
			rel="icon"
			type="image/png"
			href="/favicon-96x96.png"
			sizes="96x96"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href="/apple-touch-icon.png"
		/>
		<meta name="apple-mobile-web-app-title" content="BashQuest" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />

		<!-- SEO Optimization -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="BashQuest Team" />
		<meta
			name="robots"
			content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
		/>
		<meta name="keywords" content={keywords} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Multi-Language Hreflang Markup for Search Engines -->
		{
			alternateLinks.map((alt) => (
				<link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
			))
		}

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta
			property="og:image:alt"
			content="BashQuest interactive terminal sandbox"
		/>
		<meta property="og:site_name" content="BashQuest" />
		<meta property="og:locale" content={currentLangConfig.ogLocale} />
		{
			(Object.keys(languages) as SupportedLanguage[])
				.filter((l) => l !== currentLang)
				.map((otherLang) => (
					<meta
						property="og:locale:alternate"
						content={languages[otherLang].ogLocale}
					/>
				))
		}
		<meta property="og:url" content={canonicalURL} />

		<!-- Twitter Cards -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<meta name="twitter:site" content="@bashquest" />
		<meta name="twitter:creator" content="@bashquest" />

		<!-- Font preloads for better speed -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

		{
			structuredDataList.map((data) => (
				<script
					type="application/ld+json"
					set:html={JSON.stringify(data)}
				/>
			))
		}
	</head>
	<body class="h-full font-sans antialiased text-body">
		<a class="skip-link" href="#main-content">Skip to main content</a>
		<div id="storage-notice" class="learning-bridge" role="status" hidden>Progress cannot be saved in this browser. Keep this tab open and use Export Save on the dashboard before leaving.</div>
		<slot />
	</body>
</html>

