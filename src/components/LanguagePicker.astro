---
import { languages, type SupportedLanguage } from "../i18n/languages";
import { getLangFromUrl, useTranslatedPath, getRouteFromUrl } from "../i18n/utils";

interface Props {
  currentLang?: SupportedLanguage;
  variant?: "nav" | "footer";
}

const { variant = "nav" } = Astro.props;
const lang = Astro.props.currentLang || getLangFromUrl(Astro.url);
const currentRoute = getRouteFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const currentLangData = languages[lang] || languages.en;
---

<details class="group relative inline-block text-left select-none language-picker-root">
  <!-- Trigger Button -->
  <summary
    class={`language-picker-btn flex list-none items-center gap-1.5 rounded-sm border border-hairline transition-colors duration-150 cursor-pointer [&::-webkit-details-marker]:hidden ${
      variant === "nav"
        ? "h-8 px-2.5 bg-canvas text-ink text-xs font-medium hover:bg-canvas-soft-2"
        : "h-7 px-2 bg-canvas-soft text-body text-xs hover:text-ink hover:bg-canvas-soft-2"
    }`}
    aria-label="Select Language"
  >
    <!-- Globe / Translation Icon -->
    <svg
      aria-hidden="true"
      class="w-3.5 h-3.5 text-mute shrink-0"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      viewBox="0 0 24 24"
    >
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path
        d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
      ></path>
    </svg>

    <!-- Language Label: Full name on sm+, compact code on mobile -->
    <span class="font-sans tracking-tight hidden sm:inline">{currentLangData.nativeName}</span>
    <span class="text-mute font-mono text-[10px] uppercase font-semibold hidden sm:inline">({lang})</span>
    <span class="font-mono text-[11px] font-bold uppercase tracking-wider inline sm:hidden">{lang}</span>

    <!-- Down Chevron -->
    <svg
      aria-hidden="true"
      class="w-3 h-3 text-mute transition-transform duration-200 motion-reduce:transition-none group-open:rotate-180 arrow-icon shrink-0"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"
      ></path>
    </svg>
  </summary>

  <!-- Dropdown Menu -->
  <div
    class={`language-picker-menu absolute ${
      variant === "footer" ? "bottom-full mb-2" : "top-full mt-2"
    } right-0 z-[100] w-48 max-w-[calc(100vw-32px)] rounded-lg border border-hairline bg-canvas dark:bg-[#141414] p-1.5 shadow-2xl animate-in fade-in zoom-in-95 duration-150`}
  >
    <div class="py-0.5 space-y-0.5">

      {
        (Object.keys(languages) as SupportedLanguage[]).map((locale) => {
          const item = languages[locale];
          const isCurrent = locale === lang;
          const targetUrl = translatePath(currentRoute.startsWith("/learn") || /^\/(404|500)\/?$/.test(currentRoute) ? "/" : currentRoute, locale);

          return (
            <a
              href={targetUrl}
              class={`flex items-center justify-between px-3 py-1.5 rounded-sm text-xs font-sans transition-colors decoration-none ${
                isCurrent
                  ? "bg-primary text-on-primary font-semibold"
                  : "text-body hover:text-ink hover:bg-canvas-soft-2"
              }`}
              data-language-path={targetUrl}
              aria-current={isCurrent ? "true" : undefined}
              hreflang={locale}
              lang={locale}
            >
              <div class="flex items-center gap-2">
                <span class="uppercase font-mono text-[10px] font-semibold px-1.5 py-0.5 rounded bg-canvas-soft dark:bg-canvas-soft-2 text-ink border border-hairline opacity-85">
                  {locale}
                </span>
                <span class="text-mute opacity-50 select-none">·</span>
                <span>{item.nativeName}</span>
              </div>
              {isCurrent && (
                <svg
                  aria-hidden="true"
                  class="w-3.5 h-3.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M5 13l4 4L19 7"
                  />
                </svg>
              )}
            </a>
          );
        })
      }
    </div>
  </div>
</details>

<script>
  import { getLanguageHref } from "../lib/languageNavigation.js";

  function updateLanguageLinks() {
    // Read browser state because static HTML cannot contain the current query/hash,
    // and switching workspace tabs does not change the address bar.
    const state = (window as any).appState;
    document.querySelectorAll<HTMLAnchorElement>("[data-language-path]").forEach((link) => {
      link.href = getLanguageHref(window.location.href, link.dataset.languagePath!, state);
    });
  }

  function closeLanguagePickers(except?: Element) {
    document.querySelectorAll<HTMLDetailsElement>(".language-picker-root[open]").forEach((picker) => {
      if (picker !== except) picker.open = false;
    });
  }

  // Native details/summary works before JavaScript loads and supports Enter/Space.
  // Delegate once so page-load events never attach duplicate click handlers.
  document.addEventListener("toggle", (event) => {
    const picker = event.target;
    if (picker instanceof HTMLDetailsElement && picker.matches(".language-picker-root") && picker.open) {
      closeLanguagePickers(picker);
      updateLanguageLinks();
    }
  }, true);

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (target instanceof Element && !target.closest(".language-picker-root")) {
      closeLanguagePickers();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    const picker = document.activeElement?.closest<HTMLDetailsElement>(".language-picker-root[open]");
    closeLanguagePickers();
    picker?.querySelector("summary")?.focus();
  });

  document.addEventListener("focusin", (event) => {
    const target = event.target;
    closeLanguagePickers(target instanceof Element ? target.closest(".language-picker-root") ?? undefined : undefined);
  });

  updateLanguageLinks();
  document.addEventListener("astro:page-load", updateLanguageLinks);
  window.addEventListener("app:state-updated", updateLanguageLinks);
</script>
