---
import { languages, type SupportedLanguage } from "../i18n/languages";
import { getLangFromUrl, useTranslatedPath, getRouteFromUrl } from "../i18n/utils";

interface Props {
  currentLang?: SupportedLanguage;
  variant?: "nav" | "footer";
}

const { variant = "nav" } = Astro.props;
const lang = Astro.props.currentLang || getLangFromUrl(Astro.url);
const currentRoute = getRouteFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const currentLangData = languages[lang] || languages.en;
---

<div class="relative inline-block text-left select-none language-picker-root">
  <!-- Trigger Button -->
  <button
    type="button"
    class={`language-picker-btn flex items-center gap-1.5 rounded-sm border border-hairline transition-all duration-150 cursor-pointer ${
      variant === "nav"
        ? "h-8 px-2.5 bg-canvas text-ink text-xs font-medium hover:bg-canvas-soft-2"
        : "h-7 px-2 bg-canvas-soft text-body text-xs hover:text-ink hover:bg-canvas-soft-2"
    }`}
    aria-expanded="false"
    aria-haspopup="true"
    aria-label="Select Language"
  >
    <!-- Globe / Translation Icon -->
    <svg
      class="w-3.5 h-3.5 text-mute shrink-0"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      viewBox="0 0 24 24"
    >
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" y1="12" x2="22" y2="12"></line>
      <path
        d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
      ></path>
    </svg>

    <!-- Language Label: Full name on sm+, compact code on mobile -->
    <span class="font-sans tracking-tight hidden sm:inline">{currentLangData.nativeName}</span>
    <span class="text-mute font-mono text-[10px] uppercase font-semibold hidden sm:inline">({lang})</span>
    <span class="font-mono text-[11px] font-bold uppercase tracking-wider inline sm:hidden">{lang}</span>

    <!-- Down Chevron -->
    <svg
      class="w-3 h-3 text-mute transition-transform duration-200 arrow-icon shrink-0"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"
      ></path>
    </svg>
  </button>

  <!-- Dropdown Menu -->
  <div
    class={`language-picker-menu hidden absolute ${
      variant === "footer" ? "bottom-full mb-2" : "top-full mt-2"
    } right-0 z-[100] w-48 max-w-[calc(100vw-32px)] rounded-lg border border-hairline bg-canvas dark:bg-[#141414] p-1.5 shadow-2xl animate-in fade-in zoom-in-95 duration-150`}
    role="menu"
    aria-orientation="vertical"
  >
    <div class="py-0.5 space-y-0.5">

      {
        (Object.keys(languages) as SupportedLanguage[]).map((locale) => {
          const item = languages[locale];
          const isCurrent = locale === lang;
          const targetUrl = translatePath(currentRoute.startsWith("/learn") || /^\/(404|500)\/?$/.test(currentRoute) ? "/" : currentRoute, locale);

          return (
            <a
              href={targetUrl}
              class={`flex items-center justify-between px-3 py-1.5 rounded-sm text-xs font-sans transition-colors decoration-none ${
                isCurrent
                  ? "bg-primary text-on-primary font-semibold"
                  : "text-body hover:text-ink hover:bg-canvas-soft-2"
              }`}
              role="menuitem"
              hreflang={locale}
            >
              <div class="flex items-center gap-2">
                <span class="uppercase font-mono text-[10px] font-semibold px-1.5 py-0.5 rounded bg-canvas-soft dark:bg-canvas-soft-2 border border-hairline opacity-85">
                  {locale}
                </span>
                <span class="text-mute opacity-50 select-none">·</span>
                <span>{item.nativeName}</span>
              </div>
              {isCurrent && (
                <svg
                  class="w-3.5 h-3.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M5 13l4 4L19 7"
                  />
                </svg>
              )}
            </a>
          );
        })
      }
    </div>
  </div>
</div>

<script>
  function setupLanguagePickers() {
    const pickers = document.querySelectorAll(".language-picker-root");

    pickers.forEach((picker) => {
      const btn = picker.querySelector(".language-picker-btn");
      const menu = picker.querySelector(".language-picker-menu");
      const arrow = picker.querySelector(".arrow-icon");

      if (!btn || !menu) return;

      const toggleMenu = (open?: boolean) => {
        const isCurrentlyHidden = menu.classList.contains("hidden");
        const shouldOpen = open !== undefined ? open : isCurrentlyHidden;

        if (shouldOpen) {
          // Close all other language menus first
          document.querySelectorAll(".language-picker-menu").forEach((m) => {
            m.classList.add("hidden");
          });
          document.querySelectorAll(".arrow-icon").forEach((a) => {
            a.classList.remove("rotate-180");
          });

          menu.classList.remove("hidden");
          arrow?.classList.add("rotate-180");
          btn.setAttribute("aria-expanded", "true");
        } else {
          menu.classList.add("hidden");
          arrow?.classList.remove("rotate-180");
          btn.setAttribute("aria-expanded", "false");
        }
      };

      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        toggleMenu();
      });
    });

    // Close when clicking outside or pressing Escape
    document.addEventListener("click", () => {
      document.querySelectorAll(".language-picker-menu").forEach((menu) => {
        menu.classList.add("hidden");
      });
      document.querySelectorAll(".arrow-icon").forEach((arrow) => {
        arrow.classList.remove("rotate-180");
      });
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        document.querySelectorAll(".language-picker-menu").forEach((menu) => {
          menu.classList.add("hidden");
        });
        document.querySelectorAll(".arrow-icon").forEach((arrow) => {
          arrow.classList.remove("rotate-180");
        });
      }
    });
  }

  // Setup on page load and on Astro page transitions
  setupLanguagePickers();
  document.addEventListener("astro:page-load", setupLanguagePickers);
</script>
