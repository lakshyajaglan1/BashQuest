---

---

<div
  class="code-editor-mockup w-full h-full min-h-[360px] flex flex-col font-mono text-xs sm:text-[13px] text-white bg-[#0c0c0c] border border-white/10 rounded-md shadow-[0_24px_40px_rgba(0,0,0,0.15),_inset_0_1px_0_rgba(255,255,255,0.12)] select-text overflow-hidden p-3 sm:p-4"
>
  <!-- Terminal Title Bar -->
  <div
    class="flex items-center justify-between pb-2.5 mb-2 border-b border-white/10 select-none"
  >
    <div class="flex items-center gap-1.5 min-w-0">
      <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-[#ff5f56] shrink-0"></div>
      <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-[#ffbd2e] shrink-0"></div>
      <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-[#27c93f] shrink-0"></div>
      <span class="text-[11px] sm:text-xs text-gray-300 font-mono ml-2 truncate"
        ><span class="hidden sm:inline">learner@bashquest: </span><span id="term-title-path" class="text-gray-300"
          >~</span
        ></span
      >
    </div>
    <span
      class="text-[9px] sm:text-[10px] text-gray-400 uppercase font-bold tracking-wider mr-1 shrink-0"
      >Bash Shell</span
    >
  </div>

  <!-- Terminal Output Screen -->
  <div
    id="terminal-history"
    class="flex-1 overflow-y-auto space-y-1.5 pr-2 mb-2 text-xs sm:text-[13px] leading-relaxed"
  >
  </div>

  <!-- Mobile Quick Command Helper Bar -->
  <div
    class="flex items-center gap-1.5 py-1.5 overflow-x-auto [&::-webkit-scrollbar]:hidden border-t border-white/10 select-none text-[11px] font-mono shrink-0"
  >
    <span class="text-gray-500 text-[10px] uppercase font-bold shrink-0 mr-1 hidden xs:inline">Quick:</span>
    <button
      type="button"
      data-cmd="ls"
      class="quick-cmd-btn px-2 py-1 bg-white/10 hover:bg-white/20 active:bg-white/30 text-gray-200 rounded-sm shrink-0 transition-colors border border-white/10 cursor-pointer font-mono"
    >
      ls
    </button>
    <button
      type="button"
      data-cmd="pwd"
      class="quick-cmd-btn px-2 py-1 bg-white/10 hover:bg-white/20 active:bg-white/30 text-gray-200 rounded-sm shrink-0 transition-colors border border-white/10 cursor-pointer font-mono"
    >
      pwd
    </button>
    <button
      type="button"
      data-cmd="cd ~"
      class="quick-cmd-btn px-2 py-1 bg-white/10 hover:bg-white/20 active:bg-white/30 text-gray-200 rounded-sm shrink-0 transition-colors border border-white/10 cursor-pointer font-mono"
    >
      cd ~
    </button>
    <button
      type="button"
      data-cmd="cat "
      class="quick-cmd-btn px-2 py-1 bg-white/10 hover:bg-white/20 active:bg-white/30 text-gray-200 rounded-sm shrink-0 transition-colors border border-white/10 cursor-pointer font-mono"
    >
      cat
    </button>
    <button
      type="button"
      data-cmd="clear"
      class="quick-cmd-btn px-2 py-1 bg-white/10 hover:bg-white/20 active:bg-white/30 text-gray-200 rounded-sm shrink-0 transition-colors border border-white/10 cursor-pointer font-mono"
    >
      clear
    </button>
    <button
      type="button"
      data-cmd="TAB"
      class="quick-cmd-btn px-2 py-1 bg-violet-600/40 hover:bg-violet-600/60 active:bg-violet-600/80 text-violet-200 rounded-sm shrink-0 transition-colors border border-violet-400/30 cursor-pointer font-mono font-bold"
      title="Autocomplete path (Tab)"
    >
      ⇥ TAB
    </button>
  </div>

  <!-- Terminal Prompt Input Line -->
  <div
    class="flex items-center gap-1.5 pt-1.5 border-t border-white/5 select-none font-mono text-xs sm:text-[13px]"
  >
    <div id="term-prompt-prefix" class="flex items-center shrink-0">
      <span class="text-green-400 font-bold">learner@bashquest</span>
      <span class="text-gray-400">:</span>
      <span id="term-prompt-path" class="text-blue-400 font-semibold max-w-[80px] sm:max-w-none truncate">~</span>
      <span class="text-white font-bold">$</span>
    </div>

    <div class="relative flex-1 flex items-center min-w-0">
      <input
        id="terminal-input"
        type="text"
        class="w-full min-w-[80px] bg-transparent border-none outline-none text-white font-mono caret-white focus:ring-0 focus:outline-none p-0 m-0 z-10 text-base sm:text-xs md:text-[13px]"
        autofocus
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
      />
      <!-- Ghost text for autocomplete preview -->
      <span
        id="terminal-ghost"
        class="absolute left-0 top-0 text-mute opacity-50 pointer-events-none select-none font-mono text-base sm:text-xs md:text-[13px]"
      ></span>
    </div>
  </div>

  <!-- Terminal Status Bar -->
  <div
    class="flex items-center justify-between pt-1.5 mt-1 border-t border-white/10 text-[10px] font-mono text-gray-400 select-none"
  >
    <span>User: learner</span>
    <span class="text-white/20 select-none">|</span>
    <span id="term-status-path">/home/learner</span>
  </div>
</div>

<script>
  // DOM selectors
  const termHistory = document.getElementById("terminal-history");
  const termInput = document.getElementById(
    "terminal-input",
  ) as HTMLInputElement;
  const termGhost = document.getElementById("terminal-ghost");
  const termTitlePath = document.getElementById("term-title-path");
  const termPromptPath = document.getElementById("term-prompt-path");
  const termStatusPath = document.getElementById("term-status-path");
  const termPromptPrefix = document.getElementById("term-prompt-prefix");

  let historyIdx = -1;
  let tempCommand = "";

  let bootSequenceStarted = false;

  function typeHtml(
    element: HTMLElement,
    htmlText: string,
    speed: number,
    onComplete?: () => void,
  ) {
    let i = 0;
    function step() {
      if (i < htmlText.length) {
        if (htmlText[i] === "<") {
          const tagEnd = htmlText.indexOf(">", i);
          if (tagEnd !== -1) {
            element.innerHTML = htmlText.substring(0, tagEnd + 1);
            i = tagEnd + 1;
          } else {
            element.innerHTML = htmlText.substring(0, i + 1);
            i++;
          }
        } else if (htmlText[i] === "&") {
          const entityEnd = htmlText.indexOf(";", i);
          if (entityEnd !== -1 && entityEnd - i < 8) {
            element.innerHTML = htmlText.substring(0, entityEnd + 1);
            i = entityEnd + 1;
          } else {
            element.innerHTML = htmlText.substring(0, i + 1);
            i++;
          }
        } else {
          element.innerHTML = htmlText.substring(0, i + 1);
          i++;
        }
        if (termHistory) {
          termHistory.scrollTop = termHistory.scrollHeight;
        }
        setTimeout(step, speed);
      } else if (onComplete) {
        onComplete();
      }
    }
    step();
  }

  function runBootSequence() {
    if (bootSequenceStarted || !termHistory) return;
    bootSequenceStarted = true;

    termHistory.innerHTML = "";
    const container = document.createElement("div");
    container.className = "text-[#888] font-mono leading-relaxed";
    termHistory.appendChild(container);

    const fullHtmlText = `Welcome to BashQuest Terminal v1.0.0<br>Type <span class="text-success font-semibold">help</span> to list available commands. Redirection (&gt;, &gt;&gt;, 2&gt;, &amp;&gt;) and pipes (|) are supported.<br>Type your command and press Enter. Tab key autocompletes file paths.`;

    typeHtml(container, fullHtmlText, 12);
  }

  // Focus input on clicking anywhere in terminal
  document
    .querySelector(".code-editor-mockup")
    ?.addEventListener("click", () => {
      const selection = window.getSelection();
      if (selection && selection.toString().length === 0) {
        termInput?.focus();
      }
    });

  // Shorten paths for shell prompt
  function getShortPath(path: string) {
    if (path === "/home/learner") return "~";
    if (path.startsWith("/home/learner")) {
      return "~" + path.substring(13);
    }
    return path;
  }

  // Render prompt changes
  function updatePrompt() {
    const globalWindow = window as any;
    if (!globalWindow.appState || !globalWindow.appState.session) return;
    const session = globalWindow.appState.session;
    const currentPath = session.currentPath;
    const shortPath = getShortPath(currentPath);

    if (termTitlePath) termTitlePath.textContent = shortPath;
    if (termStatusPath) termStatusPath.textContent = currentPath;

    if (session.vimState) {
      if (termPromptPrefix) {
        termPromptPrefix.innerHTML = `<span class="text-amber-400 font-bold">[VIM:${session.vimState.mode.toUpperCase()}]</span><span class="text-white font-bold">&gt;</span>`;
      }
    } else if (session.hereDocState) {
      if (termPromptPrefix) {
        termPromptPrefix.innerHTML = `<span class="text-gray-400 font-bold">&gt;</span>`;
      }
    } else {
      if (termPromptPrefix) {
        termPromptPrefix.innerHTML = `
          <span class="text-green-400 font-bold">learner@bashquest</span>
          <span class="text-gray-400">:</span>
          <span id="term-prompt-path" class="text-blue-400 font-semibold max-w-[80px] sm:max-w-none truncate">${shortPath}</span>
          <span class="text-white font-bold">$</span>
        `;
      }
    }
  }

  // Write a row to the terminal log
  function writeRow(
    htmlContent: string,
    isCommand: boolean = false,
    cmdString: string = "",
  ) {
    if (!termHistory) return;

    const row = document.createElement("div");
    row.className = "leading-relaxed font-mono";

    if (isCommand) {
      const globalWindow = window as any;
      const session = globalWindow.appState?.session;
      const currentPath =
        session?.currentPath || "/home/learner";
      const shortPath = getShortPath(currentPath);
      if (session?.hereDocState) {
        row.innerHTML = `
          <span class="text-gray-400 font-bold">&gt;</span> 
          <span class="text-white">${cmdString}</span>
        `;
      } else {
        row.innerHTML = `
          <span class="text-green-400 font-bold">learner@bashquest</span>:<span class="text-blue-400 font-semibold">${shortPath}</span><span class="text-white">$</span> 
          <span class="text-white">${cmdString}</span>
        `;
      }
    } else {
      row.innerHTML = htmlContent;
    }

    termHistory.appendChild(row);
    // Scroll to bottom
    termHistory.scrollTop = termHistory.scrollHeight;
  }

  // Execute a command
  function submitCommand(commandText: string) {
    const trimmed = commandText.trim();
    writeRow("", true, commandText); // echo command to screen

    if (termInput) termInput.value = "";
    if (termGhost) termGhost.textContent = "";

    if (!trimmed) return;

    const globalWindow = window as any;
    if (!globalWindow.appState || !globalWindow.appState.session) return;

    const session = globalWindow.appState.session;
    const result = session.execute(trimmed);

    // Save history index
    historyIdx = -1;
    tempCommand = "";

    if (result.clear) {
      if (termHistory) termHistory.innerHTML = "";
    } else {
      if (result.stdout) {
        // Escape HTML tags to prevent cross-site script rendering, but replace newlines
        const escaped = result.stdout
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/\n/g, "<br>");
        writeRow(`<div class="text-white">${escaped}</div>`);
      }
      if (result.stderr) {
        const escaped = result.stderr
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/\n/g, "<br>");
        writeRow(`<div class="text-error font-semibold">${escaped}</div>`);
      }
    }

    updatePrompt();

    // Directly record to terminalCommands
    if (globalWindow.appState) {
      if (!Array.isArray(globalWindow.appState.terminalCommands)) {
        globalWindow.appState.terminalCommands = [];
      }
      globalWindow.appState.terminalCommands.push(trimmed);
    }

    // Broadcast event that shell has changed states
    window.dispatchEvent(new CustomEvent("app:filesystem-update"));
    window.dispatchEvent(
      new CustomEvent("app:terminal-command", { detail: { command: trimmed } }),
    );
  }

  // Handle Tab Autocomplete
  function handleAutocomplete() {
    const globalWindow = window as any;
    if (!termInput || !globalWindow.appState || !globalWindow.appState.session)
      return;

    const value = termInput.value;
    const parts = value.split(/\s+/);

    // Autocomplete files and folders in current directory
    const lastWord = parts[parts.length - 1] || "";

    // We split directories and file prefix
    let targetDir = ".";
    let filePrefix = lastWord;

    if (lastWord.includes("/")) {
      const idx = lastWord.lastIndexOf("/");
      targetDir = lastWord.substring(0, idx) || "/";
      filePrefix = lastWord.substring(idx + 1);
    }

    const fs = globalWindow.appState.fs;
    const session = globalWindow.appState.session;
    const node = fs.getNodeByPath(session.currentPath, targetDir);

    if (node && node.type === "dir" && node.children) {
      const matches = node.children.filter((child: any) =>
        child.name.startsWith(filePrefix),
      );

      if (matches.length === 1) {
        // Complete the word
        const match = matches[0];
        const suffix = match.type === "dir" ? "/" : "";
        const completedWord = (
          (targetDir !== "." && targetDir !== "/"
            ? targetDir + "/"
            : targetDir === "/"
              ? "/"
              : "") +
          match.name +
          suffix
        ).replace(/\/{2,}/g, "/");

        parts[parts.length - 1] = completedWord;
        termInput.value = parts.join(" ");
      } else if (matches.length > 1) {
        // Multiple matches, output them to screen
        const matchNames = matches.map(
          (m: any) => m.name + (m.type === "dir" ? "/" : ""),
        );
        writeRow("", true, value);
        writeRow(
          `<div class="text-[#888] font-semibold">${matchNames.join("  ")}</div>`,
        );
      }
    }
  }

  // Key Event Listeners
  termInput?.addEventListener("keydown", (e: any) => {
    const globalWindow = window as any;
    if (!globalWindow.appState || !globalWindow.appState.session) return;
    const history = globalWindow.appState.session.history || [];

    if (e.key === "Escape") {
      if (globalWindow.appState.session?.vimState) {
        e.preventDefault();
        submitCommand("Esc");
        return;
      }
    }

    if (e.key === "Enter") {
      submitCommand(termInput.value);
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      if (history.length === 0) return;

      if (historyIdx === -1) {
        tempCommand = termInput.value;
        historyIdx = history.length - 1;
      } else if (historyIdx > 0) {
        historyIdx--;
      }

      termInput.value = history[historyIdx];
    } else if (e.key === "ArrowDown") {
      e.preventDefault();
      if (historyIdx === -1) return;

      if (historyIdx < history.length - 1) {
        historyIdx++;
        termInput.value = history[historyIdx];
      } else {
        historyIdx = -1;
        termInput.value = tempCommand;
      }
    } else if (e.key === "Tab") {
      e.preventDefault();
      handleAutocomplete();
    }
  });

  // Clear terminal screen history
  function clearTerminal() {
    if (!termHistory) return;
    termHistory.innerHTML = `
      <div class="text-[#888] font-mono leading-relaxed">
        Welcome to BashQuest Terminal v1.0.0<br>
        Type <span class="text-success font-semibold">help</span> to list available commands. Redirection (&gt;, &gt;&gt;) is supported.<br>
        Type your command and press Enter. Tab key autocompletes file paths.
      </div>
    `;
    historyIdx = -1;
    tempCommand = "";
  }

  // Listen for lesson-load event to update terminal paths
  window.addEventListener("app:state-updated", () => {
    updatePrompt();
    const globalWindow = window as any;
    if (
      globalWindow.appState &&
      globalWindow.appState.activeView === "sandbox"
    ) {
      runBootSequence();
    }
  });
  window.addEventListener("app:select-lesson", () => {
    updatePrompt();
    clearTerminal();
  });
  window.addEventListener("app:restore-lesson", () => {
    updatePrompt();
    clearTerminal();
  });

  // Quick command buttons on mobile
  document.querySelectorAll(".quick-cmd-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const cmd = (btn as HTMLElement).dataset.cmd;
      if (!cmd) return;

      if (cmd === "TAB") {
        handleAutocomplete();
        termInput?.focus();
      } else if (cmd === "clear") {
        submitCommand("clear");
      } else if (cmd.endsWith(" ")) {
        if (termInput) {
          termInput.value = cmd;
          termInput.focus();
        }
      } else {
        submitCommand(cmd);
      }
    });
  });

  // Listen for custom prints to terminal (e.g. from Nano editor saving)
  window.addEventListener("app:print-terminal", (e: any) => {
    if (e.detail && e.detail.text) {
      writeRow(`<div class="text-white">${e.detail.text}</div>`);
    }
  });
</script>
