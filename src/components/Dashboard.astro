---
import { getLocalizedModules, getLocalizedLessons, getLevelName, getLocalizedBadge } from "../i18n/lessons/index";
import { type SupportedLanguage } from "../i18n/languages";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";
import { getQuestSlug } from "../lib/questSlug";

interface Props {
  lang?: SupportedLanguage;
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);
const localizedModules = getLocalizedModules(currentLang);
const localizedLessons = getLocalizedLessons(currentLang);

const verifyQueryToken = Astro.url.searchParams.get("verify") || "";
let initialVerifiedCredential: any = null;
if (verifyQueryToken && !verifyQueryToken.startsWith("BQ-PREVIEW-")) {
  try {
    const cleanToken = verifyQueryToken.startsWith("BQ-") ? verifyQueryToken.slice(3) : verifyQueryToken;
    const decodedStr = decodeURIComponent(escape(atob(cleanToken)));
    const parsed = JSON.parse(decodedStr);
    if (parsed && parsed.name && (parsed.bossCount >= 17 || parsed.count >= 150 || parsed.verified)) {
      initialVerifiedCredential = { ...parsed, token: verifyQueryToken, verified: true };
    }
  } catch (e) {
    // Invalid token format
  }
}
---

<div
  class="bg-canvas-soft mesh-gradient min-h-[calc(100vh-64px)] w-full py-6 sm:py-12 px-3 sm:px-4 md:px-8 select-none pb-24 md:pb-12"
>
  <!-- Verifiable Credential Banner (shown when ?verify=<token> is present) -->
  <div
    id="credential-verification-banner"
    class={`${initialVerifiedCredential ? "flex" : "hidden"} mb-6 card-marketing border-2 border-emerald-500/40 bg-emerald-500/5 p-4 sm:p-6 rounded-lg shadow-level-3 flex-col sm:flex-row items-start sm:items-center justify-between gap-4 animate-in fade-in duration-300`}
  >
    <div class="flex items-start sm:items-center gap-3">
      <div class="w-10 h-10 rounded-full bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-lg shrink-0 border border-emerald-500/30">
        ✓
      </div>
      <div class="space-y-1">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase tracking-wider bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30">
            Verified Credential Badge
          </span>
          <span class="text-[11px] font-mono text-mute">Official BashQuest Accreditation</span>
        </div>
        <h3 class="text-base sm:text-lg font-bold text-ink">
          BashQuest Linux & Shell Mastery Certificate
        </h3>
        <p class="text-xs sm:text-sm text-body leading-relaxed">
          Officially verified credential issued to <strong class="text-ink font-semibold" id="verify-learner-name">{initialVerifiedCredential?.name || ""}</strong> on <strong class="text-ink font-semibold" id="verify-date">{initialVerifiedCredential?.date || ""}</strong> for mastering <strong class="text-ink font-semibold" id="verify-count">{initialVerifiedCredential?.count ?? 150}</strong> Quests with <strong class="text-ink font-semibold" id="verify-xp">{initialVerifiedCredential?.xp ?? 0}</strong> XP.
        </p>
      </div>
    </div>
    <div class="flex sm:flex-col items-center sm:items-end gap-2 w-full sm:w-auto shrink-0 pt-2 sm:pt-0 border-t sm:border-t-0 border-hairline">
      <span class="font-mono text-[10px] text-mute truncate max-w-[200px]" title={verifyQueryToken}>
        Token: <code class="text-ink font-bold" id="verify-token-code">{verifyQueryToken}</code>
      </span>
      <div class="flex items-center gap-2">
        <button
          id="btn-verify-view-cert"
          type="button"
          class="h-8 px-3 rounded bg-primary text-on-primary font-sans text-xs font-semibold hover:opacity-90 transition-all cursor-pointer shadow-sm"
        >
          View Certificate ↗
        </button>
        <button
          id="btn-dismiss-verify-banner"
          type="button"
          class="h-8 px-2.5 rounded border border-hairline bg-canvas text-mute hover:text-ink font-sans text-xs font-semibold cursor-pointer"
          title="Dismiss Banner"
        >
          ✕
        </button>
      </div>
    </div>
  </div>

  <div class="w-full grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8">
    <!-- User Profile, Stats & Quick Links (Left Column) -->
    <div class="lg:col-span-1 space-y-6">
      <!-- Profile Card -->
      <div
        class="card-marketing border border-hairline bg-canvas p-5 sm:p-6 flex flex-col justify-between h-auto shadow-level-3"
      >
        <div>
          <div class="flex items-center gap-4 mb-6">
            <div
              class="w-14 h-14 rounded-full bg-primary text-on-primary flex items-center justify-center font-mono text-2xl font-bold border border-hairline shadow-level-2 relative group/avatar overflow-hidden shrink-0"
            >
              <span
                class="relative z-10 transition-transform duration-300 group-hover/avatar:scale-110 block"
                >L</span
              >
            </div>
            <div>
              <h2
                id="profile-title"
                class="text-lg sm:text-xl font-sans font-extrabold text-ink tracking-tight"
              >
                {getLevelName(1, currentLang)}.
              </h2>
              <p
                id="profile-level"
                class="text-[11px] text-mute font-mono uppercase tracking-wider font-semibold mt-0.5"
              >
                {t("dashboard.levelUser").replace("{level}", "1")}
              </p>
            </div>
          </div>

          <!-- XP Bar -->
          <div class="space-y-2 mb-6">
            <div class="flex justify-between text-xs font-mono">
              <span class="text-mute">{t("dashboard.xpProgress")}</span>
              <span id="profile-xp-ratio" class="text-ink font-bold"
                >0 / 300</span
              >
            </div>
            <div
              class="w-full h-2.5 bg-canvas-soft-2 rounded-full overflow-hidden border border-hairline shadow-inner"
            >
              <div
                id="profile-xp-progress"
                class="h-full xp-bar-fill transition-all duration-1000 ease-out"
                style="width: 0%"
              >
              </div>
            </div>
          </div>

          <!-- Stats Grid -->
          <div
            class="grid grid-cols-2 gap-4 py-4 border-t border-b border-hairline mb-6 font-mono text-xs"
          >
            <div>
              <span class="text-mute block">{t("dashboard.completed")}</span>
              <span
                id="profile-completed-count"
                class="text-base font-bold text-ink">0 / {localizedLessons.length}</span
              >
            </div>
            <div>
              <span class="text-mute block">{t("dashboard.unlockedBadges")}</span>
              <span
                id="profile-badge-count"
                class="text-base font-bold text-ink">0</span
              >
            </div>
          </div>
        </div>

        <div>
          <p class="text-[10px] text-mute font-mono mb-3 leading-relaxed">
            {t("dashboard.noSignup")}
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
            <button
              id="btn-export-save"
              class="h-9 px-2 rounded-sm bg-canvas-soft-2 text-ink hover:bg-white dark:hover:bg-[#1a1a1a] border border-hairline text-xs font-semibold transition-all cursor-pointer shadow-sm hover:shadow-xs flex items-center justify-center text-center"
            >
              {t("dashboard.exportSave")}
            </button>
            <button
              id="btn-import-save"
              class="h-9 px-2 rounded-sm bg-canvas-soft-2 text-ink hover:bg-white dark:hover:bg-[#1a1a1a] border border-hairline text-xs font-semibold transition-all cursor-pointer shadow-sm hover:shadow-xs flex items-center justify-center text-center"
            >
              {t("dashboard.importSave")}
            </button>
            <button
              id="btn-reset-progress"
              class="h-9 px-2 rounded-sm border border-red-200 text-error bg-red-50 text-xs font-semibold hover:bg-error-soft hover:text-error-deep hover:border-red-300 dark:bg-red-950/10 dark:border-red-900/30 dark:text-red-400 flex items-center justify-center text-center cursor-pointer"
            >
              {t("dashboard.reset")}
            </button>
          </div>
        </div>
      </div>

      <!-- Linux Certificate Accreditation Card -->
      <div class="card-marketing border border-hairline bg-canvas p-5 sm:p-6 shadow-level-3 space-y-3">
        <div class="flex items-center justify-between">
          <h3 class="text-xs font-bold tracking-widest text-mute uppercase font-mono border-l-2 border-primary pl-2">
            Accreditation
          </h3>
          <span
            id="cert-status-badge"
            class="text-[10px] font-mono px-2 py-0.5 rounded bg-canvas-soft-2 text-mute border border-hairline font-bold"
          >
            In Progress
          </span>
        </div>
        <p class="text-xs text-body leading-relaxed">
          Verifiable HTML5 completion credential with deterministic cryptographic token & LinkedIn sharing.
        </p>
        <button
          id="btn-claim-certificate"
          type="button"
          class="w-full h-10 px-3 rounded-sm bg-primary text-on-primary text-xs font-semibold hover:opacity-90 active:scale-[0.99] transition-all cursor-pointer flex items-center justify-between shadow-sm group"
        >
          <span class="flex items-center gap-2">
            <span class="text-base group-hover:scale-110 transition-transform">🎓</span>
            <span>Claim Linux Certificate</span>
          </span>
          <span
            id="cert-progress-badge"
            class="font-mono text-[10px] px-2 py-0.5 rounded bg-on-primary/20 text-on-primary font-bold tabular-nums"
          >
            0 / 17 Bosses
          </span>
        </button>
        <div class="flex items-center justify-between text-[11px] font-mono text-mute pt-1">
          <span id="cert-progress-count" class="tabular-nums">0 / 17 Boss Challenges completed</span>
          <button
            id="btn-preview-certificate"
            type="button"
            class="text-link hover:underline cursor-pointer bg-transparent border-none p-0 text-[11px] font-mono font-medium"
            title="Preview and test your certificate credential"
          >
            Preview ↗
          </button>
        </div>
      </div>

      <!-- Badges Card -->
      <div class="card-marketing bg-canvas p-6 shadow-level-3">
        <h3
          class="text-xs font-bold tracking-widest text-mute uppercase font-mono mb-4 border-l-2 border-primary pl-2"
        >
          {t("dashboard.earnedBadges")}
        </h3>
        <div id="dashboard-badges-rack" class="flex flex-wrap gap-2">
          <!-- Dynamically filled with badges -->
        </div>
      </div>

      <!-- Quick Navigation & Legal Links -->
      <div class="card-marketing bg-canvas p-6 shadow-level-3 space-y-4">
        <h3
          class="text-xs font-bold tracking-widest text-mute uppercase font-mono border-l-2 border-primary pl-2"
        >
          {t("dashboard.helpLegal")}
        </h3>
        <div class="grid grid-cols-1 gap-3 font-sans text-xs">
          <a
            href={translatePath("/about")}
            class="text-body hover:text-ink transition-colors flex items-center gap-2.5 decoration-none"
          >
            <span class="text-sm">📖</span> {t("footer.about")}
          </a>
          <a
            href={translatePath("/faq")}
            class="text-body hover:text-ink transition-colors flex items-center gap-2.5 decoration-none"
          >
            <span class="text-sm">❓</span> {t("footer.faq")}
          </a>
          <a
            href={translatePath("/privacy")}
            class="text-body hover:text-ink transition-colors flex items-center gap-2.5 decoration-none"
          >
            <span class="text-sm">🛡️</span> {t("footer.privacy")}
          </a>
          <a
            href={translatePath("/terms")}
            class="text-body hover:text-ink transition-colors flex items-center gap-2.5 decoration-none"
          >
            <span class="text-sm">⚖️</span> {t("footer.terms")}
          </a>
          <a
            href={translatePath("/contact")}
            class="text-body hover:text-ink transition-colors flex items-center gap-2.5 decoration-none"
          >
            <span class="text-sm">✉️</span> {t("footer.contact")}
          </a>
        </div>
      </div>
    </div>

    <!-- Curriculum Skill Tree (Right Column) -->
    <div class="lg:col-span-2 space-y-8">
      <!-- Intro Banner -->
      <div
        class="mesh-gradient bg-primary text-on-primary p-5 md:p-6 flex flex-col gap-4 relative overflow-hidden shadow-level-4 rounded-md"
      >
        <div
          class="absolute -right-16 -top-16 w-48 h-48 rounded-full bg-gradient-to-br from-violet/25 via-link/15 to-transparent blur-3xl pointer-events-none"
        >
        </div>

        <div class="relative z-10">
          <h1
            class="text-base md:text-lg font-bold text-on-primary tracking-tight font-sans"
          >
            {t("dashboard.heroOnlinePractice")}
          </h1>
          <p
            class="text-xs md:text-sm text-on-primary/70 mt-1.5 leading-relaxed max-w-xl"
          >
            {t("dashboard.heroPracticeDesc")}
          </p>
        </div>

        <div class="flex flex-wrap gap-2.5 relative z-10">
          <span
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-on-primary/10 bg-on-primary/5 text-[10px] md:text-xs font-mono font-medium text-on-primary/80 hover:bg-on-primary/10 transition-colors"
          >
            <svg
              class="w-3.5 h-3.5 text-violet shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path>
            </svg>
            {t("dashboard.heroOnlineBadge") || "Online Linux Terminal"}
          </span>

          <span
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-on-primary/10 bg-on-primary/5 text-[10px] md:text-xs font-mono font-medium text-on-primary/80 hover:bg-on-primary/10 transition-colors"
          >
            <svg
              class="w-3.5 h-3.5 text-success shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"
              ></path>
            </svg>
            {t("dashboard.badgeQuests")}
          </span>

          <span
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-on-primary/10 bg-on-primary/5 text-[10px] md:text-xs font-mono font-medium text-on-primary/80 hover:bg-on-primary/10 transition-colors"
          >
            <svg
              class="w-3.5 h-3.5 text-cyan shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              ></path>
            </svg>
            {t("dashboard.badgeFreePractice")}
          </span>

          <span
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-on-primary/10 bg-on-primary/5 text-[10px] md:text-xs font-mono font-medium text-on-primary/80 hover:bg-on-primary/10 transition-colors"
          >
            <svg
              class="w-3.5 h-3.5 text-warning shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"
              ></path>
            </svg>
            {t("dashboard.badgeInteractive")}
          </span>
        </div>
      </div>

      <div class="mb-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <h2 class="display-lg text-ink font-bold tracking-tight">
              {t("dashboard.pathTitle")}
            </h2>
            <p class="body-md text-body mt-2">
              {t("dashboard.pathDesc")}
            </p>
          </div>
          <!-- Boss Rush Mode Toggle -->
          <div class="flex items-center gap-2 shrink-0">
            <button
              id="btn-boss-rush-toggle"
              type="button"
              class="h-9 px-4 rounded-full border border-hairline bg-canvas text-ink text-xs font-semibold hover:bg-canvas-soft-2 transition-all cursor-pointer flex items-center gap-2 shadow-xs group select-none"
              title="Toggle Boss Rush Mode (17 Scenarios)"
            >
              <span class="text-sm group-hover:scale-110 transition-transform">⚔️</span>
              <span>Boss Rush (17 Scenarios)</span>
              <span id="boss-rush-status-dot" class="w-2 h-2 rounded-full bg-mute transition-colors"></span>
            </button>
          </div>
        </div>
      </div>

      <!-- Boss Rush Banner when Active -->
      <div
        id="boss-rush-banner"
        class="hidden mb-4 p-3.5 rounded-md bg-amber-500/10 border border-amber-500/30 text-amber-700 dark:text-amber-300 text-xs font-mono flex items-center justify-between gap-3 animate-in fade-in duration-200"
      >
        <div class="flex items-center gap-2 min-w-0">
          <span class="text-base shrink-0">⚔️</span>
          <span class="truncate font-sans font-semibold">Boss Rush Mode Active: All 17 Boss Challenges unlocked!</span>
        </div>
        <div class="flex items-center gap-3 shrink-0">
          <span id="dashboard-boss-rush-timer" class="font-bold tabular-nums">⏱️ 00:00</span>
          <span id="dashboard-fastest-time" class="hidden text-amber-600 dark:text-amber-400 font-bold">⚡ Best: 00:00</span>
        </div>
      </div>

      {
        localizedModules.map((mod) => {
          const moduleLessons = localizedLessons.filter((l: any) => l.moduleId === mod.id);
          return (
            <div class="space-y-4 module-container" data-module-id={mod.id}>
              <h2 class="text-xs font-mono font-bold tracking-widest text-mute uppercase px-1 border-l-2 border-primary module-title">
                {mod.title}
              </h2>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {moduleLessons.map((lesson: any, lIndex: number) => {
                  const isBoss = lIndex === moduleLessons.length - 1;
                  const isBossChallenge = lesson.title.includes("Boss Challenge");
                  const questNumber = localizedLessons.findIndex((l: any) => l.id === lesson.id) + 1;
                  const slug = getQuestSlug(lesson, questNumber - 1);
                  const questUrl = translatePath(`/quests/${slug}`);
                  return (
                    <div
                      data-lesson-id={lesson.id}
                      data-is-boss={isBoss || isBossChallenge ? "true" : "false"}
                      data-is-boss-challenge={isBossChallenge ? "true" : "false"}
                      data-terminal-url={translatePath("/terminal")}
                      class="lesson-node-card cursor-pointer border border-hairline rounded-md p-5 bg-canvas flex flex-col justify-between hover:shadow-md transition-all duration-200 relative group opacity-60 pointer-events-none"
                    >
                      <div class="flex justify-between items-start mb-2">
                        <span class={`font-mono text-xs font-bold px-2 py-0.5 rounded border ${isBoss || isBossChallenge ? "text-amber-600 dark:text-amber-400 bg-amber-500/10 border-amber-500/20 font-bold" : "text-mute bg-canvas-soft-2 border-hairline"}`}>
                          {isBoss || isBossChallenge ? "👑 Boss · " : ""}{t("dashboard.quest")}{" "}
                          {questNumber}
                        </span>
                        <span class="node-status-badge text-[10px] font-mono font-bold text-mute bg-canvas-soft border border-hairline px-2 py-0.5 rounded">
                          {t("dashboard.locked")}
                        </span>
                      </div>

                      <div>
                        <h3 class="font-sans text-base font-bold text-ink group-hover:text-link transition-colors">
                          {lesson.title}
                        </h3>
                        <p class="text-xs text-body line-clamp-2 mt-1">
                          {lesson.description}
                        </p>
                      </div>

                      <div class="flex justify-between items-center mt-4 pt-4 border-t border-hairline/50">
                        <div class="flex items-center gap-2.5">
                          <span class="text-xs font-mono text-success font-semibold shrink-0">
                            +{lesson.xp} XP
                          </span>
                          <a
                            href={questUrl}
                            class="text-[11px] font-mono text-mute hover:text-link transition-colors underline decoration-dotted decoration-hairline-strong underline-offset-2 z-10"
                            title={`View details for Quest ${questNumber}`}
                            onclick="event.stopPropagation();"
                          >
                            Details ↗
                          </a>
                        </div>
                        <span class="start-text text-xs text-mute font-medium flex items-center gap-1 group-hover:text-ink transition-colors">
                          {t("dashboard.start")} <span class="font-mono">→</span>
                        </span>
                      </div>

                      <div class="absolute inset-0 bg-canvas-soft/30 backdrop-blur-[0.5px] rounded-md pointer-events-none hidden node-lock-overlay" />
                    </div>
                  );
                })}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</div>

<!-- Custom Confirmation Modal for Resetting Progress -->
<div
  id="modal-reset-confirm"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs hidden select-none"
>
  <div
    class="w-full max-w-md bg-canvas rounded-lg border border-hairline shadow-2xl p-6 relative animate-in fade-in zoom-in-95 duration-200"
  >
    <button
      id="btn-close-reset-modal"
      class="absolute top-4 right-4 text-mute hover:text-ink cursor-pointer bg-transparent border-none"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div class="flex items-start gap-4 mb-6">
      <div
        class="flex items-center justify-center w-10 h-10 rounded-full bg-error-soft text-error shrink-0 border border-red-200 dark:bg-red-950/20 dark:border-red-900/30"
      >
        <svg
          class="w-5 h-5 text-error-deep dark:text-red-400"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
          ></path>
        </svg>
      </div>
      <div>
