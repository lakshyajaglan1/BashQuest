---
import { getLocalizedModules, getLocalizedLessons, getLevelName, getLocalizedBadge } from "../i18n/lessons/index";
import { type SupportedLanguage } from "../i18n/languages";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";
import { getQuestSlug } from "../lib/questSlug";
import { lessons as baseLessons } from "../lib/lessons.js";

interface Props {
  lang?: SupportedLanguage;
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const translatePath = useTranslatedPath(currentLang);
const localizedModules = getLocalizedModules(currentLang);
const localizedLessons = getLocalizedLessons(currentLang);

---

<div
  class="bg-canvas-soft mesh-gradient min-h-[calc(100vh-64px)] w-full py-6 sm:py-12 px-3 sm:px-4 md:px-8 select-none pb-24 md:pb-12"
>
  <div class="w-full grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8">
    <!-- User Profile, Stats & Quick Links (Left Column) -->
    <div class="lg:col-span-1 space-y-6">
      <!-- Profile Card -->
      <div
        class="card-marketing border border-hairline bg-canvas p-5 sm:p-6 flex flex-col justify-between h-auto shadow-level-3"
      >
        <div>
          <div class="flex items-center gap-4 mb-6">
            <div
              class="w-14 h-14 rounded-full bg-primary text-on-primary flex items-center justify-center font-mono text-2xl font-bold border border-hairline shadow-level-2 relative group/avatar overflow-hidden shrink-0"
            >
              <span
                class="relative z-10 transition-transform duration-300 group-hover/avatar:scale-110 block"
                >L</span
              >
            </div>
            <div>
              <h2
                id="profile-title"
                class="text-lg sm:text-xl font-sans font-extrabold text-ink tracking-tight"
              >
                {getLevelName(1, currentLang)}.
              </h2>
              <p
                id="profile-level"
                class="text-[11px] text-mute font-mono uppercase tracking-wider font-semibold mt-0.5"
              >
                {t("dashboard.levelUser").replace("{level}", "1")}
              </p>
            </div>
          </div>

          <!-- XP Bar -->
          <div class="space-y-2 mb-6">
            <div class="flex justify-between text-xs font-mono">
              <span class="text-mute">{t("dashboard.xpProgress")}</span>
              <span id="profile-xp-ratio" class="text-ink font-bold"
                >0 / 300</span
              >
            </div>
            <div
              class="w-full h-2.5 bg-canvas-soft-2 rounded-full overflow-hidden border border-hairline shadow-inner"
            >
              <div
                id="profile-xp-progress"
                class="h-full xp-bar-fill transition-all duration-1000 ease-out"
                style="width: 0%"
              >
              </div>
            </div>
          </div>

          <!-- Stats Grid -->
          <div
            class="grid grid-cols-2 gap-4 py-4 border-t border-b border-hairline mb-6 font-mono text-xs"
          >
            <div>
              <span class="text-mute block">{t("dashboard.completed")}</span>
              <span
                id="profile-completed-count"
                class="text-base font-bold text-ink">0 / {localizedLessons.length}</span
              >
            </div>
            <div>
              <span class="text-mute block">{t("dashboard.unlockedBadges")}</span>
              <span
                id="profile-badge-count"
                class="text-base font-bold text-ink">0</span
              >
            </div>
          </div>
        </div>

        <div>
          <p class="text-[10px] text-mute font-mono mb-3 leading-relaxed">
            {t("dashboard.noSignup")}
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
            <button
              id="btn-export-save"
              class="h-9 px-2 rounded-sm bg-canvas-soft-2 text-ink hover:bg-white dark:hover:bg-[#1a1a1a] border border-hairline text-xs font-semibold transition-all cursor-pointer shadow-sm hover:shadow-xs flex items-center justify-center text-center"
            >
              {t("dashboard.exportSave")}
            </button>
            <button
              id="btn-import-save"
              class="h-9 px-2 rounded-sm bg-canvas-soft-2 text-ink hover:bg-white dark:hover:bg-[#1a1a1a] border border-hairline text-xs font-semibold transition-all cursor-pointer shadow-sm hover:shadow-xs flex items-center justify-center text-center"
            >
              {t("dashboard.importSave")}
            </button>
            <button
              id="btn-reset-progress"
              class="h-9 px-2 rounded-sm border border-red-200 text-error bg-red-50 text-xs font-semibold hover:bg-error-soft hover:text-error-deep hover:border-red-300 dark:bg-red-950/10 dark:border-red-900/30 dark:text-red-400 flex items-center justify-center text-center cursor-pointer"
            >
              {t("dashboard.reset")}
            </button>
          </div>
        </div>
      </div>

      <aside class="learning-bridge" lang="en">
        <p class="learning-eyebrow">Learn beyond the command</p>
        <h2>Your Linux handbook.</h2>
        <p>17 concept chapters, knowledge checks, a searchable quest reference, and real-system labs.</p>
        <a href="/learn/">Open the learning library →</a>
      </aside>

      <!-- Badges Card -->
      <div class="card-marketing bg-canvas p-6 shadow-level-3">
        <h3
          class="text-xs font-bold tracking-widest text-mute uppercase font-mono mb-4 border-l-2 border-primary pl-2"
        >
          {t("dashboard.earnedBadges")}
        </h3>
        <div id="dashboard-badges-rack" class="flex flex-wrap gap-2">
          <!-- Dynamically filled with badges -->
        </div>
      </div>

      <!-- Quick Navigation & Legal Links -->
      <div class="card-marketing bg-canvas p-6 shadow-level-3 space-y-4">
        <h3
          class="text-xs font-bold tracking-widest text-mute uppercase font-mono border-l-2 border-primary pl-2"
        >
          {t("dashboard.helpLegal")}
        </h3>
        <div class="grid grid-cols-1 gap-3 font-sans text-xs">
          <a
            href={translatePath("/about")}
            class="text-body hover:text-ink transition-colors flex items-center gap-2.5 decoration-none"
          >
            <span class="text-sm">📖</span> {t("footer.about")}
          </a>
          <a
            href={translatePath("/faq")}
            class="text-body hover:text-ink transition-colors flex items-center gap-2.5 decoration-none"
          >
            <span class="text-sm">❓</span> {t("footer.faq")}
          </a>
          <a
            href={translatePath("/privacy")}
            class="text-body hover:text-ink transition-colors flex items-center gap-2.5 decoration-none"
          >
            <span class="text-sm">🛡️</span> {t("footer.privacy")}
          </a>
          <a
            href={translatePath("/terms")}
            class="text-body hover:text-ink transition-colors flex items-center gap-2.5 decoration-none"
          >
            <span class="text-sm">⚖️</span> {t("footer.terms")}
          </a>
          <a
            href={translatePath("/contact")}
            class="text-body hover:text-ink transition-colors flex items-center gap-2.5 decoration-none"
          >
            <span class="text-sm">✉️</span> {t("footer.contact")}
          </a>
        </div>
      </div>
    </div>

    <!-- Curriculum Skill Tree (Right Column) -->
    <div class="lg:col-span-2 space-y-8">
      <!-- Intro Banner -->
      <div
        class="mesh-gradient bg-primary text-on-primary p-5 md:p-6 flex flex-col gap-4 relative overflow-hidden shadow-level-4 rounded-md"
      >
        <div
          class="absolute -right-16 -top-16 w-48 h-48 rounded-full bg-gradient-to-br from-violet/25 via-link/15 to-transparent blur-3xl pointer-events-none"
        >
        </div>

        <div class="relative z-10">
          <h1
            class="text-base md:text-lg font-bold text-on-primary tracking-tight font-sans"
          >
            {t("dashboard.heroOnlinePractice")}
          </h1>
          <p
            class="text-xs md:text-sm text-on-primary/70 mt-1.5 leading-relaxed max-w-xl"
          >
            {t("dashboard.heroPracticeDesc")}
          </p>
        </div>

        <div class="flex flex-wrap gap-2.5 relative z-10">
          <span
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-on-primary/10 bg-on-primary/5 text-[10px] md:text-xs font-mono font-medium text-on-primary/80 hover:bg-on-primary/10 transition-colors"
          >
            <svg
              class="w-3.5 h-3.5 text-violet shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path>
            </svg>
            {t("dashboard.heroOnlineBadge") || "Online Linux Terminal"}
          </span>

          <span
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-on-primary/10 bg-on-primary/5 text-[10px] md:text-xs font-mono font-medium text-on-primary/80 hover:bg-on-primary/10 transition-colors"
          >
            <svg
              class="w-3.5 h-3.5 text-success shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"
              ></path>
            </svg>
            {t("dashboard.badgeQuests")}
          </span>

          <span
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-on-primary/10 bg-on-primary/5 text-[10px] md:text-xs font-mono font-medium text-on-primary/80 hover:bg-on-primary/10 transition-colors"
          >
            <svg
              class="w-3.5 h-3.5 text-cyan shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              ></path>
            </svg>
            {t("dashboard.badgeFreePractice")}
          </span>

          <span
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-on-primary/10 bg-on-primary/5 text-[10px] md:text-xs font-mono font-medium text-on-primary/80 hover:bg-on-primary/10 transition-colors"
          >
            <svg
              class="w-3.5 h-3.5 text-warning shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"
              ></path>
            </svg>
            {t("dashboard.badgeInteractive")}
          </span>
        </div>
      </div>

      <div class="mb-4">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <h2 class="display-lg text-ink font-bold tracking-tight">
              {t("dashboard.pathTitle")}
            </h2>
            <p class="body-md text-body mt-2">
              {t("dashboard.pathDesc")}
            </p>
          </div>
          <!-- Boss Rush Mode Toggle -->
          <div class="flex items-center gap-2 shrink-0">
            <button
              id="btn-boss-rush-toggle"
              type="button"
              class="h-9 px-4 rounded-full border border-hairline bg-canvas text-ink text-xs font-semibold hover:bg-canvas-soft-2 transition-all cursor-pointer flex items-center gap-2 shadow-xs group select-none"
              title="Toggle Boss Rush Mode (17 Scenarios)"
            >
              <span class="text-sm group-hover:scale-110 transition-transform">⚔️</span>
              <span>Boss Rush (17 Scenarios)</span>
              <span id="boss-rush-status-dot" class="w-2 h-2 rounded-full bg-mute transition-colors"></span>
            </button>
          </div>
        </div>
      </div>

      <!-- Boss Rush Banner when Active -->
      <div
        id="boss-rush-banner"
        class="hidden mb-4 p-3.5 rounded-md bg-amber-500/10 border border-amber-500/30 text-amber-700 dark:text-amber-300 text-xs font-mono flex items-center justify-between gap-3 animate-in fade-in duration-200"
      >
        <div class="flex items-center gap-2 min-w-0">
          <span class="text-base shrink-0">⚔️</span>
          <span class="truncate font-sans font-semibold">Boss Rush Mode Active: All 17 Boss Challenges unlocked!</span>
        </div>
        <div class="flex items-center gap-3 shrink-0">
          <span id="dashboard-boss-rush-timer" class="font-bold tabular-nums">⏱️ 00:00</span>
          <span id="dashboard-fastest-time" class="hidden text-amber-600 dark:text-amber-400 font-bold">⚡ Best: 00:00</span>
        </div>
      </div>

      {
        localizedModules.map((mod) => {
          const moduleLessons = localizedLessons.filter((l: any) => l.moduleId === mod.id);
          return (
            <div class="space-y-4 module-container" data-module-id={mod.id}>
              <h2 class="text-xs font-mono font-bold tracking-widest text-mute uppercase px-1 border-l-2 border-primary module-title">
                {mod.title}
              </h2>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {moduleLessons.map((lesson: any, lIndex: number) => {
                  const isBoss = lIndex === moduleLessons.length - 1;
                  const isBossChallenge = lesson.title.includes("Boss Challenge");
                  const questNumber = localizedLessons.findIndex((l: any) => l.id === lesson.id) + 1;
                  const slug = getQuestSlug(baseLessons[questNumber - 1], questNumber - 1);
                  const questUrl = translatePath(`/quests/${slug}`);
                  return (
                    <div
                      data-lesson-id={lesson.id}
                      data-is-boss={isBoss || isBossChallenge ? "true" : "false"}
                      data-is-boss-challenge={isBossChallenge ? "true" : "false"}
                      data-terminal-url={translatePath("/terminal")}
                      class="lesson-node-card cursor-pointer border border-hairline rounded-md p-5 bg-canvas flex flex-col justify-between hover:shadow-md transition-all duration-200 relative group opacity-60 pointer-events-none"
                    >
                      <div class="flex justify-between items-start mb-2">
                        <span class={`font-mono text-xs font-bold px-2 py-0.5 rounded border ${isBoss || isBossChallenge ? "text-amber-600 dark:text-amber-400 bg-amber-500/10 border-amber-500/20 font-bold" : "text-mute bg-canvas-soft-2 border-hairline"}`}>
                          {isBoss || isBossChallenge ? "👑 Boss · " : ""}{t("dashboard.quest")}{" "}
                          {questNumber}
                        </span>
                        <span class="node-status-badge text-[10px] font-mono font-bold text-mute bg-canvas-soft border border-hairline px-2 py-0.5 rounded">
                          {t("dashboard.locked")}
                        </span>
                      </div>

                      <div>
                        <h3 class="font-sans text-base font-bold text-ink group-hover:text-link transition-colors">
                          {lesson.title}
                        </h3>
                        <p class="text-xs text-body line-clamp-2 mt-1">
                          {lesson.description}
                        </p>
                      </div>

                      <div class="flex justify-between items-center mt-4 pt-4 border-t border-hairline/50">
                        <div class="flex items-center gap-2.5">
                          <span class="text-xs font-mono text-success font-semibold shrink-0">
                            +{lesson.xp} XP
                          </span>
                          <a
                            href={questUrl}
                            class="text-[11px] font-mono text-mute hover:text-link transition-colors underline decoration-dotted decoration-hairline-strong underline-offset-2 z-10"
                            title={`View details for Quest ${questNumber}`}
                            onclick="event.stopPropagation();"
                          >
                            Details ↗
                          </a>
                        </div>
                        <button type="button" disabled aria-label={`Start quest ${questNumber}: ${lesson.title}`} class="start-text text-xs text-mute font-medium flex items-center gap-1 group-hover:text-ink transition-colors">
                          {t("dashboard.start")} <span class="font-mono">→</span>
                        </button>
                      </div>

                      <div class="absolute inset-0 bg-canvas-soft/30 backdrop-blur-[0.5px] rounded-md pointer-events-none hidden node-lock-overlay" />
                    </div>
                  );
                })}
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</div>

<!-- Custom Confirmation Modal for Resetting Progress -->
<div
  id="modal-reset-confirm"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs hidden select-none"
>
  <div
    class="w-full max-w-md bg-canvas rounded-lg border border-hairline shadow-2xl p-6 relative animate-in fade-in zoom-in-95 duration-200"
  >
    <button
      id="btn-close-reset-modal"
      aria-label={t("dashboard.close")}
      class="absolute top-4 right-4 text-mute hover:text-ink cursor-pointer bg-transparent border-none"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div class="flex items-start gap-4 mb-6">
      <div
        class="flex items-center justify-center w-10 h-10 rounded-full bg-error-soft text-error shrink-0 border border-red-200 dark:bg-red-950/20 dark:border-red-900/30"
      >
        <svg
          class="w-5 h-5 text-error-deep dark:text-red-400"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
          ></path>
        </svg>
      </div>
      <div>
        <h3 class="text-base font-bold text-ink tracking-tight">
          {t("dashboard.resetTitle")}
        </h3>
        <p class="text-xs text-mute font-mono mt-1">
          {t("dashboard.resetWarning")}
        </p>
      </div>
    </div>

    <div class="flex justify-end gap-3">
      <button
        id="btn-cancel-reset"
        class="h-9 px-4 rounded-sm border border-hairline bg-canvas text-ink text-xs font-semibold hover:bg-canvas-soft-2 transition-all cursor-pointer"
      >
        {t("dashboard.cancel")}
      </button>
      <button
        id="btn-confirm-reset"
        class="h-9 px-4 rounded-sm bg-error text-on-primary text-xs font-semibold hover:bg-error-deep transition-all cursor-pointer border-none"
      >
        {t("dashboard.confirmReset")}
      </button>
    </div>
  </div>
</div>

<!-- Custom Modal for Exporting Progress -->
<div
  id="modal-export-save"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs hidden select-none"
>
  <div
    class="w-full max-w-md bg-canvas rounded-lg border border-hairline shadow-2xl p-6 relative animate-in fade-in zoom-in-95 duration-200"
  >
    <button
      id="btn-close-export-modal"
      aria-label={t("dashboard.close")}
      class="absolute top-4 right-4 text-mute hover:text-ink cursor-pointer bg-transparent border-none"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div class="flex items-start gap-4 mb-6">
      <div
        class="flex items-center justify-center w-10 h-10 rounded-full bg-canvas-soft-2 text-ink shrink-0 border border-hairline"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 21m0 0l-4.5-4.5M12 21V7.5"
          ></path>
        </svg>
      </div>
      <div>
        <h3 class="text-base font-bold text-ink tracking-tight">
          {t("dashboard.exportTitle")}
        </h3>
        <p class="text-xs text-mute font-mono mt-1">
          {t("dashboard.exportDesc")}
        </p>
      </div>
    </div>

    <div class="text-sm text-body leading-relaxed mb-4">
      <div
        class="w-full bg-[#171717] rounded-md p-3 border border-white/10 relative"
      >
        <textarea
          id="export-textarea"
          aria-label={t("dashboard.exportTitle")}
          readonly
          class="w-full h-28 bg-transparent text-white font-mono text-[11px] leading-relaxed resize-none outline-none focus:ring-0 focus:outline-none p-0 m-0 leading-relaxed overflow-y-auto"
          spellcheck="false"></textarea>
      </div>
    </div>

    <div class="flex justify-end gap-3">
      <button
        id="btn-close-export"
        class="h-9 px-4 rounded-sm border border-hairline bg-canvas text-ink text-xs font-semibold hover:bg-canvas-soft-2 transition-all cursor-pointer"
      >
        {t("dashboard.close")}
      </button>
      <button
        id="btn-copy-export"
        class="h-9 px-4 rounded-sm bg-primary text-on-primary text-xs font-semibold hover:opacity-90 transition-all cursor-pointer border-none flex items-center justify-center gap-1.5"
      >
        <svg
          class="w-4 h-4 shrink-0"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 4v5h.582m15.356 2A8.001 8.001 0 1121.21 8H18"></path>
        </svg>
        <span id="btn-copy-text">{t("dashboard.copyCode")}</span>
      </button>
    </div>
  </div>
</div>

<!-- Custom Modal for Importing Progress -->
<div
  id="modal-import-save"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs hidden select-none"
>
  <div
    class="w-full max-w-md bg-canvas rounded-lg border border-hairline shadow-2xl p-6 relative animate-in fade-in zoom-in-95 duration-200"
  >
    <button
      id="btn-close-import-modal"
      aria-label={t("dashboard.close")}
      class="absolute top-4 right-4 text-mute hover:text-ink cursor-pointer bg-transparent border-none"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div class="flex items-start gap-4 mb-6">
      <div
        class="flex items-center justify-center w-10 h-10 rounded-full bg-canvas-soft-2 text-ink shrink-0 border border-hairline"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 21m0 0l-4.5-4.5M12 21V7.5"
          ></path>
        </svg>
      </div>
      <div>
        <h3 class="text-base font-bold text-ink tracking-tight">
          {t("dashboard.importTitle")}
        </h3>
        <p class="text-xs text-mute font-mono mt-1">
          {t("dashboard.importDesc")}
        </p>
      </div>
    </div>

    <div class="text-sm text-body leading-relaxed mb-4">
      <div class="w-full bg-canvas rounded-md p-3 border border-hairline">
        <textarea
          id="import-textarea"
          aria-label={t("dashboard.importTitle")}
          aria-describedby="import-error"
          placeholder="Paste save code..."
          class="w-full h-28 bg-transparent text-ink font-mono text-[11px] leading-relaxed resize-none outline-none focus:ring-0 border-none p-0"
          spellcheck="false"></textarea>
      </div>
      <p role="alert" id="import-error" class="text-xs text-error font-mono mt-2 hidden">
        Invalid save code
      </p>
    </div>

    <div class="flex justify-end gap-3">
      <button
        id="btn-cancel-import"
        class="h-9 px-4 rounded-sm border border-hairline bg-canvas text-ink text-xs font-semibold hover:bg-canvas-soft-2 transition-all cursor-pointer"
      >
        {t("dashboard.cancel")}
      </button>
      <button
        id="btn-confirm-import"
        class="h-9 px-4 rounded-sm bg-primary text-on-primary text-xs font-semibold hover:opacity-90 transition-all cursor-pointer border-none"
      >
        {t("dashboard.restoreProgress")}
      </button>
    </div>
  </div>
</div>

<script>
  import { getLocalizedLessons, getLevelName, getLocalizedBadge } from "../i18n/lessons/index";
  import type { SupportedLanguage } from "../i18n/languages";

  const i18nLabels: Record<string, { passed: string; active: string; locked: string; start: string; review: string; noBadges: string; quest: string; levelUser: string }> = {
    en: { passed: "Passed", active: "Active", locked: "Locked", start: "Start", review: "Review", noBadges: "No badges unlocked yet.<br>Complete quests to collect!", quest: "Quest", levelUser: "Level {level} User" },
    es: { passed: "Completado", active: "Activo", locked: "Bloqueado", start: "Comenzar", review: "Revisar", noBadges: "No hay insignias desbloqueadas aún.<br>¡Completa misiones para coleccionar!", quest: "Misión", levelUser: "Usuario Nivel {level}" },
    fr: { passed: "Réussi", active: "Actif", locked: "Verrouillé", start: "Démarrer", review: "Revoir", noBadges: "Aucun badge débloqué pour le moment.<br>Complétez des quêtes pour en collecter !", quest: "Quête", levelUser: "Utilisateur Niveau {level}" },
    de: { passed: "Bestanden", active: "Aktiv", locked: "Gesperrt", start: "Starten", review: "Wiederholen", noBadges: "Noch keine Abzeichen freigeschaltet.<br>Schließen Sie Quests ab, um welche zu sammeln!", quest: "Quest", levelUser: "Level {level} Benutzer" },
    ja: { passed: "合格", active: "アクティブ", locked: "ロック中", start: "開始", review: "復習", noBadges: "まだバッジはありません。<br>クエストをクリアして集めましょう！", quest: "クエスト", levelUser: "レベル {level} ユーザー" },
    pt: { passed: "Concluído", active: "Ativo", locked: "Bloqueado", start: "Iniciar", review: "Revisar", noBadges: "Nenhum emblema desbloqueado ainda.<br>Complete missões para colecionar!", quest: "Missão", levelUser: "Usuário Nivel {level}" },
    ko: { passed: "통과", active: "진행중", locked: "잠김", start: "시작", review: "복습", noBadges: "아직 획득한 배지가 없습니다.<br>퀘스트를 완료하고 배지를 모아보세요!", quest: "퀘스트", levelUser: "레벨 {level} 유저" },
    it: { passed: "Completato", active: "Attivo", locked: "Bloccato", start: "Inizia", review: "Rivedi", noBadges: "Nessun distintivo ancora sbloccato.<br>Completa le missioni per collezionarli!", quest: "Missione", levelUser: "Utente Livello {level}" },
  };

  function getCurrentLang(): SupportedLanguage {
    const docLang = document.documentElement.lang as SupportedLanguage;
    if (docLang && i18nLabels[docLang]) return docLang;
    return "en";
  }

  function updateDashboardUI() {
    const globalWindow = window as any;
    if (!globalWindow.appState) return;

    const dashboardView = document.getElementById("view-dashboard");
    if (dashboardView && dashboardView.classList.contains("hidden")) {
      return;
    }

    const currentLang = getCurrentLang();
    const labels = i18nLabels[currentLang] || i18nLabels.en;
    const lessons = getLocalizedLessons(currentLang);

    const state = globalWindow.appState;
    const completed = state.completedLessons || [];

    let level = 1;
    let totalXpNeededForNext = 100;
    let accumulatedXp = 0;
    while (state.xp >= accumulatedXp + totalXpNeededForNext) {
      accumulatedXp += totalXpNeededForNext;
      level++;
      totalXpNeededForNext = level * 100;
    }
    const xpInLevel = state.xp - accumulatedXp;
    const xpPerLevel = totalXpNeededForNext;
    const displayedTitle = getLevelName(level, currentLang);

    const profileTitle = document.getElementById("profile-title");
    const profileLevel = document.getElementById("profile-level");
    const profileXpRatio = document.getElementById("profile-xp-ratio");
    const profileXpProgress = document.getElementById("profile-xp-progress");
    const profileCompletedCount = document.getElementById(
      "profile-completed-count",
    );
    const profileBadgeCount = document.getElementById("profile-badge-count");

    if (profileTitle) {
      profileTitle.textContent = /[.?!]$/.test(displayedTitle)
        ? displayedTitle
        : displayedTitle + ".";
    }
    if (profileLevel) profileLevel.textContent = labels.levelUser.replace("{level}", level.toString());
    if (profileXpRatio)
      profileXpRatio.textContent = `${xpInLevel} / ${xpPerLevel}`;
    if (profileXpProgress) {
      const percentage = (xpInLevel / xpPerLevel) * 100;
      if (profileXpProgress.style.width === "") {
        profileXpProgress.style.width = "0%";
      }
      setTimeout(() => {
        profileXpProgress.style.width = `${percentage}%`;
      }, 100);
    }
    if (profileCompletedCount) {
      profileCompletedCount.textContent = `${completed.length} / ${lessons.length}`;
    }

    const badgesRack = document.getElementById("dashboard-badges-rack");
    if (badgesRack) {
      const earnedBadges: any[] = [];
      lessons.forEach((l: any, idx: number) => {
        if (completed.includes(l.id) && l.badge) {
          earnedBadges.push({ badge: l.badge, title: l.title, questNumber: idx + 1 });
        }
      });

      if (profileBadgeCount)
        profileBadgeCount.textContent = earnedBadges.length.toString();

      if (earnedBadges.length === 0) {
        badgesRack.innerHTML = `
          <div class="w-full text-center py-5 border border-dashed border-hairline rounded-md text-mute text-[10px] font-mono bg-canvas-soft-2/50">
            ${labels.noBadges}
          </div>
        `;
      } else {
        badgesRack.innerHTML = earnedBadges
          .map((item, index) => {
            const colors = [
              {
                bg: "bg-violet-50 dark:bg-violet-950/30",
                text: "text-violet-700 dark:text-violet-300",
                border:
                  "border-violet-100 dark:border-violet-900/40 hover:bg-violet-100/50 dark:hover:bg-violet-900/30",
              },
              {
                bg: "bg-blue-50 dark:bg-blue-950/30",
                text: "text-blue-700 dark:text-blue-300",
                border:
                  "border-blue-100 dark:border-blue-900/40 hover:bg-blue-100/50 dark:hover:bg-blue-900/30",
              },
              {
                bg: "bg-emerald-50 dark:bg-emerald-950/30",
                text: "text-emerald-700 dark:text-emerald-300",
                border:
                  "border-emerald-100 dark:border-emerald-900/40 hover:bg-emerald-100/50 dark:hover:bg-emerald-900/30",
              },
            ];
            const color = colors[index % colors.length];

            let emoji = "🏆";
            const badgeLower = (item.badge || "").toLowerCase();
            if (badgeLower.includes("explorer") || badgeLower.includes("explorateur") || badgeLower.includes("explorador") || badgeLower.includes("erkunder") || badgeLower.includes("エクスプローラー") || badgeLower.includes("탐험가")) emoji = "🧭";
            else if (badgeLower.includes("navigator") || badgeLower.includes("navigateur") || badgeLower.includes("navegante") || badgeLower.includes("ナビゲーター") || badgeLower.includes("항해사")) emoji = "🗺️";
            else if (badgeLower.includes("builder") || badgeLower.includes("bâtisseur") || badgeLower.includes("constructor") || badgeLower.includes("erbauer")) emoji = "🛠️";
            else if (badgeLower.includes("architect") || badgeLower.includes("architecte") || badgeLower.includes("arquitecto") || badgeLower.includes("architekt")) emoji = "📐";
            else if (badgeLower.includes("cleaner") || badgeLower.includes("nettoyeur") || badgeLower.includes("limpiador")) emoji = "🗑️";
            else if (badgeLower.includes("plumber") || badgeLower.includes("plombier") || badgeLower.includes("fontanero")) emoji = "🔧";
            else if (badgeLower.includes("filterer") || badgeLower.includes("filtreur") || badgeLower.includes("filtrador")) emoji = "🔍";

            return `
            <div class="flex items-center gap-2 px-3 py-1.5 ${color.bg} ${color.border} border rounded-full transition-all duration-200 hover:-translate-y-0.5 hover:shadow-sm cursor-default select-none group/badge relative">
              <span class="text-sm shrink-0">${emoji}</span>
              <span class="text-[11px] font-mono font-bold ${color.text} truncate max-w-[100px]">${item.badge}</span>
              <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 opacity-0 scale-95 pointer-events-none group-hover/badge:opacity-100 group-hover/badge:scale-100 bg-primary text-on-primary text-[9px] font-mono py-1 px-2 rounded shadow-level-3 border border-hairline z-10 transition-all duration-200 whitespace-nowrap">
                ${labels.quest} ${item.questNumber}: ${item.title}
              </div>
            </div>
          `;
          })
          .join("");
      }
    }

    // Boss Rush mode handling
    const isBossRush = Boolean(state.bossRushMode);
    const bossRushToggleBtn = document.getElementById("btn-boss-rush-toggle");
    const bossRushStatusDot = document.getElementById("boss-rush-status-dot");
    const bossRushBanner = document.getElementById("boss-rush-banner");
    const dashboardFastestTime = document.getElementById("dashboard-fastest-time");

    if (bossRushToggleBtn && bossRushStatusDot) {
      if (isBossRush) {
        bossRushToggleBtn.classList.remove("bg-canvas", "text-ink", "border-hairline");
        bossRushToggleBtn.classList.add("bg-amber-500", "text-black", "border-amber-600", "font-bold", "shadow-sm");
        bossRushStatusDot.classList.remove("bg-mute");
        bossRushStatusDot.classList.add("bg-emerald-600", "animate-ping");
        bossRushBanner?.classList.remove("hidden");
        bossRushBanner?.classList.add("flex");
      } else {
        bossRushToggleBtn.classList.add("bg-canvas", "text-ink", "border-hairline");
        bossRushToggleBtn.classList.remove("bg-amber-500", "text-black", "border-amber-600", "font-bold", "shadow-sm");
        bossRushStatusDot.classList.add("bg-mute");
        bossRushStatusDot.classList.remove("bg-emerald-600", "animate-ping");
        bossRushBanner?.classList.add("hidden");
        bossRushBanner?.classList.remove("flex");
      }
    }

    const fastestStr = localStorage.getItem("bashquest_fastest_boss_rush_str");
    if (dashboardFastestTime) {
      if (fastestStr) {
        dashboardFastestTime.textContent = `⚡ Best: ${fastestStr}`;
        dashboardFastestTime.classList.remove("hidden");
      } else {
        dashboardFastestTime.classList.add("hidden");
      }
    }

    const nodes = document.querySelectorAll(".lesson-node-card");
    nodes.forEach((node) => {
      const lessonIdAttr = node.getAttribute("data-lesson-id");
      if (!lessonIdAttr) return;
      const lessonId = parseInt(lessonIdAttr);

      const isCompleted = completed.includes(lessonId);
      const lessonIndex = lessons.findIndex((l: any) => l.id === lessonId);
      const isBoss = node.getAttribute("data-is-boss") === "true" || node.getAttribute("data-is-boss-challenge") === "true";

      let isUnlocked =
        lessonIndex === 0 || completed.includes(lessons[lessonIndex - 1]?.id);

      // In Boss Rush Mode, only the 17 Boss Challenges are visible and all 17 are unlocked!
      if (isBossRush) {
        if (!isBoss) {
          node.classList.add("hidden");
          return;
        } else {
          node.classList.remove("hidden");
          isUnlocked = true;
        }
      } else {
        node.classList.remove("hidden");
      }

      const statusBadge = node.querySelector(".node-status-badge");
      const lockOverlay = node.querySelector(".node-lock-overlay");
      const startText = node.querySelector(".start-text");
      const titleEl = node.querySelector("h3");
      const descEl = node.querySelector("p");

      node.classList.remove(
        "opacity-60",
        "pointer-events-none",
        "border-success",
        "border-violet",
        "border-violet/50",
        "border-primary",
        "shadow-level-4",
        "shadow-level-3",
        "shadow-level-2",
        "shadow-[0_0_20px_rgba(121,40,202,0.15)]",
        "shadow-[0_8px_30px_rgba(0,0,0,0.08)]",
        "bg-emerald-50/5",
        "bg-emerald-50/20",
        "bg-emerald-50/50",
        "dark:bg-emerald-950/5",
        "dark:bg-emerald-950/10",
        "opacity-40",
        "opacity-50",
        "opacity-90",
        "opacity-100",
        "bg-canvas-soft-2",
        "border-hairline",
        "border-hairline-strong",
        "border-emerald-100",
        "border-emerald-500/20",
        "border-emerald-200/50",
        "dark:border-emerald-800/40",
        "dark:border-emerald-900/20",
        "dark:border-emerald-900/30",
        "bg-emerald-500/[0.02]",
        "dark:bg-emerald-500/[0.01]",
        "bg-canvas",
        "bg-transparent",
        "opacity-75",
        "opacity-70",
      );
      lockOverlay?.classList.add("hidden");
      startText?.classList.remove(
        "animate-pulse-subtle",
        "text-violet",
        "text-link",
        "font-bold",
        "group-hover:text-ink",
        "transition-colors",
      );
      startText?.classList.add("text-mute");
      if (startText) {
        startText.innerHTML = `${labels.start} <span class="font-mono">→</span>`;
      }
      if (titleEl) {
        titleEl.className =
          "font-sans text-base font-bold text-ink group-hover:text-link transition-colors";
      }
      if (descEl) {
        descEl.className = "text-xs text-body line-clamp-2 mt-1";
      }

      if (isCompleted) {
        node.classList.remove("opacity-60", "pointer-events-none");
        node.classList.add("bg-canvas", "border-hairline-strong");
        if (titleEl) {
          titleEl.className = "font-sans text-base font-bold text-ink";
        }
        if (descEl) {
          descEl.className = "text-xs text-body line-clamp-2 mt-1";
        }
        if (statusBadge) {
          statusBadge.textContent = labels.passed;
          statusBadge.className =
            "node-status-badge text-[10px] font-mono font-bold text-emerald-600 bg-emerald-50 border border-emerald-200 dark:text-emerald-400 dark:bg-emerald-950/20 dark:border-emerald-800/40 px-2 py-0.5 rounded";
        }
        if (startText) {
          startText.innerHTML = `${labels.review} <span class="font-mono">→</span>`;
          startText.classList.remove("text-mute");
          startText.classList.add(
            "text-mute",
            "group-hover:text-ink",
            "transition-colors",
          );
        }
      } else if (isUnlocked) {
        node.classList.remove("opacity-60", "pointer-events-none");
        node.classList.add(
          "border-primary",
          "dark:border-violet/50",
          "bg-canvas",
          "shadow-[0_8px_30px_rgba(0,0,0,0.08)]",
          "dark:shadow-[0_0_20px_rgba(121,40,202,0.15)]",
        );
        if (startText) {
          startText.classList.remove("text-mute");
          startText.classList.add(
            "animate-pulse-subtle",
            "text-link",
            "font-bold",
          );
        }
        if (statusBadge) {
          statusBadge.textContent = labels.active;
          statusBadge.className =
            "node-status-badge text-[10px] font-mono font-bold text-violet-deep bg-violet-soft border border-violet-soft px-2.5 py-0.5 rounded";
        }
      } else {
        node.classList.add(
          "opacity-60",
          "pointer-events-none",
          "bg-canvas-soft-2",
          "border-hairline",
        );
        lockOverlay?.classList.remove("hidden");
        if (statusBadge) {
          statusBadge.textContent = labels.locked;
          statusBadge.className =
            "node-status-badge text-[10px] font-mono font-bold text-mute bg-canvas-soft border-hairline px-2 py-0.5 rounded";
        }
      }

      // Keep reference links available while guarding the actionable launch button.
      node.classList.remove("pointer-events-none");
      const launch = node.querySelector<HTMLButtonElement>("button.start-text");
      if (launch) launch.disabled = !(isUnlocked || isCompleted);
      if (isUnlocked || isCompleted) {
        node.classList.remove("pointer-events-none");
        if (node.getAttribute("data-bound") !== "true") {
          node.setAttribute("data-bound", "true");
          node.addEventListener("click", () => {
            if (node.querySelector<HTMLButtonElement>("button.start-text")?.disabled) return;
            window.dispatchEvent(
              new CustomEvent("app:select-lesson", { detail: { lessonId } }),
            );
            window.dispatchEvent(
              new CustomEvent("app:trigger-view-change", {
                detail: { view: "sandbox" },
              }),
            );
          });
        }
      }
    });

    // Toggle module container visibility in Boss Rush Mode
    const moduleContainers = document.querySelectorAll(".module-container");
    moduleContainers.forEach((mc) => {
      if (isBossRush) {
        const visibleNodes = mc.querySelectorAll(".lesson-node-card:not(.hidden)");
        if (visibleNodes.length === 0) {
          mc.classList.add("hidden");
        } else {
          mc.classList.remove("hidden");
        }
      } else {
        mc.classList.remove("hidden");
      }
    });
  }

  const resetBtn = document.getElementById("btn-reset-progress");
  const resetModal = document.getElementById("modal-reset-confirm");
  const closeResetModalBtn = document.getElementById("btn-close-reset-modal");
  const cancelResetBtn = document.getElementById("btn-cancel-reset");
  const confirmResetBtn = document.getElementById("btn-confirm-reset");

  if (resetBtn && resetModal) {
    resetBtn.addEventListener("click", () => {
      resetModal.classList.remove("hidden");
    });

    const hideResetModal = () => {
      resetModal.classList.add("hidden");
    };

    closeResetModalBtn?.addEventListener("click", hideResetModal);
    cancelResetBtn?.addEventListener("click", hideResetModal);

    resetModal.addEventListener("click", (e: any) => {
      if (e.target === resetModal) {
        hideResetModal();
      }
    });

    confirmResetBtn?.addEventListener("click", () => {
      hideResetModal();
      window.dispatchEvent(new CustomEvent("app:reset-state"));
    });
  }

  const exportBtn = document.getElementById("btn-export-save");
  const exportModal = document.getElementById("modal-export-save");
  const closeExportModalBtn = document.getElementById("btn-close-export-modal");
  const closeExportBtn = document.getElementById("btn-close-export");
  const copyExportBtn = document.getElementById("btn-copy-export");
  const exportTextarea = document.getElementById(
    "export-textarea",
  ) as HTMLTextAreaElement;

  if (exportBtn && exportModal) {
    exportBtn.addEventListener("click", () => {
      window.dispatchEvent(new CustomEvent("app:export-save"));
    });

    const hideExportModal = () => {
      exportModal.classList.add("hidden");
    };

    closeExportModalBtn?.addEventListener("click", hideExportModal);
    closeExportBtn?.addEventListener("click", hideExportModal);

    exportModal.addEventListener("click", (e: any) => {
      if (e.target === exportModal) {
        hideExportModal();
      }
    });

    copyExportBtn?.addEventListener("click", () => {
      if (exportTextarea) {
        exportTextarea.select();
        navigator.clipboard
          .writeText(exportTextarea.value)
          .then(() => {
            const btnText = document.getElementById("btn-copy-text");
            if (btnText) {
              const originalText = btnText.textContent;
              btnText.textContent = "Copied!";
              copyExportBtn.classList.add("bg-emerald-600", "text-white");
              setTimeout(() => {
                btnText.textContent = originalText;
                copyExportBtn.classList.remove("bg-emerald-600", "text-white");
              }, 1500);
            }
          })
          .catch((err) => {
            console.error("Failed to copy text: ", err);
          });
      }
    });
  }

  const importBtn = document.getElementById("btn-import-save");
  const importModal = document.getElementById("modal-import-save");
  const closeImportModalBtn = document.getElementById("btn-close-import-modal");
  const cancelImportBtn = document.getElementById("btn-cancel-import");
  const confirmImportBtn = document.getElementById("btn-confirm-import");
  const importTextarea = document.getElementById(
    "import-textarea",
  ) as HTMLTextAreaElement;
  const importError = document.getElementById("import-error");

  if (importBtn && importModal) {
    importBtn.addEventListener("click", () => {
      if (importTextarea) importTextarea.value = "";
      if (importError) importError.classList.add("hidden");
      importModal.classList.remove("hidden");
    });

    const hideImportModal = () => {
      importModal.classList.add("hidden");
    };

    closeImportModalBtn?.addEventListener("click", hideImportModal);
    cancelImportBtn?.addEventListener("click", hideImportModal);

    importModal.addEventListener("click", (e: any) => {
      if (e.target === importModal) {
        hideImportModal();
      }
    });

    confirmImportBtn?.addEventListener("click", () => {
      const code = importTextarea ? importTextarea.value.trim() : "";
      if (!code) {
        if (importError) {
          importError.textContent = "Please enter a save code";
          importError.classList.remove("hidden");
        }
        return;
      }
      window.dispatchEvent(
        new CustomEvent("app:import-save", { detail: { saveCode: code } }),
      );
    });
  }

  window.addEventListener("app:show-export-modal", (e: any) => {
    if (exportTextarea && exportModal) {
      exportTextarea.value = e.detail.saveCode;
      exportModal.classList.remove("hidden");
    }
  });

  window.addEventListener("app:import-error", (e: any) => {
    if (importError) {
      importError.textContent = e.detail.message || "Invalid save code";
      importError.classList.remove("hidden");
    }
  });

  window.addEventListener("app:import-success", () => {
    if (importModal) {
      importModal.classList.add("hidden");
    }
  });

  window.addEventListener("app:state-updated", () => {
    updateDashboardUI();
  });
  window.addEventListener("app:filesystem-update", () => {
    updateDashboardUI();
  });

  // --- Boss Rush Toggle Handler ---
  const bossRushToggleBtn = document.getElementById("btn-boss-rush-toggle");
  bossRushToggleBtn?.addEventListener("click", () => {
    const globalWindow = window as any;
    const currentMode = Boolean(globalWindow.appState?.bossRushMode);
    window.dispatchEvent(
      new CustomEvent("app:toggle-boss-rush", {
        detail: { enable: !currentMode },
      }),
    );
  });

</script>
