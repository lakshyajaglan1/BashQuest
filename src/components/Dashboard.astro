<script>
  import { getLocalizedLessons, getLevelName, getLocalizedBadge } from "../i18n/lessons/index";
  import type { SupportedLanguage } from "../i18n/languages";

  const i18nLabels: Record<string, { passed: string; active: string; locked: string; start: string; review: string; noBadges: string; quest: string; levelUser: string }> = {
    en: { passed: "Passed", active: "Active", locked: "Locked", start: "Start", review: "Review", noBadges: "No badges unlocked yet.<br>Complete quests to collect!", quest: "Quest", levelUser: "Level {level} User" },
    es: { passed: "Completado", active: "Activo", locked: "Bloqueado", start: "Comenzar", review: "Revisar", noBadges: "No hay insignias desbloqueadas aún.<br>¡Completa misiones para coleccionar!", quest: "Misión", levelUser: "Usuario Nivel {level}" },
    fr: { passed: "Réussi", active: "Actif", locked: "Verrouillé", start: "Démarrer", review: "Revoir", noBadges: "Aucun badge débloqué pour le moment.<br>Complétez des quêtes pour en collecter !", quest: "Quête", levelUser: "Utilisateur Niveau {level}" },
    de: { passed: "Bestanden", active: "Aktiv", locked: "Gesperrt", start: "Starten", review: "Wiederholen", noBadges: "Noch keine Abzeichen freigeschaltet.<br>Schließen Sie Quests ab, um welche zu sammeln!", quest: "Quest", levelUser: "Level {level} Benutzer" },
    ja: { passed: "合格", active: "アクティブ", locked: "ロック中", start: "開始", review: "復習", noBadges: "まだバッジはありません。<br>クエストをクリアして集めましょう！", quest: "クエスト", levelUser: "レベル {level} ユーザー" },
    pt: { passed: "Concluído", active: "Ativo", locked: "Bloqueado", start: "Iniciar", review: "Revisar", noBadges: "Nenhum emblema desbloqueado ainda.<br>Complete missões para colecionar!", quest: "Missão", levelUser: "Usuário Nivel {level}" },
    ko: { passed: "통과", active: "진행중", locked: "잠김", start: "시작", review: "복습", noBadges: "아직 획득한 배지가 없습니다.<br>퀘스트를 완료하고 배지를 모아보세요!", quest: "퀘스트", levelUser: "레벨 {level} 유저" },
    it: { passed: "Completato", active: "Attivo", locked: "Bloccato", start: "Inizia", review: "Rivedi", noBadges: "Nessun distintivo ancora sbloccato.<br>Completa le missioni per collezionarli!", quest: "Missione", levelUser: "Utente Livello {level}" },
  };

  function getCurrentLang(): SupportedLanguage {
    const docLang = document.documentElement.lang as SupportedLanguage;
    if (docLang && i18nLabels[docLang]) return docLang;
    return "en";
  }

  function updateDashboardUI() {
    const globalWindow = window as any;
    if (!globalWindow.appState) return;

    const dashboardView = document.getElementById("view-dashboard");
    if (dashboardView && dashboardView.classList.contains("hidden")) {
      return;
    }

    const currentLang = getCurrentLang();
    const labels = i18nLabels[currentLang] || i18nLabels.en;
    const lessons = getLocalizedLessons(currentLang);

    const state = globalWindow.appState;
    const completed = state.completedLessons || [];

    let level = 1;
    let totalXpNeededForNext = 100;
    let accumulatedXp = 0;
    while (state.xp >= accumulatedXp + totalXpNeededForNext) {
      accumulatedXp += totalXpNeededForNext;
      level++;
      totalXpNeededForNext = level * 100;
    }
    const xpInLevel = state.xp - accumulatedXp;
    const xpPerLevel = totalXpNeededForNext;
    const displayedTitle = getLevelName(level, currentLang);

    const profileTitle = document.getElementById("profile-title");
    const profileLevel = document.getElementById("profile-level");
    const profileXpRatio = document.getElementById("profile-xp-ratio");
    const profileXpProgress = document.getElementById("profile-xp-progress");
    const profileCompletedCount = document.getElementById(
      "profile-completed-count",
    );
    const profileBadgeCount = document.getElementById("profile-badge-count");

    if (profileTitle) {
      profileTitle.textContent = /[.?!]$/.test(displayedTitle)
        ? displayedTitle
        : displayedTitle + ".";
    }
    if (profileLevel) profileLevel.textContent = labels.levelUser.replace("{level}", level.toString());
    if (profileXpRatio)
      profileXpRatio.textContent = `${xpInLevel} / ${xpPerLevel}`;
    if (profileXpProgress) {
      const percentage = (xpInLevel / xpPerLevel) * 100;
      if (profileXpProgress.style.width === "") {
        profileXpProgress.style.width = "0%";
      }
      setTimeout(() => {
        profileXpProgress.style.width = `${percentage}%`;
      }, 100);
    }
    if (profileCompletedCount) {
      profileCompletedCount.textContent = `${completed.length} / ${lessons.length}`;
    }

    const badgesRack = document.getElementById("dashboard-badges-rack");
    if (badgesRack) {
      const earnedBadges: any[] = [];
      lessons.forEach((l: any, idx: number) => {
        if (completed.includes(l.id) && l.badge) {
          earnedBadges.push({ badge: l.badge, title: l.title, questNumber: idx + 1 });
        }
      });

      if (profileBadgeCount)
        profileBadgeCount.textContent = earnedBadges.length.toString();

      if (earnedBadges.length === 0) {
        badgesRack.innerHTML = `
          <div class="w-full text-center py-5 border border-dashed border-hairline rounded-md text-mute text-[10px] font-mono bg-canvas-soft-2/50">
            ${labels.noBadges}
          </div>
        `;
      } else {
        badgesRack.innerHTML = earnedBadges
          .map((item, index) => {
            const colors = [
              {
                bg: "bg-violet-50 dark:bg-violet-950/30",
                text: "text-violet-700 dark:text-violet-300",
                border:
                  "border-violet-100 dark:border-violet-900/40 hover:bg-violet-100/50 dark:hover:bg-violet-900/30",
              },
              {
                bg: "bg-blue-50 dark:bg-blue-950/30",
                text: "text-blue-700 dark:text-blue-300",
                border:
                  "border-blue-100 dark:border-blue-900/40 hover:bg-blue-100/50 dark:hover:bg-blue-900/30",
              },
              {
                bg: "bg-emerald-50 dark:bg-emerald-950/30",
                text: "text-emerald-700 dark:text-emerald-300",
                border:
                  "border-emerald-100 dark:border-emerald-900/40 hover:bg-emerald-100/50 dark:hover:bg-emerald-900/30",
              },
            ];
            const color = colors[index % colors.length];

            let emoji = "🏆";
            const badgeLower = (item.badge || "").toLowerCase();
            if (badgeLower.includes("explorer") || badgeLower.includes("explorateur") || badgeLower.includes("explorador") || badgeLower.includes("erkunder") || badgeLower.includes("エクスプローラー") || badgeLower.includes("탐험가")) emoji = "🧭";
            else if (badgeLower.includes("navigator") || badgeLower.includes("navigateur") || badgeLower.includes("navegante") || badgeLower.includes("ナビゲーター") || badgeLower.includes("항해사")) emoji = "🗺️";
            else if (badgeLower.includes("builder") || badgeLower.includes("bâtisseur") || badgeLower.includes("constructor") || badgeLower.includes("erbauer")) emoji = "🛠️";
            else if (badgeLower.includes("architect") || badgeLower.includes("architecte") || badgeLower.includes("arquitecto") || badgeLower.includes("architekt")) emoji = "📐";
            else if (badgeLower.includes("cleaner") || badgeLower.includes("nettoyeur") || badgeLower.includes("limpiador")) emoji = "🗑️";
            else if (badgeLower.includes("plumber") || badgeLower.includes("plombier") || badgeLower.includes("fontanero")) emoji = "🔧";
            else if (badgeLower.includes("filterer") || badgeLower.includes("filtreur") || badgeLower.includes("filtrador")) emoji = "🔍";

            return `
            <div class="flex items-center gap-2 px-3 py-1.5 ${color.bg} ${color.border} border rounded-full transition-all duration-200 hover:-translate-y-0.5 hover:shadow-sm cursor-default select-none group/badge relative">
              <span class="text-sm shrink-0">${emoji}</span>
              <span class="text-[11px] font-mono font-bold ${color.text} truncate max-w-[100px]">${item.badge}</span>
              <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 opacity-0 scale-95 pointer-events-none group-hover/badge:opacity-100 group-hover/badge:scale-100 bg-primary text-on-primary text-[9px] font-mono py-1 px-2 rounded shadow-level-3 border border-hairline z-10 transition-all duration-200 whitespace-nowrap">
                ${labels.quest} ${item.questNumber}: ${item.title}
              </div>
            </div>
          `;
          })
          .join("");
      }
    }

    // Update Certificate section in sidebar
    const bossLessons = lessons.filter((l: any) => l.title.includes("Boss Challenge"));
    const bossCompletedCount = bossLessons.filter((b: any) => completed.includes(b.id)).length;

    const certProgressBadge = document.getElementById("cert-progress-badge");
    const certProgressCount = document.getElementById("cert-progress-count");
    const certStatusBadge = document.getElementById("cert-status-badge");
    const btnClaimCert = document.getElementById("btn-claim-certificate") as HTMLButtonElement | null;

    if (certProgressBadge) {
      certProgressBadge.textContent = `${bossCompletedCount} / 17 Bosses`;
    }
    if (certProgressCount) {
      certProgressCount.textContent = `${bossCompletedCount} / 17 Boss Challenges completed`;
    }
    if (certStatusBadge && btnClaimCert) {
      if (bossCompletedCount >= 17 || completed.length >= lessons.length) {
        certStatusBadge.textContent = "Unlocked";
        certStatusBadge.className = "text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-300 dark:bg-emerald-950/30 dark:text-emerald-400 dark:border-emerald-800/40 font-bold";
        btnClaimCert.classList.add("bg-gradient-to-r", "from-violet", "to-link", "animate-pulse");
        btnClaimCert.classList.remove("opacity-70");
        btnClaimCert.title = "Claim your official Linux Certificate!";
      } else {
        certStatusBadge.textContent = `Locked (${bossCompletedCount}/17)`;
        certStatusBadge.className = "text-[10px] font-mono px-2 py-0.5 rounded bg-canvas-soft-2 text-mute border border-hairline font-bold";
        btnClaimCert.classList.remove("bg-gradient-to-r", "from-violet", "to-link", "animate-pulse");
        btnClaimCert.classList.add("opacity-70");
        btnClaimCert.title = `Locked: Complete all 17 Boss Challenges to claim certificate (${bossCompletedCount}/17 completed)`;
      }
    }

    // Boss Rush mode handling
    const isBossRush = Boolean(state.bossRushMode);
    const bossRushToggleBtn = document.getElementById("btn-boss-rush-toggle");
    const bossRushStatusDot = document.getElementById("boss-rush-status-dot");
    const bossRushBanner = document.getElementById("boss-rush-banner");
    const dashboardFastestTime = document.getElementById("dashboard-fastest-time");

    if (bossRushToggleBtn && bossRushStatusDot) {
      if (isBossRush) {
        bossRushToggleBtn.classList.remove("bg-canvas", "text-ink", "border-hairline");
        bossRushToggleBtn.classList.add("bg-amber-500", "text-black", "border-amber-600", "font-bold", "shadow-sm");
        bossRushStatusDot.classList.remove("bg-mute");
        bossRushStatusDot.classList.add("bg-emerald-600", "animate-ping");
        bossRushBanner?.classList.remove("hidden");
        bossRushBanner?.classList.add("flex");
      } else {
        bossRushToggleBtn.classList.add("bg-canvas", "text-ink", "border-hairline");
        bossRushToggleBtn.classList.remove("bg-amber-500", "text-black", "border-amber-600", "font-bold", "shadow-sm");
        bossRushStatusDot.classList.add("bg-mute");
        bossRushStatusDot.classList.remove("bg-emerald-600", "animate-ping");
        bossRushBanner?.classList.add("hidden");
        bossRushBanner?.classList.remove("flex");
      }
    }

    const fastestStr = localStorage.getItem("bashquest_fastest_boss_rush_str");
    if (dashboardFastestTime) {
      if (fastestStr) {
        dashboardFastestTime.textContent = `⚡ Best: ${fastestStr}`;
        dashboardFastestTime.classList.remove("hidden");
      } else {
        dashboardFastestTime.classList.add("hidden");
      }
    }

    const nodes = document.querySelectorAll(".lesson-node-card");
    nodes.forEach((node) => {
      const lessonIdAttr = node.getAttribute("data-lesson-id");
      if (!lessonIdAttr) return;
      const lessonId = parseInt(lessonIdAttr);

      const isCompleted = completed.includes(lessonId);
      const lessonIndex = lessons.findIndex((l: any) => l.id === lessonId);
      const isBoss = node.getAttribute("data-is-boss") === "true" || node.getAttribute("data-is-boss-challenge") === "true";

      let isUnlocked =
        lessonIndex === 0 || completed.includes(lessons[lessonIndex - 1]?.id);

      // In Boss Rush Mode, only the 17 Boss Challenges are visible and all 17 are unlocked!
      if (isBossRush) {
        if (!isBoss) {
          node.classList.add("hidden");
          return;
        } else {
          node.classList.remove("hidden");
          isUnlocked = true;
        }
      } else {
        node.classList.remove("hidden");
      }

      const statusBadge = node.querySelector(".node-status-badge");
      const lockOverlay = node.querySelector(".node-lock-overlay");
      const startText = node.querySelector(".start-text");
      const titleEl = node.querySelector("h3");
      const descEl = node.querySelector("p");

      node.classList.remove(
        "opacity-60",
        "pointer-events-none",
        "border-success",
        "border-violet",
        "border-violet/50",
        "border-primary",
        "shadow-level-4",
        "shadow-level-3",
        "shadow-level-2",
        "shadow-[0_0_20px_rgba(121,40,202,0.15)]",
        "shadow-[0_8px_30px_rgba(0,0,0,0.08)]",
        "bg-emerald-50/5",
        "bg-emerald-50/20",
        "bg-emerald-50/50",
        "dark:bg-emerald-950/5",
        "dark:bg-emerald-950/10",
        "opacity-40",
        "opacity-50",
        "opacity-90",
        "opacity-100",
        "bg-canvas-soft-2",
        "border-hairline",
        "border-hairline-strong",
        "border-emerald-100",
        "border-emerald-500/20",
        "border-emerald-200/50",
        "dark:border-emerald-800/40",
        "dark:border-emerald-900/20",
        "dark:border-emerald-900/30",
        "bg-emerald-500/[0.02]",
        "dark:bg-emerald-500/[0.01]",
        "bg-canvas",
        "bg-transparent",
        "opacity-75",
        "opacity-70",
      );
      lockOverlay?.classList.add("hidden");
      startText?.classList.remove(
        "animate-pulse-subtle",
        "text-violet",
        "text-link",
        "font-bold",
        "group-hover:text-ink",
        "transition-colors",
      );
      startText?.classList.add("text-mute");
      if (startText) {
        startText.innerHTML = `${labels.start} <span class="font-mono">→</span>`;
      }
      if (titleEl) {
        titleEl.className =
          "font-sans text-base font-bold text-ink group-hover:text-link transition-colors";
      }
      if (descEl) {
        descEl.className = "text-xs text-body line-clamp-2 mt-1";
      }

      if (isCompleted) {
        node.classList.remove("opacity-60", "pointer-events-none");
        node.classList.add("bg-canvas", "border-hairline-strong");
        if (titleEl) {
          titleEl.className = "font-sans text-base font-bold text-ink";
        }
        if (descEl) {
          descEl.className = "text-xs text-body line-clamp-2 mt-1";
        }
        if (statusBadge) {
          statusBadge.textContent = labels.passed;
          statusBadge.className =
            "node-status-badge text-[10px] font-mono font-bold text-emerald-600 bg-emerald-50 border border-emerald-200 dark:text-emerald-400 dark:bg-emerald-950/20 dark:border-emerald-800/40 px-2 py-0.5 rounded";
        }
        if (startText) {
          startText.innerHTML = `${labels.review} <span class="font-mono">→</span>`;
          startText.classList.remove("text-mute");
          startText.classList.add(
            "text-mute",
            "group-hover:text-ink",
            "transition-colors",
          );
        }
      } else if (isUnlocked) {
        node.classList.remove("opacity-60", "pointer-events-none");
        node.classList.add(
          "border-primary",
          "dark:border-violet/50",
          "bg-canvas",
          "shadow-[0_8px_30px_rgba(0,0,0,0.08)]",
          "dark:shadow-[0_0_20px_rgba(121,40,202,0.15)]",
        );
        if (startText) {
          startText.classList.remove("text-mute");
          startText.classList.add(
            "animate-pulse-subtle",
            "text-link",
            "font-bold",
          );
        }
        if (statusBadge) {
          statusBadge.textContent = labels.active;
          statusBadge.className =
            "node-status-badge text-[10px] font-mono font-bold text-violet-deep bg-violet-soft border border-violet-soft px-2.5 py-0.5 rounded";
        }
      } else {
        node.classList.add(
          "opacity-60",
          "pointer-events-none",
          "bg-canvas-soft-2",
          "border-hairline",
        );
        lockOverlay?.classList.remove("hidden");
        if (statusBadge) {
          statusBadge.textContent = labels.locked;
          statusBadge.className =
            "node-status-badge text-[10px] font-mono font-bold text-mute bg-canvas-soft border-hairline px-2 py-0.5 rounded";
        }
      }

      if (isUnlocked || isCompleted) {
        node.classList.remove("pointer-events-none");
        if (node.getAttribute("data-bound") !== "true") {
          node.setAttribute("data-bound", "true");
          node.addEventListener("click", () => {
            window.dispatchEvent(
              new CustomEvent("app:select-lesson", { detail: { lessonId } }),
            );
            window.dispatchEvent(
              new CustomEvent("app:trigger-view-change", {
                detail: { view: "sandbox" },
              }),
            );
          });
        }
      }
    });

    // Toggle module container visibility in Boss Rush Mode
    const moduleContainers = document.querySelectorAll(".module-container");
    moduleContainers.forEach((mc) => {
      if (isBossRush) {
        const visibleNodes = mc.querySelectorAll(".lesson-node-card:not(.hidden)");
        if (visibleNodes.length === 0) {
          mc.classList.add("hidden");
        } else {
          mc.classList.remove("hidden");
        }
      } else {
        mc.classList.remove("hidden");
      }
    });
  }

  const resetBtn = document.getElementById("btn-reset-progress");
  const resetModal = document.getElementById("modal-reset-confirm");
  const closeResetModalBtn = document.getElementById("btn-close-reset-modal");
  const cancelResetBtn = document.getElementById("btn-cancel-reset");
  const confirmResetBtn = document.getElementById("btn-confirm-reset");

  if (resetBtn && resetModal) {
    resetBtn.addEventListener("click", () => {
      resetModal.classList.remove("hidden");
    });

    const hideResetModal = () => {
      resetModal.classList.add("hidden");
    };

    closeResetModalBtn?.addEventListener("click", hideResetModal);
    cancelResetBtn?.addEventListener("click", hideResetModal);

    resetModal.addEventListener("click", (e: any) => {
      if (e.target === resetModal) {
        hideResetModal();
      }
    });

    confirmResetBtn?.addEventListener("click", () => {
      hideResetModal();
      window.dispatchEvent(new CustomEvent("app:reset-state"));
    });
  }

  const exportBtn = document.getElementById("btn-export-save");
  const exportModal = document.getElementById("modal-export-save");
  const closeExportModalBtn = document.getElementById("btn-close-export-modal");
  const closeExportBtn = document.getElementById("btn-close-export");
  const copyExportBtn = document.getElementById("btn-copy-export");
  const exportTextarea = document.getElementById(
    "export-textarea",
  ) as HTMLTextAreaElement;

  if (exportBtn && exportModal) {
    exportBtn.addEventListener("click", () => {
      window.dispatchEvent(new CustomEvent("app:export-save"));
    });

    const hideExportModal = () => {
      exportModal.classList.add("hidden");
    };

    closeExportModalBtn?.addEventListener("click", hideExportModal);
    closeExportBtn?.addEventListener("click", hideExportModal);

    exportModal.addEventListener("click", (e: any) => {
      if (e.target === exportModal) {
        hideExportModal();
      }
    });

    copyExportBtn?.addEventListener("click", () => {
      if (exportTextarea) {
        exportTextarea.select();
        navigator.clipboard
          .writeText(exportTextarea.value)
          .then(() => {
            const btnText = document.getElementById("btn-copy-text");
            if (btnText) {
              const originalText = btnText.textContent;
              btnText.textContent = "Copied!";
              copyExportBtn.classList.add("bg-emerald-600", "text-white");
              setTimeout(() => {
                btnText.textContent = originalText;
                copyExportBtn.classList.remove("bg-emerald-600", "text-white");
              }, 1500);
            }
          })
          .catch((err) => {
            console.error("Failed to copy text: ", err);
          });
      }
    });
  }

  const importBtn = document.getElementById("btn-import-save");
  const importModal = document.getElementById("modal-import-save");
  const closeImportModalBtn = document.getElementById("btn-close-import-modal");
  const cancelImportBtn = document.getElementById("btn-cancel-import");
  const confirmImportBtn = document.getElementById("btn-confirm-import");
  const importTextarea = document.getElementById(
    "import-textarea",
  ) as HTMLTextAreaElement;
  const importError = document.getElementById("import-error");

  if (importBtn && importModal) {
    importBtn.addEventListener("click", () => {
      if (importTextarea) importTextarea.value = "";
      if (importError) importError.classList.add("hidden");
      importModal.classList.remove("hidden");
    });

    const hideImportModal = () => {
      importModal.classList.add("hidden");
    };

    closeImportModalBtn?.addEventListener("click", hideImportModal);
    cancelImportBtn?.addEventListener("click", hideImportModal);

    importModal.addEventListener("click", (e: any) => {
      if (e.target === importModal) {
        hideImportModal();
      }
    });

    confirmImportBtn?.addEventListener("click", () => {
      const code = importTextarea ? importTextarea.value.trim() : "";
      if (!code) {
        if (importError) {
          importError.textContent = "Please enter a save code";
          importError.classList.remove("hidden");
        }
        return;
      }
      window.dispatchEvent(
        new CustomEvent("app:import-save", { detail: { saveCode: code } }),
      );
    });
  }

  window.addEventListener("app:show-export-modal", (e: any) => {
    if (exportTextarea && exportModal) {
      exportTextarea.value = e.detail.saveCode;
      exportModal.classList.remove("hidden");
    }
  });

  window.addEventListener("app:import-error", (e: any) => {
    if (importError) {
      importError.textContent = e.detail.message || "Invalid save code";
      importError.classList.remove("hidden");
    }
  });

  window.addEventListener("app:import-success", () => {
    if (importModal) {
      importModal.classList.add("hidden");
    }
  });

  window.addEventListener("app:state-updated", () => {
    updateDashboardUI();
  });
  window.addEventListener("app:filesystem-update", () => {
    updateDashboardUI();
  });

  // --- Boss Rush Toggle Handler ---
  const bossRushToggleBtn = document.getElementById("btn-boss-rush-toggle");
  bossRushToggleBtn?.addEventListener("click", () => {
    const globalWindow = window as any;
    const currentMode = Boolean(globalWindow.appState?.bossRushMode);
    window.dispatchEvent(
      new CustomEvent("app:toggle-boss-rush", {
        detail: { enable: !currentMode },
      }),
    );
  });

  // --- HTML5 Canvas Certificate Drawing Engine (1920x1080) ---
  function drawCertificate(
    canvas: HTMLCanvasElement,
    data: {
      name: string;
      date: string;
      xp: number;
      count: number;
      token: string;
      isQualified?: boolean;
      bossCompletedCount?: number;
    },
  ) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const W = 1920;
    const H = 1080;
    canvas.width = W;
    canvas.height = H;
    const isQualified = data.isQualified !== false;

    // 1. Deep Space Dark Background with Radial Gradient
    const bgGrad = ctx.createRadialGradient(W / 2, H / 2, 80, W / 2, H / 2, 1100);
    bgGrad.addColorStop(0, "#161b26");
    bgGrad.addColorStop(0.5, "#0d1017");
    bgGrad.addColorStop(1, "#07080c");
    ctx.fillStyle = bgGrad;
    ctx.fillRect(0, 0, W, H);

    // 2. Subtle Technical Grid Pattern
    ctx.strokeStyle = "rgba(255, 255, 255, 0.025)";
    ctx.lineWidth = 1;
    const step = 40;
    for (let x = 0; x < W; x += step) {
      ctx.beginPath();
      ctx.moveTo(x, 0);
      ctx.lineTo(x, H);
      ctx.stroke();
    }
    for (let y = 0; y < H; y += step) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(W, y);
      ctx.stroke();
    }

    // 3. Atmospheric Corner Glows (Mesh Accents)
    const glow1 = ctx.createRadialGradient(160, 160, 10, 160, 160, 420);
    glow1.addColorStop(0, "rgba(121, 40, 202, 0.18)"); // violet
    glow1.addColorStop(1, "rgba(0, 0, 0, 0)");
    ctx.fillStyle = glow1;
    ctx.fillRect(0, 0, 600, 600);

    const glow2 = ctx.createRadialGradient(W - 160, 160, 10, W - 160, 160, 420);
    glow2.addColorStop(0, "rgba(0, 112, 243, 0.18)"); // link blue
    glow2.addColorStop(1, "rgba(0, 0, 0, 0)");
    ctx.fillStyle = glow2;
    ctx.fillRect(W - 600, 0, 600, 600);

    const glow3 = ctx.createRadialGradient(W / 2, H - 120, 20, W / 2, H - 120, 520);
    glow3.addColorStop(0, "rgba(80, 227, 194, 0.12)"); // cyan
    glow3.addColorStop(1, "rgba(0, 0, 0, 0)");
    ctx.fillStyle = glow3;
    ctx.fillRect(W / 2 - 500, H - 600, 1000, 600);

    // 4. Multi-layer High-Tech Outer Borders
    ctx.strokeStyle = "#232838";
    ctx.lineWidth = 2;
    ctx.strokeRect(36, 36, W - 72, H - 72);

    const borderGrad = ctx.createLinearGradient(48, 48, W - 48, H - 48);
    borderGrad.addColorStop(0, "#007cf0");
    borderGrad.addColorStop(0.25, "#7928ca");
    borderGrad.addColorStop(0.5, "#ff0080");
    borderGrad.addColorStop(0.75, "#50e3c2");
    borderGrad.addColorStop(1, "#f9cb28");
    ctx.strokeStyle = borderGrad;
    ctx.lineWidth = 3.5;
    ctx.strokeRect(48, 48, W - 96, H - 96);

    ctx.strokeStyle = "#1b202d";
    ctx.lineWidth = 1;
    ctx.strokeRect(60, 60, W - 120, H - 120);

    // Decorative Corner Brackets
    const drawBracket = (x: number, y: number, dx: number, dy: number) => {
      ctx.strokeStyle = "#50e3c2";
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(x + dx * 46, y);
      ctx.lineTo(x, y);
      ctx.lineTo(x, y + dy * 46);
      ctx.stroke();

      ctx.fillStyle = "#f5a623";
      ctx.fillRect(x - 3, y - 3, 6, 6);
    };
    drawBracket(70, 70, 1, 1);
    drawBracket(W - 70, 70, -1, 1);
    drawBracket(70, H - 70, 1, -1);
    drawBracket(W - 70, H - 70, -1, -1);

    // 5. BashQuest Branding & Terminal Badge (Top Center)
    const iconSize = 64;
    const iconX = W / 2 - 146;
    const iconY = 100;
    ctx.fillStyle = "#12151e";
    ctx.strokeStyle = "#2c3346";
    ctx.lineWidth = 2;
    ctx.beginPath();
    if (typeof (ctx as any).roundRect === "function") {
      (ctx as any).roundRect(iconX, iconY, iconSize, iconSize, 12);
    } else {
      ctx.rect(iconX, iconY, iconSize, iconSize);
    }
    ctx.fill();
    ctx.stroke();

    // $ Terminal Icon
    ctx.fillStyle = "#27c93f";
    ctx.font = "bold 38px 'JetBrains Mono', 'Courier New', monospace";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText("$", iconX + iconSize / 2, iconY + iconSize / 2 + 1);

    // BashQuest. Logo Text
    ctx.textAlign = "left";
    ctx.font = "bold 46px 'Inter', system-ui, sans-serif";
    ctx.fillStyle = "#ffffff";
    ctx.fillText("BashQuest", iconX + iconSize + 18, iconY + iconSize / 2 + 2);

    const brandW = ctx.measureText("BashQuest").width;
    ctx.fillStyle = "#0070f3";
    ctx.fillText(".", iconX + iconSize + 18 + brandW, iconY + iconSize / 2 + 2);

    // Eyebrow Subtitle
    ctx.textAlign = "center";
    ctx.font = "bold 15px 'JetBrains Mono', monospace";
    ctx.fillStyle = "#50e3c2";
    ctx.fillText("OFFICIAL LINUX SHELL CERTIFICATION", W / 2, 210);

    // 6. Certificate Title
    ctx.font = "bold 44px 'Inter', system-ui, sans-serif";
    ctx.fillStyle = "#ffffff";
    ctx.fillText("CERTIFICATE OF LINUX MASTERY", W / 2, 280);

    ctx.font = "16px 'JetBrains Mono', monospace";
    ctx.fillStyle = "#888888";
    ctx.fillText("THIS CREDENTIAL IS PROUDLY CONFERRED UPON", W / 2, 335);

    // 7. Learner Name
    ctx.font = "bold 64px 'Inter', system-ui, sans-serif";
    const nameGrad = ctx.createLinearGradient(W / 2 - 300, 0, W / 2 + 300, 0);
    nameGrad.addColorStop(0, "#ffffff");
    nameGrad.addColorStop(0.5, "#d3e5ff");
    nameGrad.addColorStop(1, "#ffffff");
    ctx.fillStyle = nameGrad;
    ctx.fillText(data.name || "Linux Explorer", W / 2, 425);

    // Decorative Accent Line under Name
    const lineGrad = ctx.createLinearGradient(W / 2 - 280, 0, W / 2 + 280, 0);
    lineGrad.addColorStop(0, "rgba(0, 112, 243, 0)");
    lineGrad.addColorStop(0.2, "rgba(0, 112, 243, 0.8)");
    lineGrad.addColorStop(0.5, "rgba(80, 227, 194, 1)");
    lineGrad.addColorStop(0.8, "rgba(121, 40, 202, 0.8)");
    lineGrad.addColorStop(1, "rgba(121, 40, 202, 0)");
    ctx.fillStyle = lineGrad;
    ctx.fillRect(W / 2 - 280, 455, 560, 3);

    // 8. Description of Accomplishment
    ctx.font = "20px 'Inter', system-ui, sans-serif";
    ctx.fillStyle = "#a1a1a1";
    ctx.fillText(
      "For successfully conquering the complete Linux terminal curriculum, demonstrating verified competency",
      W / 2,
      515,
    );
    ctx.fillText(
      "in shell script automation, process management, filesystem architecture, and live incident response.",
      W / 2,
      550,
    );

    // 9. Completion Stats Banner (150 Quests • 17 Modules • 140+ Linux Commands Mastered)
    const statsBoxW = 980;
    const statsBoxH = 68;
    const statsBoxX = (W - statsBoxW) / 2;
    const statsBoxY = 610;

    ctx.fillStyle = "#121622";
    ctx.strokeStyle = "#273045";
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    if (typeof (ctx as any).roundRect === "function") {
      (ctx as any).roundRect(statsBoxX, statsBoxY, statsBoxW, statsBoxH, 34);
    } else {
      ctx.rect(statsBoxX, statsBoxY, statsBoxW, statsBoxH);
    }
    ctx.fill();
    ctx.stroke();

    ctx.font = "bold 21px 'JetBrains Mono', monospace";
    ctx.fillStyle = "#ffffff";
    ctx.textAlign = "center";
    ctx.fillText(
      "150 Quests   •   17 Modules   •   140+ Linux Commands Mastered",
      W / 2,
      statsBoxY + statsBoxH / 2 + 7,
    );

    // 10. Date of Issue & Verified Proctor (Bottom Left)
    const leftX = 260;
    ctx.textAlign = "left";
    ctx.font = "bold 13px 'JetBrains Mono', monospace";
    ctx.fillStyle = "#888888";
    ctx.fillText("DATE OF ISSUE", leftX, 790);

    ctx.font = "bold 20px 'Inter', system-ui, sans-serif";
    ctx.fillStyle = "#ffffff";
    ctx.fillText(data.date, leftX, 825);

    ctx.fillStyle = "#273045";
    ctx.fillRect(leftX, 845, 240, 2);

    ctx.font = "14px 'JetBrains Mono', monospace";
    ctx.fillStyle = "#50e3c2";
    ctx.fillText("VERIFIED PROCTOR: BASH ENGINE", leftX, 875);

    // 11. Circular Authority Seal & Signature (Bottom Right)
    const rightX = W - 480;
    const sealX = rightX + 110;
    const sealY = 825;
    const sealR = 54;

    ctx.save();
    ctx.beginPath();
    ctx.arc(sealX, sealY, sealR, 0, Math.PI * 2);
    ctx.fillStyle = isQualified ? "#161b29" : "#241619";
    ctx.fill();
    ctx.strokeStyle = isQualified ? "#f5a623" : "#ef4444";
    ctx.lineWidth = 3;
    ctx.stroke();

    ctx.beginPath();
    ctx.arc(sealX, sealY, sealR - 8, 0, Math.PI * 2);
    ctx.setLineDash([4, 4]);
    ctx.strokeStyle = isQualified ? "#50e3c2" : "#f59e0b";
    ctx.lineWidth = 1.5;
    ctx.stroke();
    ctx.setLineDash([]);

    ctx.textAlign = "center";
    ctx.fillStyle = isQualified ? "#f5a623" : "#ef4444";
    ctx.font = "bold 28px sans-serif";
    ctx.fillText(isQualified ? "★" : "🔒", sealX, sealY + 10);
    ctx.restore();

    ctx.textAlign = "center";
    ctx.font = "bold 13px 'JetBrains Mono', monospace";
    ctx.fillStyle = isQualified ? "#888888" : "#f87171";
    ctx.fillText(isQualified ? "OFFICIAL SEAL" : "PREVIEW ONLY (LOCKED)", sealX, 915);
    ctx.font = "14px 'Inter', sans-serif";
    ctx.fillStyle = "#ffffff";
    ctx.fillText(
      isQualified ? "BashQuest Validation Daemon" : `In Progress: ${data.bossCompletedCount ?? 0}/17 Bosses`,
      sealX,
      938,
    );

    // 12. Deterministic Verification Token (Bottom Center)
    ctx.textAlign = "center";
    ctx.font = "14px 'JetBrains Mono', monospace";
    ctx.fillStyle = "#666666";
    ctx.fillText(isQualified ? "OFFICIAL VERIFICATION TOKEN" : "TOKEN STATUS: UNVERIFIED SAMPLE", W / 2, 945);

    ctx.font = "bold 16px 'JetBrains Mono', monospace";
    ctx.fillStyle = isQualified ? "#50e3c2" : "#f5a623";
    ctx.fillText(data.token, W / 2, 975);

    // 13. High-visibility watermark for unqualified previews
    if (!isQualified) {
      ctx.save();
      ctx.translate(W / 2, H / 2);
      ctx.rotate(-Math.PI / 8);
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";

      // Semi-transparent diagonal red banner
      ctx.fillStyle = "rgba(239, 68, 68, 0.12)";
      ctx.fillRect(-W, -70, W * 2, 140);
      ctx.strokeStyle = "rgba(239, 68, 68, 0.35)";
      ctx.lineWidth = 3;
      ctx.strokeRect(-W, -70, W * 2, 140);

      ctx.font = "bold 48px 'JetBrains Mono', monospace";
      ctx.fillStyle = "rgba(255, 255, 255, 0.4)";
      ctx.fillText(
        `SAMPLE PREVIEW • ${data.bossCompletedCount ?? 0}/17 BOSS CHALLENGES COMPLETED`,
        0,
        -15,
      );

      ctx.font = "bold 20px 'JetBrains Mono', monospace";
      ctx.fillStyle = "rgba(239, 68, 68, 0.9)";
      ctx.fillText(
        "COMPLETE ALL 17 BOSS CHALLENGES TO UNLOCK AND DOWNLOAD OFFICIAL CERTIFICATE",
        0,
        32,
      );

      ctx.restore();
    }
  }

  // --- Certificate Modal Controller ---
  let activeCertToken = "";
  let isCurrentlyQualified = false;

  function renderCurrentCertificate(nameParam?: string, overrideData?: any) {
    const canvas = document.getElementById("cert-canvas") as HTMLCanvasElement;
    const nameInput = document.getElementById("cert-learner-name") as HTMLInputElement;
    const tokenDisplay = document.getElementById("cert-token-display");
    if (!canvas) return;

    const globalWindow = window as any;
    const state = globalWindow.appState || {};
    const completed: number[] = state.completedLessons || [];
    const currentLang = getCurrentLang();
    const lessons = getLocalizedLessons(currentLang);
    const bossLessons = lessons.filter((l: any) => l.title.includes("Boss Challenge"));
    const bossCompletedCount = bossLessons.filter((b: any) => completed.includes(b.id)).length;

    const isQualified = Boolean(
      overrideData?.verified === true ||
      bossCompletedCount >= 17 ||
      completed.length >= lessons.length
    );
    isCurrentlyQualified = isQualified;

    // Update locked notice & buttons
    const certLockedNotice = document.getElementById("cert-locked-notice");
    const certLockedMsg = document.getElementById("cert-locked-msg");
    const certLockedPill = document.getElementById("cert-locked-pill");
    const btnDownloadPng = document.getElementById("btn-download-cert-png") as HTMLButtonElement | null;
    const btnShareLinkedin = document.getElementById("btn-share-cert-linkedin") as HTMLButtonElement | null;
    const btnCopyCertLink = document.getElementById("btn-copy-cert-link") as HTMLButtonElement | null;

    if (certLockedNotice) {
      if (isQualified) {
        certLockedNotice.classList.add("hidden");
        certLockedNotice.classList.remove("flex");
      } else {
        certLockedNotice.classList.remove("hidden");
        certLockedNotice.classList.add("flex");
        if (certLockedMsg) {
          certLockedMsg.textContent = `Locked Preview: You have completed ${bossCompletedCount} of 17 Boss Challenges. Complete all 17 Boss Challenges to unlock official certificate download and LinkedIn sharing.`;
        }
        if (certLockedPill) {
          certLockedPill.textContent = `${bossCompletedCount}/17 Bosses`;
        }
      }
    }

    if (btnDownloadPng) {
      if (isQualified) {
        btnDownloadPng.disabled = false;
        btnDownloadPng.removeAttribute("aria-disabled");
        btnDownloadPng.classList.remove("opacity-50", "cursor-not-allowed", "pointer-events-none");
        btnDownloadPng.title = "Download high-resolution certificate PNG";
        btnDownloadPng.innerHTML = `
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
          </svg>
          <span>Download PNG</span>
        `;
      } else {
        btnDownloadPng.disabled = true;
        btnDownloadPng.setAttribute("aria-disabled", "true");
        btnDownloadPng.classList.add("opacity-50", "cursor-not-allowed", "pointer-events-none");
        btnDownloadPng.title = `Download locked: ${bossCompletedCount}/17 Boss Challenges completed`;
        btnDownloadPng.innerHTML = `
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
          </svg>
          <span>Download Locked (${bossCompletedCount}/17)</span>
        `;
      }
    }

    if (btnShareLinkedin) {
      if (isQualified) {
        btnShareLinkedin.disabled = false;
        btnShareLinkedin.removeAttribute("aria-disabled");
        btnShareLinkedin.classList.remove("opacity-50", "cursor-not-allowed", "pointer-events-none");
        btnShareLinkedin.title = "Share your verified credential on LinkedIn";
      } else {
        btnShareLinkedin.disabled = true;
        btnShareLinkedin.setAttribute("aria-disabled", "true");
        btnShareLinkedin.classList.add("opacity-50", "cursor-not-allowed", "pointer-events-none");
        btnShareLinkedin.title = `Sharing locked: ${bossCompletedCount}/17 Boss Challenges completed`;
      }
    }

    if (btnCopyCertLink) {
      if (isQualified) {
        btnCopyCertLink.classList.remove("opacity-50", "cursor-not-allowed", "pointer-events-none");
        btnCopyCertLink.title = "Copy verification URL";
      } else {
        btnCopyCertLink.classList.add("opacity-50", "cursor-not-allowed", "pointer-events-none");
        btnCopyCertLink.title = `Verification link locked: ${bossCompletedCount}/17 Boss Challenges completed`;
      }
    }

    const name = (nameParam || nameInput?.value || localStorage.getItem("bashquest_cert_name") || "Linux Explorer").trim() || "Linux Explorer";
    const date = overrideData?.date || new Date().toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    });
    const xp = typeof overrideData?.xp === "number" ? overrideData.xp : (state.xp || 1500);
    const count = typeof overrideData?.count === "number" ? overrideData.count : completed.length;

    // Deterministic Token Formula: BQ-${btoa(JSON.stringify({ name, date, xp, count, bossCount: bossCompletedCount, verified: isQualified }))}
    const tokenPayload = { name, date, xp, count, bossCount: bossCompletedCount, verified: isQualified };
    let tokenBase64 = "";
    try {
      tokenBase64 = btoa(unescape(encodeURIComponent(JSON.stringify(tokenPayload))));
    } catch {
      tokenBase64 = btoa(JSON.stringify({ name: "Learner", date, xp, count, bossCount: bossCompletedCount, verified: isQualified }));
    }
    const token = isQualified ? `BQ-${tokenBase64}` : `BQ-PREVIEW-${tokenBase64}`;
    activeCertToken = token;

    if (tokenDisplay) {
      if (isQualified) {
        tokenDisplay.textContent = token;
        tokenDisplay.className = "font-bold text-success truncate select-all cursor-text font-mono";
      } else {
        tokenDisplay.textContent = `[LOCKED - ${bossCompletedCount}/17 BOSS CHALLENGES COMPLETED]`;
        tokenDisplay.className = "font-bold text-amber-500 truncate font-mono";
      }
    }

    drawCertificate(canvas, {
      name,
      date,
      xp,
      count,
      token: isQualified ? token : `[LOCKED PREVIEW - ${bossCompletedCount}/17 BOSSES]`,
      isQualified,
      bossCompletedCount,
    });
  }

  const certModal = document.getElementById("modal-certificate");
  const btnClaimCert = document.getElementById("btn-claim-certificate");
  const btnPreviewCert = document.getElementById("btn-preview-certificate");
  const btnCloseCertModal = document.getElementById("btn-close-cert-modal");
  const certNameInput = document.getElementById("cert-learner-name") as HTMLInputElement;
  const btnRenderCert = document.getElementById("btn-render-cert");
  const btnDownloadPng = document.getElementById("btn-download-cert-png");
  const btnShareLinkedin = document.getElementById("btn-share-cert-linkedin");
  const btnCopyCertLink = document.getElementById("btn-copy-cert-link");

  const openCertModal = (overrideName?: string, overrideData?: any) => {
    if (!certModal) return;
    const initialName = overrideName || localStorage.getItem("bashquest_cert_name") || "";
    if (certNameInput) certNameInput.value = initialName || "Linux Explorer";
    certModal.classList.remove("hidden");
    renderCurrentCertificate(initialName || "Linux Explorer", overrideData);
  };

  const closeCertModal = () => {
    certModal?.classList.add("hidden");
  };

  btnClaimCert?.addEventListener("click", () => openCertModal());
  btnPreviewCert?.addEventListener("click", () => openCertModal());
  btnCloseCertModal?.addEventListener("click", closeCertModal);

  certModal?.addEventListener("click", (e: any) => {
    if (e.target === certModal) closeCertModal();
  });

  certNameInput?.addEventListener("input", () => {
    const name = certNameInput.value.trim() || "Linux Explorer";
    localStorage.setItem("bashquest_cert_name", name);
    renderCurrentCertificate(name);
  });

  btnRenderCert?.addEventListener("click", () => {
    const name = certNameInput?.value.trim() || "Linux Explorer";
    localStorage.setItem("bashquest_cert_name", name);
    renderCurrentCertificate(name);
  });

  btnDownloadPng?.addEventListener("click", () => {
    if (!isCurrentlyQualified) {
      alert("Certificate download is locked! You must complete all 17 Boss Challenges to download the official certificate.");
      return;
    }
    const canvas = document.getElementById("cert-canvas") as HTMLCanvasElement;
    if (!canvas) return;
    const name = certNameInput?.value.trim() || "Linux_Explorer";
    const dataUrl = canvas.toDataURL("image/png");
    const a = document.createElement("a");
    a.href = dataUrl;
    a.download = `BashQuest-Certificate-${name.replace(/\s+/g, "_")}.png`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  });

  const certCanvasEl = document.getElementById("cert-canvas");
  certCanvasEl?.addEventListener("contextmenu", (e) => {
    if (!isCurrentlyQualified) {
      e.preventDefault();
    }
  });

  btnShareLinkedin?.addEventListener("click", () => {
    if (!isCurrentlyQualified) {
      alert("LinkedIn sharing is locked! You must complete all 17 Boss Challenges to share your verified credential.");
      return;
    }
    const token = activeCertToken;
    const verifyUrl = `${window.location.origin}${window.location.pathname}?verify=${encodeURIComponent(token)}`;
    const linkedinUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(verifyUrl)}`;
    window.open(linkedinUrl, "_blank", "noopener,noreferrer");
  });

  btnCopyCertLink?.addEventListener("click", () => {
    if (!isCurrentlyQualified) {
      alert("Verification link is locked until all 17 Boss Challenges are completed.");
      return;
    }
    const token = activeCertToken;
    const verifyUrl = `${window.location.origin}${window.location.pathname}?verify=${encodeURIComponent(token)}`;
    navigator.clipboard.writeText(verifyUrl).then(() => {
      if (btnCopyCertLink) {
        const originalText = btnCopyCertLink.textContent;
        btnCopyCertLink.textContent = "Copied Verification Link!";
        setTimeout(() => {
          btnCopyCertLink.textContent = originalText;
        }, 1500);
      }
    });
  });

  // --- Verification Banner URL Handler ---
  function checkVerifyTokenInUrl() {
    const urlParams = new URLSearchParams(window.location.search);
    const token = urlParams.get("verify");
    const banner = document.getElementById("credential-verification-banner");
    if (!token || !banner || token.startsWith("BQ-PREVIEW-")) return;

    try {
      const cleanToken = token.startsWith("BQ-") ? token.slice(3) : token;
      const decodedStr = decodeURIComponent(escape(atob(cleanToken)));
      const data = JSON.parse(decodedStr);
      if (data && data.name && (data.bossCount >= 17 || data.count >= 150 || data.verified)) {
        const nameEl = document.getElementById("verify-learner-name");
        const dateEl = document.getElementById("verify-date");
        const countEl = document.getElementById("verify-count");
        const xpEl = document.getElementById("verify-xp");
        const tokenCode = document.getElementById("verify-token-code");

        if (nameEl) nameEl.textContent = data.name;
        if (dateEl) dateEl.textContent = data.date || "Verified";
        if (countEl) countEl.textContent = (data.count ?? 150).toString();
        if (xpEl) xpEl.textContent = (data.xp ?? 0).toString();
        if (tokenCode) tokenCode.textContent = token;

        banner.classList.remove("hidden");
        banner.classList.add("flex");

        const viewCertBtn = document.getElementById("btn-verify-view-cert");
        if (viewCertBtn) {
          viewCertBtn.onclick = () => {
            openCertModal(data.name, { ...data, verified: true });
          };
        }
      }
    } catch (e) {
      console.warn("Could not decode verification token from URL:", e);
    }

    const dismissBtn = document.getElementById("btn-dismiss-verify-banner");
    dismissBtn?.addEventListener("click", () => {
      banner.classList.add("hidden");
      banner.classList.remove("flex");
    });
  }

  // Run on mount
  checkVerifyTokenInUrl();
</script>
