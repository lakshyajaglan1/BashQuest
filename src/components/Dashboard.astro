---
import { modules, lessons } from '../lib/lessons';
---
<div class="bg-canvas-soft mesh-gradient min-h-[calc(100vh-64px)] w-full py-12 px-4 md:px-8 select-none">
  <div class="w-full grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- User Profile & Stats (Left Column) -->
    <div class="lg:col-span-1 space-y-6">
      <div class="card-marketing border border-hairline bg-canvas p-6 flex flex-col justify-between h-auto shadow-level-3">
        <div>
          <div class="flex items-center gap-4 mb-6">
            <div class="w-14 h-14 rounded-full bg-primary text-on-primary flex items-center justify-center font-mono text-2xl font-bold border border-hairline shadow-level-2 relative group/avatar overflow-hidden">
              <span class="relative z-10 transition-transform duration-300 group-hover/avatar:scale-110 block">L</span>
            </div>
            <div>
              <h2 id="profile-title" class="text-xl font-sans font-extrabold text-ink tracking-tight">Linux Novice.</h2>
              <p id="profile-level" class="text-[11px] text-mute font-mono uppercase tracking-wider font-semibold mt-0.5">Level 1 User</p>
            </div>
          </div>

          <!-- XP Bar -->
          <div class="space-y-2 mb-6">
            <div class="flex justify-between text-xs font-mono">
              <span class="text-mute">XP Progress</span>
              <span id="profile-xp-ratio" class="text-ink font-bold">0 / 300</span>
            </div>
            <div class="w-full h-2.5 bg-canvas-soft-2 rounded-full overflow-hidden border border-hairline shadow-inner">
              <div id="profile-xp-progress" class="h-full xp-bar-fill transition-all duration-1000 ease-out" style="width: 0%"></div>
            </div>
          </div>

          <!-- Stats Grid -->
          <div class="grid grid-cols-2 gap-4 py-4 border-t border-b border-hairline mb-6 font-mono text-xs">
            <div>
              <span class="text-mute block">Completed</span>
              <span id="profile-completed-count" class="text-base font-bold text-ink">0 / 10</span>
            </div>
            <div>
              <span class="text-mute block">Unlocked Badges</span>
              <span id="profile-badge-count" class="text-base font-bold text-ink">0</span>
            </div>
          </div>
        </div>

        <div>
          <button 
            id="btn-reset-progress" 
            class="w-full h-9 px-4 rounded-sm border border-red-200 text-error bg-red-50 text-xs font-semibold hover:bg-error-soft hover:text-error-deep hover:border-red-300 dark:bg-red-950/10 dark:border-red-900/30 dark:text-red-400 dark:hover:bg-red-900/20 dark:hover:text-red-300 transition-all cursor-pointer shadow-sm hover:shadow-xs"
          >
            Reset Progress
          </button>
        </div>
      </div>

      <!-- Badges Card -->
      <div class="card-marketing bg-canvas p-6 shadow-level-3">
        <h3 class="text-xs font-bold tracking-widest text-mute uppercase font-mono mb-4 border-l-2 border-primary pl-2">Earned Badges</h3>
        <div id="dashboard-badges-rack" class="flex flex-wrap gap-2">
          <!-- Dynamically filled with badges -->
        </div>
      </div>
    </div>

    <!-- Curriculum Skill Tree (Right Column) -->
    <div class="lg:col-span-2 space-y-8">
      <!-- Intro Banner -->
      <div class="mesh-gradient bg-primary text-on-primary p-5 md:p-6 flex flex-col gap-4 relative overflow-hidden shadow-level-4 rounded-md">
        <!-- Subtle mesh gradient glow in the top right corner -->
        <div class="absolute -right-16 -top-16 w-48 h-48 rounded-full bg-gradient-to-br from-violet/25 via-link/15 to-transparent blur-3xl pointer-events-none"></div>
        
        <div class="relative z-10">
          <h2 class="text-base md:text-lg font-bold text-on-primary tracking-tight font-sans">
            Learn Linux by actually using it.
          </h2>
          <p class="text-xs md:text-sm text-on-primary/70 mt-1.5 leading-relaxed max-w-xl">
            Real terminal commands, real filesystem simulation — no videos, no fluff.
          </p>
        </div>
        
        <div class="flex flex-wrap gap-2.5 relative z-10">
          <!-- Real Terminal Sandbox -->
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-on-primary/10 bg-on-primary/5 text-[10px] md:text-xs font-mono font-medium text-on-primary/80 hover:bg-on-primary/10 transition-colors">
            <svg class="w-3.5 h-3.5 text-violet shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            Real Terminal Sandbox
          </span>

          <!-- 60+ Hands-On Quests -->
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-on-primary/10 bg-on-primary/5 text-[10px] md:text-xs font-mono font-medium text-on-primary/80 hover:bg-on-primary/10 transition-colors">
            <svg class="w-3.5 h-3.5 text-success shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
            </svg>
            60+ Hands-On Quests
          </span>

          <!-- Instant Verification -->
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-on-primary/10 bg-on-primary/5 text-[10px] md:text-xs font-mono font-medium text-on-primary/80 hover:bg-on-primary/10 transition-colors">
            <svg class="w-3.5 h-3.5 text-cyan shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
            Instant Verification
          </span>

          <!-- No Signup Required -->
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-on-primary/10 bg-on-primary/5 text-[10px] md:text-xs font-mono font-medium text-on-primary/80 hover:bg-on-primary/10 transition-colors">
            <svg class="w-3.5 h-3.5 text-warning shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
            </svg>
            No Signup Required
          </span>
        </div>
      </div>

      <div class="mb-4">
        <h1 class="display-lg text-ink font-bold tracking-tight">Interactive Learning Path.</h1>
        <p class="body-md text-body mt-2">Follow the path of command quests. Click any unlocked challenge node to open your interactive Linux shell workspace.</p>
      </div>

      {modules.map((mod) => {
        const moduleLessons = lessons.filter(l => l.moduleId === mod.id);
        return (
          <div class="space-y-4">
            <h2 class="text-xs font-mono font-bold tracking-widest text-mute uppercase px-1 border-l-2 border-primary">{mod.title}</h2>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {moduleLessons.map((lesson) => (
                <div 
                  data-lesson-id={lesson.id}
                  class="lesson-node-card cursor-pointer border border-hairline rounded-md p-5 bg-canvas flex flex-col justify-between hover:shadow-md transition-all duration-200 relative group opacity-60 pointer-events-none"
                >
                  <div class="flex justify-between items-start mb-2">
                    <span class="font-mono text-xs font-bold text-mute bg-canvas-soft-2 px-2 py-0.5 rounded border border-hairline">
                      Quest {lesson.id}
                    </span>
                    <span class="node-status-badge text-[10px] font-mono font-bold text-mute bg-canvas-soft border border-hairline px-2 py-0.5 rounded">
                      Locked
                    </span>
                  </div>

                  <div>
                    <h3 class="font-sans text-base font-bold text-ink group-hover:text-link transition-colors">
                      {lesson.title}
                    </h3>
                    <p class="text-xs text-body line-clamp-2 mt-1">
                      {lesson.description}
                    </p>
                  </div>

                  <div class="flex justify-between items-center mt-4 pt-3 border-t border-hairline/50">
                    <span class="text-[11px] font-mono text-mute">
                      +{lesson.xp} XP
                    </span>
                    
                    <span class="start-btn-text text-xs font-sans font-medium text-mute group-hover:translate-x-0.5 transition-transform flex items-center gap-1">
                      Start <span class="font-mono">→</span>
                    </span>
                  </div>

                  <!-- Visual Locked Overlay -->
                  <div class="absolute inset-0 bg-canvas/30 backdrop-blur-[0.5px] rounded-md pointer-events-none block node-lock-overlay"></div>
                </div>
              ))}
            </div>
          </div>
        );
      })}
    </div>

  </div>
</div>

<!-- Custom Confirmation Modal for Resetting Progress -->
<div id="modal-reset-confirm" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs hidden select-none">
  <div class="w-full max-w-md bg-canvas rounded-lg border border-hairline shadow-2xl p-6 relative animate-in fade-in zoom-in-95 duration-200">
    <button id="btn-close-reset-modal" class="absolute top-4 right-4 text-mute hover:text-ink cursor-pointer bg-transparent border-none">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
    
    <div class="flex items-start gap-4 mb-6">
      <div class="flex items-center justify-center w-10 h-10 rounded-full bg-error-soft text-error shrink-0 border border-red-200 dark:bg-red-950/20 dark:border-red-900/30">
        <svg class="w-5 h-5 text-error-deep dark:text-red-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
      </div>
      <div>
        <h3 class="text-base font-bold text-ink tracking-tight">Reset All Progress?</h3>
        <p class="text-xs text-mute font-mono mt-1">This action is irreversible</p>
      </div>
    </div>
    
    <div class="text-sm text-body leading-relaxed mb-6 space-y-2">
      <p>Are you sure you want to reset all progress? This will permanently wipe your:</p>
      <ul class="list-disc list-inside text-xs space-y-1 font-mono text-mute pl-2">
        <li>Completed quests history</li>
        <li>Earned XP levels and badges</li>
        <li>Simulated Linux filesystem sandbox state</li>
      </ul>
    </div>
    
    <div class="flex justify-end gap-3">
      <button 
        id="btn-cancel-reset" 
        class="h-9 px-4 rounded-sm border border-hairline bg-canvas text-ink text-xs font-semibold hover:bg-canvas-soft-2 transition-all cursor-pointer"
      >
        Cancel
      </button>
      <button 
        id="btn-confirm-reset" 
        class="h-9 px-4 rounded-sm bg-error text-on-primary text-xs font-semibold hover:bg-error-deep transition-all cursor-pointer border-none"
      >
        Yes, Reset Progress
      </button>
    </div>
  </div>
</div>

<script>
  declare global { interface Window { appState: any; } }

  import { lessons } from '../lib/lessons';

  // Level Names Mapping
  const levelNames = [
    'Guest',
    'Linux Novice',
    'Filesystem Explorer',
    'Shell Apprentice',
    'Console Wrangler',
    'Command Initiate',
    'Script Cadet',
    'Bash Squire',
    'Permissions Paladin',
    'Sysadmin',
    'Network Warden',
    'Kernel Wizard',
    'Root Superuser',
    'Linux Archmage',
    'Linux Demigod'
  ];

  // Refresh Stats
  function updateDashboardUI() {
    if (!window.appState) return;

    // Return early if the Dashboard view is hidden to save performance
    const dashboardView = document.getElementById('view-dashboard');
    if (dashboardView && dashboardView.classList.contains('hidden')) {
      return;
    }

    const state = window.appState;
    const completed = state.completedLessons || [];
    
    // Progressive leveling curve:
    // Level 2 requires 100 XP, Level 3 requires an additional 200 XP, etc.
    let level = 1;
    let totalXpNeededForNext = 100;
    let accumulatedXp = 0;
    while (state.xp >= accumulatedXp + totalXpNeededForNext) {
      accumulatedXp += totalXpNeededForNext;
      level++;
      totalXpNeededForNext = level * 100;
    }
    const xpInLevel = state.xp - accumulatedXp;
    const xpPerLevel = totalXpNeededForNext;
    const levelName = levelNames[Math.min(level - 1, levelNames.length - 1)];

    // Prestige title: if Level > 10, append Lv. number
    let displayedTitle = levelName;
    if (level > 10) {
      displayedTitle = `${levelName} (Lv. ${level})`;
    }

    // Profile Card UI
    const profileTitle = document.getElementById('profile-title');
    const profileLevel = document.getElementById('profile-level');
    const profileXpRatio = document.getElementById('profile-xp-ratio');
    const profileXpProgress = document.getElementById('profile-xp-progress');
    const profileCompletedCount = document.getElementById('profile-completed-count');
    const profileBadgeCount = document.getElementById('profile-badge-count');

    if (profileTitle) {
      profileTitle.textContent = /[.?!]$/.test(displayedTitle) ? displayedTitle : displayedTitle + '.';
    }
    if (profileLevel) profileLevel.textContent = `Level ${level} User`;
    if (profileXpRatio) profileXpRatio.textContent = `${xpInLevel} / ${xpPerLevel}`;
    if (profileXpProgress) {
      const percentage = (xpInLevel / xpPerLevel) * 100;
      // Start with 0% width first if not set to ensure transition plays
      if (profileXpProgress.style.width === '') {
        profileXpProgress.style.width = '0%';
      }
      setTimeout(() => {
        profileXpProgress.style.width = `${percentage}%`;
      }, 100);
    }
    if (profileCompletedCount) {
      profileCompletedCount.textContent = `${completed.length} / ${lessons.length}`;
    }

    // Unlocked Badges Rack
    const badgesRack = document.getElementById('dashboard-badges-rack');
    if (badgesRack) {
      // Find badges from completed lessons
      const earnedBadges: any[] = [];
      lessons.forEach((l: any) => {
        if (completed.includes(l.id) && l.badge) {
          earnedBadges.push({ badge: l.badge, title: l.title });
        }
      });

      if (profileBadgeCount) profileBadgeCount.textContent = earnedBadges.length.toString();

      if (earnedBadges.length === 0) {
        badgesRack.innerHTML = `
          <div class="w-full text-center py-5 border border-dashed border-hairline rounded-md text-mute text-[10px] font-mono bg-canvas-soft-2/50">
            No badges unlocked yet.<br>Complete quests to collect!
          </div>
        `;
      } else {
        badgesRack.innerHTML = earnedBadges.map((item, index) => {
          // Color palettes matching Vercel premium collectible chip style
          const colors = [
            {
              bg: 'bg-violet-50 dark:bg-violet-950/30',
              text: 'text-violet-700 dark:text-violet-300',
              border: 'border-violet-100 dark:border-violet-900/40 hover:bg-violet-100/50 dark:hover:bg-violet-900/30'
            },
            {
              bg: 'bg-blue-50 dark:bg-blue-950/30',
              text: 'text-blue-700 dark:text-blue-300',
              border: 'border-blue-100 dark:border-blue-900/40 hover:bg-blue-100/50 dark:hover:bg-blue-900/30'
            },
            {
              bg: 'bg-amber-50 dark:bg-amber-950/30',
              text: 'text-amber-700 dark:text-amber-300',
              border: 'border-amber-100 dark:border-amber-900/40 hover:bg-amber-100/50 dark:hover:bg-amber-900/30'
            }
          ];
          const color = colors[index % colors.length];
          
          // Emojis mapping based on badge name
          let emoji = '🏆';
          const badgeLower = item.badge.toLowerCase();
          if (badgeLower.includes('explorer')) emoji = '🧭';
          else if (badgeLower.includes('navigator')) emoji = '🗺️';
          else if (badgeLower.includes('builder')) emoji = '🛠️';
          else if (badgeLower.includes('architect')) emoji = '📐';
          else if (badgeLower.includes('neat')) emoji = '🧹';
          else if (badgeLower.includes('helpful')) emoji = '❓';
          else if (badgeLower.includes('creator')) emoji = '✨';
          else if (badgeLower.includes('reader')) emoji = '📖';
          else if (badgeLower.includes('peeker')) emoji = '👁️';
          else if (badgeLower.includes('pager')) emoji = '📄';
          else if (badgeLower.includes('quoter')) emoji = '💬';
          else if (badgeLower.includes('writer')) emoji = '✍️';
          else if (badgeLower.includes('journal')) emoji = '📓';
          else if (badgeLower.includes('archivist')) emoji = '📦';
          else if (badgeLower.includes('wildcard')) emoji = '🃏';
          else if (badgeLower.includes('cleaner')) emoji = '🗑️';
          else if (badgeLower.includes('plumber')) emoji = '🔧';
          else if (badgeLower.includes('organizer')) emoji = '🗂️';
          else if (badgeLower.includes('filterer')) emoji = '🔍';

          return `
            <div class="flex items-center gap-2 px-3 py-1.5 ${color.bg} ${color.border} border rounded-full transition-all duration-200 hover:-translate-y-0.5 hover:shadow-sm cursor-default select-none group/badge relative">
              <span class="text-sm shrink-0">${emoji}</span>
              <span class="text-[11px] font-mono font-bold ${color.text} truncate max-w-[100px]">${item.badge}</span>
              <!-- Tooltip -->
              <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 opacity-0 scale-95 pointer-events-none group-hover/badge:opacity-100 group-hover/badge:scale-100 bg-primary text-on-primary text-[9px] font-mono py-1 px-2 rounded shadow-level-3 border border-hairline z-10 transition-all duration-200 whitespace-nowrap">
                Quest ${item.title}
              </div>
            </div>
          `;
        }).join('');
      }
    }

    // Refresh Nodes list
    const nodes = document.querySelectorAll('.lesson-node-card');
    nodes.forEach(node => {
      const lessonIdAttr = node.getAttribute('data-lesson-id');
      if (!lessonIdAttr) return;
      const lessonId = parseInt(lessonIdAttr);
      
      const isCompleted = completed.includes(lessonId);
      
      // A lesson is unlocked if it is the first lesson in the array, OR the preceding lesson in the lessons array is completed
      const lessonIndex = lessons.findIndex((l: any) => l.id === lessonId);
      const isUnlocked = lessonIndex === 0 || completed.includes(lessons[lessonIndex - 1].id);
      
      const statusBadge = node.querySelector('.node-status-badge');
      const lockOverlay = node.querySelector('.node-lock-overlay');
      const startText = node.querySelector('.start-btn-text');
      const titleEl = node.querySelector('h3');

      node.classList.remove(
        'opacity-60', 'pointer-events-none', 
        'border-success', 'border-violet', 'border-violet/50', 'border-primary',
        'shadow-level-4', 'shadow-level-3', 'shadow-level-2',
        'shadow-[0_0_20px_rgba(121,40,202,0.15)]', 'shadow-[0_8px_30px_rgba(0,0,0,0.08)]',
        'bg-emerald-50/5', 'bg-emerald-50/20', 'bg-emerald-50/50', 'dark:bg-emerald-950/5', 'dark:bg-emerald-950/10', 'opacity-40', 'opacity-50', 'opacity-90', 'opacity-100', 'bg-canvas-soft-2', 
        'border-hairline', 'border-emerald-100', 'border-emerald-500/20', 'border-emerald-200/50', 'dark:border-emerald-800/40', 'dark:border-emerald-900/20', 'dark:border-emerald-900/30',
        'bg-emerald-500/[0.02]', 'dark:bg-emerald-500/[0.01]', 
        'bg-canvas', 'bg-transparent', 'opacity-75', 'opacity-70'
      );
      lockOverlay?.classList.add('hidden');
      startText?.classList.remove('animate-pulse-subtle', 'text-violet', 'text-link', 'font-bold', 'group-hover:text-ink', 'transition-colors');
      startText?.classList.add('text-mute');
      if (startText) {
        startText.innerHTML = 'Start <span class="font-mono">→</span>';
      }
      if (titleEl) {
        titleEl.classList.remove('text-mute');
        titleEl.classList.add('text-ink');
      }

      if (isCompleted) {
        node.classList.add('bg-emerald-50/20', 'border-emerald-100', 'dark:bg-emerald-950/10', 'dark:border-emerald-900/20', 'opacity-100');
        if (statusBadge) {
          statusBadge.textContent = 'Passed';
          statusBadge.className = 'node-status-badge text-[10px] font-mono font-bold text-emerald-600 bg-emerald-50 border border-emerald-200 dark:text-emerald-400 dark:bg-emerald-950/20 dark:border-emerald-800/40 px-2 py-0.5 rounded';
        }
        if (startText) {
          startText.innerHTML = 'Review <span class="font-mono">→</span>';
          startText.classList.remove('text-mute');
          startText.classList.add('text-mute', 'group-hover:text-ink', 'transition-colors');
        }
      } else if (isUnlocked) {
        node.classList.add('border-primary', 'dark:border-violet/50', 'bg-canvas', 'shadow-[0_8px_30px_rgba(0,0,0,0.08)]', 'dark:shadow-[0_0_20px_rgba(121,40,202,0.15)]');
        if (startText) {
          startText.classList.remove('text-mute');
          startText.classList.add('animate-pulse-subtle', 'text-link', 'font-bold');
        }
        if (statusBadge) {
          statusBadge.textContent = 'Active';
          statusBadge.className = 'node-status-badge text-[10px] font-mono font-bold text-violet-deep bg-violet-soft border border-violet-soft px-2.5 py-0.5 rounded';
        }
      } else {
        node.classList.add('opacity-50', 'pointer-events-none', 'bg-canvas-soft-2', 'border-hairline');
        lockOverlay?.classList.remove('hidden');
        if (statusBadge) {
          statusBadge.textContent = 'Locked';
          statusBadge.className = 'node-status-badge text-[10px] font-mono font-bold text-mute bg-canvas-soft border border-hairline px-2 py-0.5 rounded';
        }
      }

      // Hook click event
      if (isUnlocked) {
        node.classList.remove('pointer-events-none');
        // Bind click listener only once using a data attribute flag
        if (node.getAttribute('data-bound') !== 'true') {
          node.setAttribute('data-bound', 'true');
          node.addEventListener('click', () => {
            window.dispatchEvent(new CustomEvent('app:select-lesson', { detail: { lessonId } }));
            window.dispatchEvent(new CustomEvent('app:trigger-view-change', { detail: { view: 'sandbox' } }));
          });
        }
      }
    });
  }

  // Bind Reset button and Confirmation Modal
  const resetBtn = document.getElementById('btn-reset-progress');
  const resetModal = document.getElementById('modal-reset-confirm');
  const closeResetModalBtn = document.getElementById('btn-close-reset-modal');
  const cancelResetBtn = document.getElementById('btn-cancel-reset');
  const confirmResetBtn = document.getElementById('btn-confirm-reset');

  if (resetBtn && resetModal) {
    resetBtn.addEventListener('click', () => {
      resetModal.classList.remove('hidden');
    });

    const hideResetModal = () => {
      resetModal.classList.add('hidden');
    };

    closeResetModalBtn?.addEventListener('click', hideResetModal);
    cancelResetBtn?.addEventListener('click', hideResetModal);

    // Hide if clicking outside the modal content card
    resetModal.addEventListener('click', (e: any) => {
      if (e.target === resetModal) {
        hideResetModal();
      }
    });

    confirmResetBtn?.addEventListener('click', () => {
      hideResetModal();
      window.dispatchEvent(new CustomEvent('app:reset-state'));
    });
  }

  // Listen for updates
  window.addEventListener('app:state-updated', () => {
    updateDashboardUI();
  });
  window.addEventListener('app:filesystem-update', () => {
    updateDashboardUI();
  });
</script>
