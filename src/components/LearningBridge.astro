---
import { getLearningContent } from '../i18n/learning/index.js';
import { getLangFromUrl, useTranslatedPath } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const { chapters, ui } = getLearningContent(lang);
const translatePath = useTranslatedPath(lang);
const { moduleId } = Astro.props;
const chapter = chapters.find(c => c.id === moduleId);
---
{chapter && <aside class="learning-bridge" lang={lang}>
  <p class="learning-eyebrow">{ui.bridge}</p>
  <h2>{chapter.title}</h2>
  <p>{chapter.summary}</p>
  <a href={translatePath(`/learn/${chapter.id}/`)}>{ui.readHandbook}</a>
</aside>}
