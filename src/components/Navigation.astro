---
interface Props {
  activePage?: "home" | "about" | "privacy";
}

const { activePage = "home" } = Astro.props;
---

<header
  class="sticky top-0 z-50 flex items-center justify-between h-[64px] border-b border-hairline bg-canvas px-4 md:px-8 select-none overflow-x-auto [&::-webkit-scrollbar]:hidden"
>
  <!-- Brand Logo -->
  <div class="flex items-center gap-3">
    <div
      class="flex items-center justify-center w-8 h-8 rounded-sm bg-primary text-on-primary font-mono text-lg font-bold"
    >
      $
    </div>
    <span
      class="hidden sm:inline-block font-sans text-lg font-semibold tracking-tight text-ink"
      >BashQuest<span class="text-link">.</span></span
    >
  </div>

  <!-- Central Tab Toggles -->
  <nav class="flex items-center gap-2">
    <a
      id="btn-nav-dashboard"
      href="/?view=dashboard"
      class={`h-9 px-4 rounded-full text-sm font-medium transition-all duration-200 cursor-pointer flex items-center justify-center decoration-none ${activePage === "home" ? "bg-primary text-on-primary shadow-sm" : "text-body hover:text-ink hover:bg-canvas-soft-2"}`}
    >
      Dashboard
    </a>
    <a
      id="btn-nav-sandbox"
      href="/?view=sandbox"
      class="h-9 px-4 rounded-full text-sm font-medium transition-all duration-200 cursor-pointer flex items-center justify-center decoration-none text-body hover:text-ink hover:bg-canvas-soft-2"
    >
      Workspace
    </a>
    <a
      id="btn-nav-tools"
      href="/?view=tools"
      class="h-9 px-4 rounded-full text-sm font-medium transition-all duration-200 cursor-pointer flex items-center justify-center decoration-none text-body hover:text-ink hover:bg-canvas-soft-2"
    >
      Tools
    </a>
    <a
      id="btn-nav-about"
      href="/?view=about"
      class="h-9 px-4 rounded-full text-sm font-medium transition-all duration-200 cursor-pointer flex items-center justify-center decoration-none text-body hover:text-ink hover:bg-canvas-soft-2"
    >
      About
    </a>
  </nav>

  <!-- Profile & Stats Cluster -->
  <div class="flex items-center gap-4">
    <!-- Streak -->
    <div
      id="nav-streak-badge"
      class="hidden sm:flex items-center gap-1.5 text-sm font-medium text-mute bg-canvas-soft px-2.5 py-1 rounded-sm border border-hairline"
    >
      <span id="nav-streak-icon-container" class="flex items-center">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path
            fill-rule="evenodd"
            d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z"
            clip-rule="evenodd"></path>
        </svg>
      </span>
      <span id="nav-streak-count">0</span> Day Streak
    </div>

    <!-- XP Stats -->
    <div
      class="flex items-center gap-2 text-sm font-mono bg-canvas-soft-2 px-3 py-1 rounded-sm border border-hairline text-ink"
    >
      <span class="text-mute font-sans">XP:</span>
      <span id="nav-xp-count" class="font-bold text-success">0</span>
    </div>

    <!-- Theme Toggle -->
    <button
      id="btn-theme-toggle"
      class="flex items-center justify-center w-8 h-8 rounded-sm border border-hairline bg-canvas text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer"
      title="Toggle Dark Mode"
      aria-label="Toggle Dark Mode"
    >
      <!-- Sun Icon (shown in dark mode) -->
      <svg
        id="theme-toggle-sun-icon"
        class="w-4 h-4 hidden text-warning"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m11.314 11.314l.707-.707M12 7a5 5 0 100 10 5 5 0 000-10z"
        ></path>
      </svg>
      <!-- Moon Icon (shown in light mode) -->
      <svg
        id="theme-toggle-moon-icon"
        class="w-4 h-4 text-violet"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
        ></path>
      </svg>
    </button>

    <!-- Ask AI Helper button -->
    <button
      id="btn-ask-ai"
      class="flex items-center gap-1.5 h-8 p-2 sm:px-3 rounded-sm border border-hairline bg-canvas text-ink text-xs font-semibold hover:bg-canvas-soft-2 transition-all cursor-pointer"
    >
      <svg
        class="w-3.5 h-3.5 text-violet"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9.813 15.904L9 21l8.904-4.896L21 9l-4.896-8.904L9.813 15.904z"
        ></path>
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9 10H4a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-5"></path>
      </svg>
      <span class="hidden sm:inline-block">Get a Hint</span>
    </button>
  </div>
</header>

<!-- Popover / Dialog modal for "Ask AI" helper -->
<div
  id="modal-ai-helper"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-xs hidden"
>
  <div
    class="w-full max-w-md bg-canvas rounded-lg border border-hairline shadow-2xl p-6 relative animate-in fade-in zoom-in-95 duration-200"
  >
    <button
      id="btn-close-ai"
      class="absolute top-4 right-4 text-mute hover:text-ink cursor-pointer bg-transparent border-none"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div class="flex items-center gap-3 mb-4">
      <div
        class="flex items-center justify-center w-10 h-10 rounded-full bg-violet-soft text-violet-deep"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
          ></path>
        </svg>
      </div>
      <div>
        <h3 class="text-base font-semibold text-ink">Hint Helper</h3>
      </div>
    </div>

    <div
      id="ai-hint-content"
      class="text-sm text-body leading-relaxed mb-6 space-y-3"
    >
      <p>
        Hello! I am your Linux mentor. Select a challenge to get customized
        hints and tips for your task.
      </p>
    </div>

    <div class="flex justify-end">
      <button
        id="btn-ai-got-it"
        class="h-9 px-4 bg-primary text-on-primary rounded-sm font-medium text-sm hover:opacity-90 transition-all cursor-pointer border-none"
      >
        Got it, thanks!
      </button>
    </div>
  </div>
</div>

<script>
  declare global {
    interface Window {
      appState: any;
    }
  }

  // DOM Elements
  const btnDashboard = document.getElementById("btn-nav-dashboard");
  const btnSandbox = document.getElementById("btn-nav-sandbox");
  const btnAbout = document.getElementById("btn-nav-about");
  const btnTools = document.getElementById("btn-nav-tools");
  const btnAskAI = document.getElementById("btn-ask-ai");
  const btnCloseAI = document.getElementById("btn-close-ai");
  const btnAIGotIt = document.getElementById("btn-ai-got-it");
  const modalAI = document.getElementById("modal-ai-helper");
  const aiHintContent = document.getElementById("ai-hint-content");

  const xpCount = document.getElementById("nav-xp-count");
  const streakCount = document.getElementById("nav-streak-count");

  // Theme Toggle Elements
  const btnThemeToggle = document.getElementById("btn-theme-toggle");
  const sunIcon = document.getElementById("theme-toggle-sun-icon");
  const moonIcon = document.getElementById("theme-toggle-moon-icon");

  function updateThemeIcons() {
    const isDark = document.documentElement.classList.contains("dark");
    if (isDark) {
      sunIcon?.classList.remove("hidden");
      moonIcon?.classList.add("hidden");
    } else {
      sunIcon?.classList.add("hidden");
      moonIcon?.classList.remove("hidden");
    }
  }

  // Initial update
  updateThemeIcons();

  btnThemeToggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
    updateThemeIcons();
  });

  // Toggle View Handler
  function setView(view: string) {
    updateNavHighlights(view);
    window.dispatchEvent(
      new CustomEvent("app:view-change", { detail: { view } }),
    );
  }

  function updateNavHighlights(view: string) {
    const dashboardBtn = document.getElementById("btn-nav-dashboard");
    const sandboxBtn = document.getElementById("btn-nav-sandbox");
    const aboutBtn = document.getElementById("btn-nav-about");
    const toolsBtn = document.getElementById("btn-nav-tools");

    [dashboardBtn, sandboxBtn, aboutBtn, toolsBtn].forEach((btn) => {
      btn?.classList.remove("bg-primary", "text-on-primary", "shadow-sm");
      btn?.classList.add(
        "text-body",
        "hover:text-ink",
        "hover:bg-canvas-soft-2",
      );
    });

    let activeBtn: HTMLElement | null = null;
    if (view === "dashboard") activeBtn = dashboardBtn;
    else if (view === "sandbox") activeBtn = sandboxBtn;
    else if (view === "about") activeBtn = aboutBtn;
    else if (view === "tools") activeBtn = toolsBtn;

    if (activeBtn) {
      activeBtn.classList.add("bg-primary", "text-on-primary", "shadow-sm");
      activeBtn.classList.remove(
        "text-body",
        "hover:text-ink",
        "hover:bg-canvas-soft-2",
      );
    }
  }

  const isHomePage = () => {
    return (
      window.location.pathname === "/" ||
      window.location.pathname === "" ||
      window.location.pathname.endsWith("/index.html")
    );
  };

  btnDashboard?.addEventListener("click", (e) => {
    if (isHomePage()) {
      e.preventDefault();
      setView("dashboard");
    }
  });

  btnSandbox?.addEventListener("click", (e) => {
    if (isHomePage()) {
      e.preventDefault();
      setView("sandbox");
    }
  });

  btnAbout?.addEventListener("click", (e) => {
    if (isHomePage()) {
      e.preventDefault();
      setView("about");
    }
  });

  btnTools?.addEventListener("click", (e) => {
    if (isHomePage()) {
      e.preventDefault();
      setView("tools");
    }
  });

  // Client-side stats loading from storage for non-home pages
  function loadStatsFromStorage() {
    try {
      const saved = localStorage.getItem("bashquest_state");
      if (saved) {
        const state = JSON.parse(saved);
        if (xpCount && state.xp !== undefined) {
          xpCount.textContent = state.xp.toString();
        }
        if (streakCount && state.streak !== undefined) {
          streakCount.textContent = state.streak.toString();
        }
        const streakBadge = document.getElementById("nav-streak-badge");
        const streakIconContainer = document.getElementById(
          "nav-streak-icon-container",
        );
        if (streakBadge && streakIconContainer && state.streak !== undefined) {
          if (state.streak === 0) {
            streakBadge.className =
              "hidden sm:flex items-center gap-1.5 text-sm font-medium px-2.5 py-1 rounded-sm border text-mute bg-canvas-soft border-hairline";
            streakIconContainer.innerHTML = `
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10a1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/>
              </svg>
            `;
          } else {
            streakBadge.className =
              "hidden sm:flex items-center gap-1.5 text-sm font-medium px-2.5 py-1 rounded-sm border text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/30 border-amber-200 dark:border-amber-800/50";
            streakIconContainer.innerHTML = `
              <svg class="w-4 h-4 animate-pulse-subtle text-amber-600 dark:text-amber-400" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.316.492-.533 1.035-.767 1.56-.251.565-.516 1.163-.887 1.637a3.987 3.987 0 01-1.077 1.007c-.43.265-.929.43-1.433.486A4.978 4.978 0 016 10c0-1.455.518-2.79 1.383-3.814a1 1 0 00-.38-1.567 6.002 6.002 0 00-3.328.79C2.466 6.162 1 7.907 1 10a8 8 0 0016 0c0-3.33-1.8-6.242-4.605-7.447z" clip-rule="evenodd" />
              </svg>
            `;
          }
        }
      }
    } catch (e) {
      console.error("Failed to load stats in navigation", e);
    }
  }

  // Load stats initially on DOM load / script execution
  loadStatsFromStorage();

  // AI Modal Handlers
  btnAskAI?.addEventListener("click", () => {
    // Fetch AI hints from window state
    if (window.appState && window.appState.activeLesson) {
      const lesson = window.appState.activeLesson;
      if (aiHintContent) {
        aiHintContent.innerHTML = `
          <p class="font-medium text-ink">Stuck on "${lesson.title}"?</p>
          <p>Here's a hint to guide you:</p>
          <div class="p-3 bg-canvas-soft-2 border border-hairline rounded-sm font-mono text-xs text-ink">
            ${lesson.instructions}
          </div>
          <p class="text-xs text-mute mt-2">💡 Tip: Make sure you are in the correct directory. You can type <code class="px-1.5 py-0.5 bg-canvas-soft-2 border border-hairline rounded text-violet-deep font-mono text-xs">pwd</code> to verify your location.</p>
        `;
      }
    } else {
      if (aiHintContent) {
        aiHintContent.innerHTML = `
          <p>I can help you build commands and complete challenges! Please open the Workspace and choose a lesson first.</p>
        `;
      }
    }
    modalAI?.classList.remove("hidden");
  });

  const closeAI = () => modalAI?.classList.add("hidden");
  btnCloseAI?.addEventListener("click", closeAI);
  btnAIGotIt?.addEventListener("click", closeAI);

  // Listen for Global State Updates
  window.addEventListener("app:state-updated", (e: any) => {
    const state = e.detail;
    if (xpCount) {
      const currentDisplayedXp = parseInt(xpCount.textContent || "0", 10);
      if (state.xp > currentDisplayedXp) {
        let startTimestamp: number | null = null;
        const step = (timestamp: number) => {
          if (!startTimestamp) startTimestamp = timestamp;
          const progress = Math.min((timestamp - startTimestamp) / 800, 1);
          // easeOutQuart
          const easeProgress = 1 - Math.pow(1 - progress, 4);
          xpCount.textContent = Math.floor(
            currentDisplayedXp + (state.xp - currentDisplayedXp) * easeProgress,
          ).toString();
          if (progress < 1) {
            window.requestAnimationFrame(step);
          } else {
            xpCount.textContent = state.xp.toString();
          }
        };
        window.requestAnimationFrame(step);
      } else {
        xpCount.textContent = state.xp.toString();
      }
    }
    if (streakCount) streakCount.textContent = state.streak;

    const streakBadge = document.getElementById("nav-streak-badge");
    const streakIconContainer = document.getElementById(
      "nav-streak-icon-container",
    );
    if (streakBadge && streakIconContainer) {
      if (state.streak === 0) {
        streakBadge.className =
          "hidden sm:flex items-center gap-1.5 text-sm font-medium px-2.5 py-1 rounded-sm border text-mute bg-canvas-soft border-hairline";
        streakIconContainer.innerHTML = `
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/>
          </svg>
        `;
      } else {
        streakBadge.className =
          "hidden sm:flex items-center gap-1.5 text-sm font-medium px-2.5 py-1 rounded-sm border text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/30 border-amber-200 dark:border-amber-800/50";
        streakIconContainer.innerHTML = `
          <svg class="w-4 h-4 animate-pulse-subtle text-amber-600 dark:text-amber-400" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.316.492-.533 1.035-.767 1.56-.251.565-.516 1.163-.887 1.637a3.987 3.987 0 01-1.077 1.007c-.43.265-.929.43-1.433.486A4.978 4.978 0 016 10c0-1.455.518-2.79 1.383-3.814a1 1 0 00-.38-1.567 6.002 6.002 0 00-3.328.79C2.466 6.162 1 7.907 1 10a8 8 0 0016 0c0-3.33-1.8-6.242-4.605-7.447z" clip-rule="evenodd" />
          </svg>
        `;
      }
    }

    if (state.activeView) {
      updateNavHighlights(state.activeView);
    }
  });

  // Switch view internally
  window.addEventListener("app:trigger-view-change", (e: any) => {
    setView(e.detail.view);
  });
</script>
