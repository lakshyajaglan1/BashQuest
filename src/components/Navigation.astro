---
import { getLearningContent } from "../i18n/learning/index.js";
import LanguagePicker from "./LanguagePicker.astro";
import { defaultLang, type SupportedLanguage } from "../i18n/languages";
import { getLangFromUrl, getRouteFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";

interface Props {
  activePage?: "home" | "dashboard" | "terminal" | "tools" | "about" | "privacy" | "terms" | "faq" | "contact";
  lang?: SupportedLanguage;
}

const currentLang = Astro.props.lang || getLangFromUrl(Astro.url);
const pathname = getRouteFromUrl(Astro.url).replace(/\/$/, "");
let detectedPage = "home";
if (pathname.endsWith("/terminal")) detectedPage = "terminal";
else if (pathname.endsWith("/tools")) detectedPage = "tools";
else if (pathname.endsWith("/about")) detectedPage = "about";

const { activePage = detectedPage } = Astro.props;
const isDashboard = !pathname.startsWith("/learn") && (activePage === "home" || activePage === "dashboard");
const isTerminal = activePage === "terminal";
const isTools = activePage === "tools";
const isAbout = activePage === "about";

const t = useTranslations(currentLang);
const { ui: learningUi } = getLearningContent(currentLang);
const translatePath = useTranslatedPath(currentLang);
const homePath = translatePath("/");
---

<header
  class="sticky top-0 z-50 flex items-center justify-between h-[64px] border-b border-hairline bg-canvas px-3 sm:px-4 md:px-8 select-none"
>
  <!-- Brand Logo -->
  <a href={homePath} class="flex items-center gap-2 sm:gap-3 decoration-none shrink-0" aria-label="BashQuest Home">
    <div
      class="flex items-center justify-center w-8 h-8 rounded-sm bg-primary text-on-primary font-mono text-lg font-bold"
    >
      $
    </div>
    <span
      class="hidden xs:inline-block sm:inline-block font-sans text-base sm:text-lg font-semibold tracking-tight text-ink"
      >BashQuest<span class="text-link">.</span></span
    >
  </a>

  <!-- Central Tab Toggles (Desktop only) -->
  <nav class="hidden md:flex items-center gap-2 overflow-x-auto [&::-webkit-scrollbar]:hidden px-1">
    <a
      id="btn-nav-dashboard"
      href={`${homePath}?view=dashboard`}
      class={`h-9 px-4 rounded-full text-sm font-medium transition-all duration-200 cursor-pointer flex items-center justify-center decoration-none ${isDashboard ? "bg-primary text-on-primary shadow-sm" : "text-body hover:text-ink hover:bg-canvas-soft-2"}`}
    >
      {t("nav.dashboard")}
    </a>
    <a
      id="btn-nav-sandbox"
      href={`${homePath}?view=sandbox`}
      class={`h-9 px-4 rounded-full text-sm font-medium transition-all duration-200 cursor-pointer flex items-center justify-center decoration-none ${isTerminal ? "bg-primary text-on-primary shadow-sm" : "text-body hover:text-ink hover:bg-canvas-soft-2"}`}
    >
      {t("nav.workspace")}
    </a>
    <a
      id="btn-nav-tools"
      href={`${homePath}?view=tools`}
      class={`h-9 px-4 rounded-full text-sm font-medium transition-all duration-200 cursor-pointer flex items-center justify-center decoration-none ${isTools ? "bg-primary text-on-primary shadow-sm" : "text-body hover:text-ink hover:bg-canvas-soft-2"}`}
    >
      {t("nav.tools")}
    </a>
    <a
      id="btn-nav-about"
      href={`${homePath}?view=about`}
      class={`h-9 px-4 rounded-full text-sm font-medium transition-all duration-200 cursor-pointer flex items-center justify-center decoration-none ${isAbout ? "bg-primary text-on-primary shadow-sm" : "text-body hover:text-ink hover:bg-canvas-soft-2"}`}
    >
      {t("nav.about")}
    </a>
  </nav>

  <a class="learning-nav-link" href={translatePath("/learn/")} aria-current={pathname.startsWith("/learn") ? "page" : undefined}>{learningUi.nav}<span class="sr-only"> {learningUi.handbook}</span></a>

  <!-- Profile & Stats Cluster -->
  <div class="flex items-center gap-1.5 sm:gap-3 md:gap-4 shrink-0">
    <!-- Boss Rush Live Stopwatch Timer (Workspace Header) -->
    <div
      id="workspace-boss-rush-timer"
      class="hidden items-center gap-1.5 px-2.5 sm:px-3 py-1 rounded-full font-mono text-xs font-bold bg-amber-500/10 border border-amber-500/30 text-amber-600 dark:text-amber-400 select-none animate-pulse shadow-xs"
      title="Boss Rush Live Stopwatch"
    >
      <span class="text-xs sm:text-sm">⏱️</span>
      <span class="hidden sm:inline text-[10px] tracking-wider uppercase font-mono font-bold">Boss Rush:</span>
      <span id="workspace-boss-rush-display" class="tabular-nums font-bold">00:00</span>
    </div>

    <!-- Language Picker -->
    <LanguagePicker currentLang={currentLang} variant="nav" />

    <!-- Streak (Desktop & Tablet) -->
    <div
      id="nav-streak-badge"
      class="hidden sm:flex items-center gap-1.5 text-xs sm:text-sm font-medium text-mute bg-canvas-soft px-2 sm:px-2.5 py-1 rounded-sm border border-hairline"
    >
      <span id="nav-streak-icon-container" class="flex items-center">
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="currentColor" viewBox="0 0 20 20">
          <path
            fill-rule="evenodd"
            d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z"
            clip-rule="evenodd"></path>
        </svg>
      </span>
      <span id="nav-streak-count">0</span>
    </div>

    <!-- XP Stats -->
    <div
      class="flex items-center gap-1 sm:gap-2 text-xs sm:text-sm font-mono bg-canvas-soft-2 px-2 sm:px-3 py-1 rounded-sm border border-hairline text-ink"
    >
      <span class="text-mute font-sans">{t("nav.xp")}</span>
      <span id="nav-xp-count" class="font-bold text-success">0</span>
    </div>

    <!-- Theme Toggle -->
    <button
      id="btn-theme-toggle"
      class="flex items-center justify-center w-8 h-8 rounded-sm border border-hairline bg-canvas text-ink hover:bg-canvas-soft-2 transition-all cursor-pointer"
      title={t("nav.toggleTheme")}
      aria-label={t("nav.toggleTheme")}
    >
      <!-- Sun Icon (shown in dark mode) -->
      <svg
        id="theme-toggle-sun-icon"
        class="w-4 h-4 hidden text-warning"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m11.314 11.314l.707-.707M12 7a5 5 0 100 10 5 5 0 000-10z"
        ></path>
      </svg>
      <!-- Moon Icon (shown in light mode) -->
      <svg
        id="theme-toggle-moon-icon"
        class="w-4 h-4 text-violet"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
        ></path>
      </svg>
    </button>

    <!-- Ask AI Helper button -->
    <button
      id="btn-ask-ai"
      class="flex items-center justify-center sm:justify-start gap-1.5 h-8 w-8 sm:w-auto p-0 sm:px-3 rounded-sm border border-hairline bg-canvas text-ink text-xs font-semibold hover:bg-canvas-soft-2 transition-all cursor-pointer"
      title={t("nav.getHint")}
      aria-label={t("nav.getHint")}
    >
      <svg
        class="w-3.5 h-3.5 text-violet shrink-0"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9.813 15.904L9 21l8.904-4.896L21 9l-4.896-8.904L9.813 15.904z"
        ></path>
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9 10H4a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-5"></path>
      </svg>
      <span class="hidden sm:inline-block">{t("nav.getHint")}</span>
    </button>
  </div>
</header>

<!-- Mobile Bottom Navigation Bar (Fixed for phones & small viewports) -->
<nav
  id="mobile-bottom-nav"
  class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-canvas/95 dark:bg-[#0a0a0a]/95 backdrop-blur-md border-t border-hairline px-2 py-1 flex items-center justify-around shadow-[0_-2px_12px_rgba(0,0,0,0.06)] dark:shadow-[0_-2px_12px_rgba(0,0,0,0.4)] select-none"
  aria-label="Mobile Navigation"
>
  <a
    id="btn-bottom-dashboard"
    href={`${homePath}?view=dashboard`}
    class={`flex flex-col items-center justify-center py-1 px-3 rounded-md text-[10px] font-sans font-medium transition-colors decoration-none ${isDashboard ? "text-primary dark:text-on-primary font-bold" : "text-mute hover:text-ink"}`}
  >
    <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
    </svg>
    <span>{t("nav.dashboard")}</span>
  </a>

  <a
    id="btn-bottom-sandbox"
    href={`${homePath}?view=sandbox`}
    class={`flex flex-col items-center justify-center py-1 px-3 rounded-md text-[10px] font-sans font-medium transition-colors decoration-none ${isTerminal ? "text-primary dark:text-on-primary font-bold" : "text-mute hover:text-ink"}`}
  >
    <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
    </svg>
    <span>{t("nav.workspace")}</span>
  </a>

  <a
    id="btn-bottom-tools"
    href={`${homePath}?view=tools`}
    class={`flex flex-col items-center justify-center py-1 px-3 rounded-md text-[10px] font-sans font-medium transition-colors decoration-none ${isTools ? "text-primary dark:text-on-primary font-bold" : "text-mute hover:text-ink"}`}
  >
    <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
    </svg>
    <span>{t("nav.tools")}</span>
  </a>

  <a
    id="btn-bottom-about"
    href={`${homePath}?view=about`}
    class={`flex flex-col items-center justify-center py-1 px-3 rounded-md text-[10px] font-sans font-medium transition-colors decoration-none ${isAbout ? "text-primary dark:text-on-primary font-bold" : "text-mute hover:text-ink"}`}
  >
    <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
    </svg>
    <span>{t("nav.about")}</span>
  </a>
</nav>

<!-- Popover / Dialog modal for "Ask AI" helper -->
<div
  id="modal-ai-helper"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40 backdrop-blur-xs hidden"
>
  <div
    class="w-full max-w-md bg-canvas rounded-lg border border-hairline shadow-2xl p-6 relative animate-in fade-in zoom-in-95 duration-200"
  >
    <button
      id="btn-close-ai"
      class="absolute top-4 right-4 text-mute hover:text-ink cursor-pointer bg-transparent border-none"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <div class="flex items-center gap-3 mb-4">
      <div
        class="flex items-center justify-center w-10 h-10 rounded-full bg-violet-soft text-violet-deep"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
          ></path>
        </svg>
      </div>
      <div>
        <h3 class="text-base font-semibold text-ink">{t("nav.hintHelper")}</h3>
      </div>
    </div>

    <div
      id="ai-hint-content"
      class="text-sm text-body leading-relaxed mb-6 space-y-3"
    >
      <p>
        {t("nav.hintDefaultMessage")}
      </p>
    </div>

    <div class="flex justify-end">
      <button
        id="btn-ai-got-it"
        class="h-9 px-4 bg-primary text-on-primary rounded-sm font-medium text-sm hover:opacity-90 transition-all cursor-pointer border-none"
      >
        {t("nav.hintGotIt")}
      </button>
    </div>
  </div>
</div>

<script>
  import { getLocalizedLesson, lessons } from "../i18n/lessons/index";
  import type { SupportedLanguage } from "../i18n/languages";

  declare global {
    interface Window {
      appState?: any;
    }
  }

  // DOM Elements
  const btnDashboard = document.getElementById("btn-nav-dashboard");
  const btnSandbox = document.getElementById("btn-nav-sandbox");
  const btnAbout = document.getElementById("btn-nav-about");
  const btnTools = document.getElementById("btn-nav-tools");
  const btnAskAI = document.getElementById("btn-ask-ai");
  const btnCloseAI = document.getElementById("btn-close-ai");
  const btnAIGotIt = document.getElementById("btn-ai-got-it");
  const modalAI = document.getElementById("modal-ai-helper");
  const aiHintContent = document.getElementById("ai-hint-content");

  const btmDashboard = document.getElementById("btn-bottom-dashboard");
  const btmSandbox = document.getElementById("btn-bottom-sandbox");
  const btmTools = document.getElementById("btn-bottom-tools");
  const btmAbout = document.getElementById("btn-bottom-about");

  const xpCount = document.getElementById("nav-xp-count");
  const streakCount = document.getElementById("nav-streak-count");

  // Theme Toggle Elements
  const btnThemeToggle = document.getElementById("btn-theme-toggle");
  const sunIcon = document.getElementById("theme-toggle-sun-icon");
  const moonIcon = document.getElementById("theme-toggle-moon-icon");

  function updateThemeIcons() {
    const isDark = document.documentElement.classList.contains("dark");
    if (isDark) {
      sunIcon?.classList.remove("hidden");
      moonIcon?.classList.add("hidden");
    } else {
      sunIcon?.classList.add("hidden");
      moonIcon?.classList.remove("hidden");
    }
  }

  // Initial update
  updateThemeIcons();

  btnThemeToggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
    updateThemeIcons();
  });

  // Toggle View Handler
  function setView(view: string) {
    updateNavHighlights(view);
    window.dispatchEvent(
      new CustomEvent("app:view-change", { detail: { view } }),
    );
  }

  function updateNavHighlights(view: string) {
    // Desktop nav pills
    [btnDashboard, btnSandbox, btnAbout, btnTools].forEach((btn) => {
      btn?.classList.remove("bg-primary", "text-on-primary", "shadow-sm");
      btn?.classList.add(
        "text-body",
        "hover:text-ink",
        "hover:bg-canvas-soft-2",
      );
    });

    let activeBtn: HTMLElement | null = null;
    if (view === "dashboard") activeBtn = btnDashboard;
    else if (view === "sandbox") activeBtn = btnSandbox;
    else if (view === "about") activeBtn = btnAbout;
    else if (view === "tools") activeBtn = btnTools;

    if (activeBtn) {
      activeBtn.classList.add("bg-primary", "text-on-primary", "shadow-sm");
      activeBtn.classList.remove(
        "text-body",
        "hover:text-ink",
        "hover:bg-canvas-soft-2",
      );
    }

    // Mobile bottom nav items
    [btmDashboard, btmSandbox, btmTools, btmAbout].forEach((btn) => {
      btn?.classList.remove("text-primary", "dark:text-on-primary", "font-bold");
      btn?.classList.add("text-mute");
    });

    let activeBtm: HTMLElement | null = null;
    if (view === "dashboard") activeBtm = btmDashboard;
    else if (view === "sandbox") activeBtm = btmSandbox;
    else if (view === "about") activeBtm = btmAbout;
    else if (view === "tools") activeBtm = btmTools;

    if (activeBtm) {
      activeBtm.classList.add("text-primary", "dark:text-on-primary", "font-bold");
      activeBtm.classList.remove("text-mute");
    }
  }

  const isHomePage = () => {
    const p = window.location.pathname.replace(/\/$/, "");
    return (
      p === "" ||
      p === "/" ||
      p.endsWith("/index.html") ||
      /^\/(es|ja|fr|de|pt|ko|it)$/.test(p)
    );
  };

  const bindNavClick = (el: HTMLElement | null, view: string) => {
    el?.addEventListener("click", (e) => {
      if (isHomePage()) {
        e.preventDefault();
        setView(view);
      }
    });
  };

  bindNavClick(btnDashboard, "dashboard");
  bindNavClick(btnSandbox, "sandbox");
  bindNavClick(btnAbout, "about");
  bindNavClick(btnTools, "tools");

  bindNavClick(btmDashboard, "dashboard");
  bindNavClick(btmSandbox, "sandbox");
  bindNavClick(btmTools, "tools");
  bindNavClick(btmAbout, "about");

  // Client-side stats loading from storage
  function loadStatsFromStorage() {
    try {
      const saved = localStorage.getItem("bashquest_state");
      if (saved) {
        const state = JSON.parse(saved);
        if (xpCount && state.xp !== undefined) {
          xpCount.textContent = state.xp.toString();
        }
        if (streakCount && state.streak !== undefined) {
          streakCount.textContent = state.streak.toString();
        }
        const streakBadge = document.getElementById("nav-streak-badge");
        const streakIconContainer = document.getElementById(
          "nav-streak-icon-container",
        );
        if (streakBadge && streakIconContainer && state.streak !== undefined) {
          if (state.streak === 0) {
            streakBadge.className =
              "hidden sm:flex items-center gap-1.5 text-sm font-medium px-2.5 py-1 rounded-sm border text-mute bg-canvas-soft border-hairline";
            streakIconContainer.innerHTML = `
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10a1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/>
              </svg>
            `;
          } else {
            streakBadge.className =
              "hidden sm:flex items-center gap-1.5 text-sm font-medium px-2.5 py-1 rounded-sm border text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/30 border-amber-200 dark:border-amber-800/50";
            streakIconContainer.innerHTML = `
              <svg class="w-4 h-4 animate-pulse-subtle text-amber-600 dark:text-amber-400" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.316.492-.533 1.035-.767 1.56-.251.565-.516 1.163-.887 1.637a3.987 3.987 0 01-1.077 1.007c-.43.265-.929.43-1.433.486A4.978 4.978 0 016 10c0-1.455.518-2.79 1.383-3.814a1 1 0 00-.38-1.567 6.002 6.002 0 00-3.328.79C2.466 6.162 1 7.907 1 10a8 8 0 0016 0c0-3.33-1.8-6.242-4.605-7.447z" clip-rule="evenodd" />
              </svg>
            `;
          }
        }
      }
    } catch (e) {
      console.error("Failed to load stats in navigation", e);
    }
  }

  // Load stats initially and on Astro page-load / view transitions
  loadStatsFromStorage();
  document.addEventListener("astro:page-load", () => {
    loadStatsFromStorage();
    updateThemeIcons();
  });

  // AI Modal Handlers — progressive hint reveal
  let hintRevealLevel = 0;
  let lastHintLessonId: number | null = null;

  const openAI = () => {
    if (modalAI) {
      modalAI.classList.remove("hidden");
      modalAI.style.display = "flex";
    }
  };

  const closeAI = () => {
    if (modalAI) {
      modalAI.classList.add("hidden");
      modalAI.style.display = "none";
    }
  };

  btnCloseAI?.addEventListener("click", closeAI);
  btnAIGotIt?.addEventListener("click", closeAI);
  modalAI?.addEventListener("click", (e) => {
    if (e.target === modalAI) closeAI();
  });
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modalAI && modalAI.style.display === "flex") {
      closeAI();
    }
  });

  function escapeHtml(s: string) {
    return String(s || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  btnAskAI?.addEventListener("click", () => {
    const docLang = (document.documentElement.lang as SupportedLanguage) || "en";
    const activeLessonId = window.appState?.activeLessonId || 1;
    const lesson =
      window.appState?.activeLesson ||
      getLocalizedLesson(activeLessonId, docLang) ||
      getLocalizedLesson(1, "en");

    if (!lesson) {
      if (aiHintContent) {
        aiHintContent.innerHTML = `
          <p>I can help you build commands and complete challenges! Please select a quest to get started.</p>
        `;
      }
      openAI();
      return;
    }

    const currentView = window.appState?.activeView || "dashboard";
    const hints: string[] = lesson.hints || [];

    // Reset hint level if switching to a different lesson
    if (lastHintLessonId !== lesson.id) {
      hintRevealLevel = 0;
      lastHintLessonId = lesson.id;
    }

    const questIndex = lessons.findIndex((l: any) => l.id === lesson.id);
    const questNumber = questIndex >= 0 ? questIndex + 1 : lesson.id;

    if (hints.length === 0) {
      if (aiHintContent) {
        aiHintContent.innerHTML = `
          <div class="space-y-3">
            <p class="font-semibold text-ink">Quest ${questNumber}: "${escapeHtml(lesson.title)}"</p>
            <p class="text-sm text-body">No step-by-step hints are available for this challenge. Boss challenges test your command-line problem-solving against real filesystem and system state!</p>
            <div class="p-3 bg-canvas-soft-2 border border-hairline rounded-sm">
              <span class="text-xs font-mono font-bold text-violet">Objective:</span>
              <p class="text-xs text-body mt-1">${escapeHtml(lesson.instructions || "Inspect and configure the virtual environment to meet all requirements.")}</p>
            </div>
            ${
              currentView !== "sandbox"
                ? `<div class="pt-2"><button id="btn-jump-to-quest" class="w-full h-9 px-4 bg-primary text-on-primary rounded-sm font-semibold text-xs hover:opacity-90 transition-all cursor-pointer border-none flex items-center justify-center gap-2">Launch Quest in Workspace →</button></div>`
                : ""
            }
          </div>
        `;
      }
    } else {
      // Reveal one more hint each time the button is clicked
      hintRevealLevel = Math.min(hintRevealLevel + 1, hints.length);

      const hintsHtml = hints
        .slice(0, hintRevealLevel)
        .map((hint: string, i: number) => {
          const isLatest = i === hintRevealLevel - 1;
          const labelColors = [
            "text-cyan bg-cyan-50 dark:bg-cyan-950/30 border-cyan-200 dark:border-cyan-800/40",
            "text-warning bg-amber-50 dark:bg-amber-950/30 border-amber-200 dark:border-amber-800/40",
            "text-success bg-emerald-50 dark:bg-emerald-950/30 border-emerald-200 dark:border-emerald-800/40",
          ];
          const colorClass =
            labelColors[i] || labelColors[labelColors.length - 1];
          return `
            <div class="p-3 bg-canvas-soft-2 border border-hairline rounded-sm ${isLatest ? "ring-1 ring-primary/20" : "opacity-80"}">
              <span class="inline-block text-[10px] font-mono font-bold uppercase tracking-wider px-1.5 py-0.5 rounded border mb-1.5 ${colorClass}">Hint ${i + 1}</span>
              <p class="font-mono text-xs text-ink leading-relaxed">${escapeHtml(hint)}</p>
            </div>
          `;
        })
        .join("");

      const moreHintsAvailable = hintRevealLevel < hints.length;
      const footerText = moreHintsAvailable
        ? `<p class="text-xs text-mute mt-2">💡 Click <strong>"Get a Hint"</strong> again to reveal the next hint (${hintRevealLevel}/${hints.length} shown).</p>`
        : `<p class="text-xs text-mute mt-2">✅ All ${hints.length} hints revealed for this quest.</p>`;

      const ctaWorkspace =
        currentView !== "sandbox"
          ? `<div class="pt-2"><button id="btn-jump-to-quest" class="w-full h-9 px-4 bg-primary text-on-primary rounded-sm font-semibold text-xs hover:opacity-90 transition-all cursor-pointer border-none flex items-center justify-center gap-2">Open Quest ${questNumber} in Workspace →</button></div>`
          : "";

      if (aiHintContent) {
        aiHintContent.innerHTML = `
          <p class="font-medium text-ink mb-1">Stuck on Quest ${questNumber}: "${escapeHtml(lesson.title)}"?</p>
          <div class="space-y-2">
            ${hintsHtml}
          </div>
          ${footerText}
          ${ctaWorkspace}
        `;
      }
    }

    const jumpBtn = document.getElementById("btn-jump-to-quest");
    jumpBtn?.addEventListener("click", () => {
      closeAI();
      setView("sandbox");
      window.dispatchEvent(
        new CustomEvent("app:select-lesson", { detail: { lessonId: lesson.id } }),
      );
    });

    openAI();
  });

  // Listen for Global State Updates
  window.addEventListener("app:state-updated", (e: any) => {
    const state = e.detail;
    if (xpCount) {
      const currentDisplayedXp = parseInt(xpCount.textContent || "0", 10);
      if (state.xp > currentDisplayedXp) {
        let startTimestamp: number | null = null;
        const step = (timestamp: number) => {
          if (!startTimestamp) startTimestamp = timestamp;
          const progress = Math.min((timestamp - startTimestamp) / 800, 1);
          // easeOutQuart
          const easeProgress = 1 - Math.pow(1 - progress, 4);
          xpCount.textContent = Math.floor(
            currentDisplayedXp + (state.xp - currentDisplayedXp) * easeProgress,
          ).toString();
          if (progress < 1) {
            window.requestAnimationFrame(step);
          } else {
            xpCount.textContent = state.xp.toString();
          }
        };
        window.requestAnimationFrame(step);
      } else {
        xpCount.textContent = state.xp.toString();
      }
    }
    if (streakCount) streakCount.textContent = state.streak;

    const streakBadge = document.getElementById("nav-streak-badge");
    const streakIconContainer = document.getElementById(
      "nav-streak-icon-container",
    );
    if (streakBadge && streakIconContainer) {
      if (state.streak === 0) {
        streakBadge.className =
          "hidden sm:flex items-center gap-1.5 text-sm font-medium px-2.5 py-1 rounded-sm border text-mute bg-canvas-soft border-hairline";
        streakIconContainer.innerHTML = `
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/>
          </svg>
        `;
      } else {
        streakBadge.className =
          "hidden sm:flex items-center gap-1.5 text-sm font-medium px-2.5 py-1 rounded-sm border text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/30 border-amber-200 dark:border-amber-800/50";
        streakIconContainer.innerHTML = `
          <svg class="w-4 h-4 animate-pulse-subtle text-amber-600 dark:text-amber-400" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" d="M12.395 2.553a1 1 0 00-1.45-.385c-.345.23-.614.558-.822.88-.316.492-.533 1.035-.767 1.56-.251.565-.516 1.163-.887 1.637a3.987 3.987 0 01-1.077 1.007c-.43.265-.929.43-1.433.486A4.978 4.978 0 016 10c0-1.455.518-2.79 1.383-3.814a1 1 0 00-.38-1.567 6.002 6.002 0 00-3.328.79C2.466 6.162 1 7.907 1 10a8 8 0 0016 0c0-3.33-1.8-6.242-4.605-7.447z" clip-rule="evenodd" />
          </svg>
        `;
      }
    }

    if (state.activeView) {
      updateNavHighlights(state.activeView);
    }
  });

  // Switch view internally
  window.addEventListener("app:trigger-view-change", (e: any) => {
    setView(e.detail.view);
  });
</script>
